{
  "name": "hildebrand-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Website der Pflasterarbeiten Hildebrand GmbH – Garten-, Tief- und Straßenbau in Radolfzell am Bodensee.",
  "scripts": {
    "dev": "node scripts/build-zertifikate.mjs && astro dev",
    "dev:api": "wrangler dev --port 8787",
    "build": "node scripts/build-zertifikate.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "assets": "node scripts/build-brand-assets.mjs",
    "deploy": "npm run build && wrangler deploy",
    "og-image": "node scripts/generate-og-image.mjs",
    "zertifikate": "node scripts/build-zertifikate.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify/utils": "^3.1.7",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "mupdf": "^1.28.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.141.0"
  }
}
