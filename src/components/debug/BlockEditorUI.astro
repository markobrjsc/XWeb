---
/**
 * Oberfläche des Element-Editors im Bearbeiten-Modus (Logik: src/scripts/block-editor.ts).
 *  · Auswahl: Vorlagen, Basis-Elemente und Container mit echter Vorschau – als Dialog („+“) oder als
 *    Seitenleiste („Elemente“), aus der man Elemente auf die Seite zieht
 *  · Einfüge-Markierung (gelbe Linie) und Zieh-Etikett
 *  · Werkzeugleiste am ausgewählten Element: hoch/runter, einfügen, duplizieren, verschieben, Einstellungen, löschen
 *  · Einstellungen: Felder je Elementtyp (src/lib/blocks/schema.ts)
 *  · Bildauswahl: alle Fotos der Website oder neu hochladen
 * Wird innerhalb von EditMode.astro eingebunden.
 */
import Icon from '@/components/ui/Icon.astro';
import { PRESETS } from '@/lib/blocks/presets';
import { BLOCKS, type BlockDef } from '@/lib/blocks/schema';

const defs = Object.entries(BLOCKS as Record<string, BlockDef>);
const groups = [
  { id: 'basis', title: 'Basis-Elemente', hint: 'Einzelne Bausteine – in Abschnitte, Spalten oder Karten einfügen.' },
  { id: 'container', title: 'Container', hint: 'Nehmen andere Elemente auf – auch ineinander verschachtelt.' },
];
---

<dialog class="gallery-dialog ub-library" data-ub-library aria-labelledby="ub-library-title">
  <form method="dialog" class="gallery-dialog__inner">
    <header class="gallery-dialog__head">
      <div>
        <p class="gallery-dialog__kicker" data-ub-library-where>Element einfügen</p>
        <h2 class="gallery-dialog__title" id="ub-library-title">Was möchten Sie einfügen?</h2>
      </div>
      <button class="gallery-dialog__close" type="button" aria-label="Schließen">
        <Icon name="x" size="1.1rem" />
      </button>
    </header>

    <div class="ub-library__tabs" role="tablist">
      <button type="button" role="tab" aria-selected="true" data-ub-tab="vorlagen">Vorlagen</button>
      <button type="button" role="tab" aria-selected="false" data-ub-tab="basis">Basis-Elemente</button>
      <button type="button" role="tab" aria-selected="false" data-ub-tab="container">Container</button>
    </div>

    <section class="ub-library__panel" data-ub-tabpanel="vorlagen">
      <p class="gallery-dialog__hint">Fertig gestaltete Abschnitte – passen auf Computer, Tablet und Handy. Danach alles frei änderbar.</p>
      <ul class="ub-library__grid" role="list">
        {
          PRESETS.map((preset) => (
            <li>
              <button type="button" class="ub-tile ub-tile--preset" data-ub-choice={`preset:${preset.id}`}>
                <span class="ub-tile__preview" data-ub-preview aria-hidden="true">
                  <span class="ub-tile__stage" data-ub-stage />
                </span>
                <span class="ub-tile__meta">
                  <span class="ub-tile__icon">
                    <Icon name={preset.icon} size="1.1rem" />
                  </span>
                  <span class="ub-tile__text">
                    <strong>{preset.label}</strong>
                    <small>{preset.description}</small>
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </section>

    {
      groups.map((group) => (
        <section class="ub-library__panel" data-ub-tabpanel={group.id} hidden>
          <p class="gallery-dialog__hint">{group.hint}</p>
          <ul class="ub-library__grid" role="list">
            {defs
              .filter(([, def]) => def.group === group.id)
              .map(([type, def]) => (
                <li>
                  <button type="button" class="ub-tile" data-ub-choice={`block:${type}`}>
                    <span class="ub-tile__preview" data-ub-preview aria-hidden="true">
                      <span class="ub-tile__stage" data-ub-stage />
                    </span>
                    <span class="ub-tile__meta">
                      <span class="ub-tile__icon">
                        <Icon name={def.icon} size="1.1rem" />
                      </span>
                      <span class="ub-tile__text">
                        <strong>{def.label}</strong>
                        <small>{def.description}</small>
                      </span>
                    </span>
                  </button>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </form>
</dialog>

<!-- Werkzeugleiste am ausgewählten Element -->
<div class="ub-toolbar" data-ub-toolbar hidden>
  <span class="ub-toolbar__label" data-ub-toolbar-label></span>
  <button type="button" data-ub-action="parent" title="Übergeordnetes Element wählen" aria-label="Übergeordnetes Element wählen">
    <Icon name="corner-left-up" size="1rem" />
  </button>
  <button type="button" data-ub-action="up" title="Nach oben" aria-label="Nach oben"><Icon name="arrow-up" size="1rem" /></button>
  <button type="button" data-ub-action="down" title="Nach unten" aria-label="Nach unten"><Icon name="arrow-down" size="1rem" /></button>
  <button type="button" data-ub-action="add" title="Danach einfügen" aria-label="Danach einfügen"><Icon name="plus" size="1rem" /></button>
  <button type="button" data-ub-action="duplicate" title="Duplizieren" aria-label="Duplizieren"><Icon name="copy" size="1rem" /></button>
  <button type="button" class="ub-toolbar__grab" data-ub-action="move" title="Verschieben: ziehen oder klicken und Stelle wählen" aria-label="Verschieben">
    <Icon name="move" size="1rem" />
  </button>
  <button type="button" data-ub-action="settings" title="Einstellungen" aria-label="Einstellungen">
    <Icon name="settings-2" size="1rem" />
  </button>
  <button type="button" class="ub-toolbar__danger" data-ub-action="delete" title="Löschen" aria-label="Löschen">
    <Icon name="trash-2" size="1rem" />
  </button>
</div>

<!-- Hinweis beim Verschieben -->
<div class="ub-movebar" data-ub-movebar hidden>
  <Icon name="move" size="1rem" />
  <span data-ub-movebar-text>Stelle auf der Seite anklicken.</span>
  <button type="button" data-ub-move-cancel>Abbrechen</button>
</div>

<!-- Einfüge-Stelle beim Ziehen/Platzieren -->
<div class="ub-drop" data-ub-drop hidden>
  <span class="ub-drop__tag" data-ub-drop-label>Hier einfügen</span>
  <button type="button" class="ub-drop__ok" data-ub-drop-ok hidden>Hier einfügen</button>
</div>
<div class="ub-ghost" data-ub-ghost hidden aria-hidden="true"></div>

<!-- Einstellungen des ausgewählten Elements -->
<aside class="spacing-panel ub-panel" data-ub-panel hidden aria-labelledby="ub-panel-title">
  <div class="ub-panel__head">
    <div class="spacing-panel__head">
      <p class="spacing-panel__title" id="ub-panel-title" data-ub-panel-title>Einstellungen</p>
      <span class="spacing-panel__target">Änderungen sind sofort sichtbar</span>
    </div>
    <button class="gallery-dialog__close" type="button" data-ub-panel-close aria-label="Einstellungen schließen">
      <Icon name="x" size="1rem" />
    </button>
  </div>
  <div class="ub-panel__fields" data-ub-panel-fields></div>
</aside>

<!-- Bildauswahl -->
<dialog class="gallery-dialog" data-ub-picker aria-labelledby="ub-picker-title">
  <form method="dialog" class="gallery-dialog__inner">
    <header class="gallery-dialog__head">
      <div>
        <p class="gallery-dialog__kicker">Bilder</p>
        <h2 class="gallery-dialog__title" id="ub-picker-title" data-ub-picker-title>Bild auswählen</h2>
      </div>
      <button class="gallery-dialog__close" type="button" aria-label="Schließen">
        <Icon name="x" size="1.1rem" />
      </button>
    </header>
    <ol class="gallery-dialog__grid hero-choices" data-ub-picker-grid></ol>
    <footer class="gallery-dialog__foot">
      <label class="gallery-dialog__add">
        <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-ub-picker-upload />
        <Icon name="image-plus" size="1rem" /> Neues Bild hochladen
      </label>
      <p class="gallery-dialog__status" data-ub-picker-status aria-live="polite"></p>
      <button class="edit-bar__btn edit-bar__btn--primary" type="button" data-ub-picker-done hidden>Übernehmen</button>
    </footer>
  </form>
</dialog>

<style>
  /* Auswahl-Dialog */
  .ub-library {
    width: min(60rem, calc(100vw - 2rem));
  }

  .ub-library__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ub-library__tabs button {
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #19191a;
    border: 1px solid #cacac6;
    border-radius: 999px;
    background: #ffffff;
    cursor: pointer;
  }

  .ub-library__tabs button[aria-selected='true'] {
    color: #0b0b0c;
    border-color: var(--color-accent, #f3a505);
    background: var(--color-accent, #f3a505);
  }

  .ub-library__panel {
    display: grid;
    gap: 0.75rem;
  }

  .ub-library__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
  }

  .ub-tile {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
    height: 100%;
    padding: 0.5rem 0.5rem 0.7rem;
    font: inherit;
    text-align: left;
    color: #19191a;
    border: 1px solid #e2e2df;
    border-radius: 0.9rem;
    background: #ffffff;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }

  .ub-tile:hover,
  .ub-tile:focus-visible {
    border-color: var(--color-accent, #f3a505);
    background: #fef8e7;
    box-shadow: 0 8px 22px -14px rgb(0 0 0 / 0.45);
  }

  /* Echte Vorschau: in Originalbreite gezeichnet und verkleinert (Maße setzt block-editor.ts) */
  .ub-tile__preview {
    position: relative;
    display: block;
    overflow: hidden;
    height: 7rem;
    border-radius: 0.6rem;
    background: var(--color-bg, #ffffff);
    box-shadow: inset 0 0 0 1px #e8e8e5;
    pointer-events: none;
  }

  .ub-tile__stage {
    position: absolute;
    top: var(--ub-top, 0);
    left: 0;
    display: block;
    font-size: var(--text-base, 1rem);
    line-height: var(--leading-normal, 1.6);
    text-align: left;
    white-space: normal;
    color: var(--color-text, #373735);
    transform: scale(var(--ub-scale, 0.25));
    transform-origin: 0 0;
  }

  /* Einzelne Elemente mit etwas Rand um den Inhalt */
  .ub-tile:not(.ub-tile--preset) .ub-tile__stage {
    padding: 2rem;
  }

  .ub-tile__meta {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding-inline: 0.2rem;
  }

  .ub-tile__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    color: #0b0b0c;
    border-radius: 0.6rem;
    background: #efefed;
  }

  .ub-tile--preset .ub-tile__icon {
    color: var(--color-accent, #f3a505);
    background: #0b0b0c;
  }

  .ub-tile__text {
    display: grid;
    gap: 0.15rem;
  }

  .ub-tile__text strong {
    font-size: 0.88rem;
  }

  .ub-tile__text small {
    font-size: 0.74rem;
    line-height: 1.35;
    color: #62625e;
  }

  /* Als Seitenleiste: nicht modal, die Seite bleibt bedienbar (Elemente auf die Seite ziehen) */
  .ub-library.ub-library--drawer {
    inset: calc(var(--header-height) + 0.75rem) 0.75rem 5.25rem auto;
    z-index: 1002;
    width: min(25rem, calc(100vw - 1.5rem));
    height: auto;
    max-height: none;
    margin: 0;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.06),
      0 24px 60px -18px rgb(0 0 0 / 0.55);
  }

  .ub-library--drawer .gallery-dialog__inner {
    gap: 0.75rem;
    padding: 1rem;
  }

  .ub-library--drawer .gallery-dialog__title {
    font-size: 1.05rem;
  }

  .ub-library--drawer .ub-library__grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .ub-library--drawer [data-ub-tabpanel]:not([data-ub-tabpanel='vorlagen']) .ub-library__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ub-library--drawer .ub-tile {
    cursor: grab;
  }

  /* Leiste unten ist hier zweizeilig */
  @media (max-width: 64rem) {
    .ub-library.ub-library--drawer {
      bottom: 7.5rem;
    }
  }

  @media (max-width: 47.99rem) {
    .ub-library.ub-library--drawer {
      inset: auto 0 0 0;
      width: 100%;
      height: min(62dvh, 34rem);
      border-radius: 1.2rem 1.2rem 0 0;
    }
  }

  /* Einfüge-Stelle: gelbe Linie – bei „+“-Feldern ein Rahmen */
  .ub-drop {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1006;
    border-radius: 999px;
    background: var(--color-accent, #f3a505);
    box-shadow:
      0 0 0 2px #ffffff,
      0 6px 18px -6px rgb(0 0 0 / 0.55);
    pointer-events: none;
  }

  .ub-drop[hidden] {
    display: none;
  }

  .ub-drop[data-axis='box'] {
    border-radius: 0.8rem;
    background: rgb(243 165 5 / 0.18);
    box-shadow: inset 0 0 0 2px var(--color-accent, #f3a505);
  }

  .ub-drop__tag,
  .ub-drop__ok {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    padding: 0.3rem 0.75rem;
    font: 700 0.75rem/1.2 var(--font-sans);
    white-space: nowrap;
    border-radius: 999px;
  }

  .ub-drop__tag {
    color: var(--color-accent, #f3a505);
    background: #0b0b0c;
  }

  .ub-drop__ok {
    left: 50%;
    translate: -50% 0;
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
    color: #0b0b0c;
    border: 0;
    background: var(--color-accent, #f3a505);
    box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.6);
    cursor: pointer;
    pointer-events: auto;
  }

  .ub-drop[data-flip] :is(.ub-drop__tag, .ub-drop__ok) {
    top: calc(100% + 6px);
    bottom: auto;
  }

  .ub-drop[data-axis='x'] :is(.ub-drop__tag, .ub-drop__ok) {
    top: 0;
    bottom: auto;
    left: 10px;
  }

  .ub-drop[data-axis='x'] .ub-drop__ok {
    translate: none;
  }

  .ub-drop [hidden] {
    display: none;
  }

  /* Etikett am Mauszeiger beim Ziehen */
  .ub-ghost {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1007;
    padding: 0.45rem 0.9rem;
    font: 700 0.8rem/1.2 var(--font-sans);
    white-space: nowrap;
    color: #0b0b0c;
    border-radius: 999px;
    background: var(--color-accent, #f3a505);
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.5);
    pointer-events: none;
  }

  .ub-ghost[hidden] {
    display: none;
  }

  :global(.ub-dragging),
  :global(.ub-dragging *) {
    cursor: grabbing !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  :global(.ub-moving main),
  :global(.ub-moving main *) {
    cursor: crosshair !important;
  }

  /* Werkzeugleiste */
  .ub-toolbar {
    position: fixed;
    z-index: 1003;
    display: flex;
    align-items: center;
    gap: 0.1rem;
    max-width: calc(100vw - 1rem);
    padding: 0.2rem;
    color: #ffffff;
    border-radius: 0.6rem;
    background: #111a24;
    box-shadow: 0 10px 28px -10px rgb(0 0 0 / 0.55);
  }

  .ub-toolbar[hidden] {
    display: none;
  }

  .ub-toolbar__label {
    padding: 0 0.5rem 0 0.4rem;
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--color-accent, #f3a505);
  }

  .ub-toolbar button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    color: inherit;
    border: 0;
    border-radius: 0.45rem;
    background: transparent;
    cursor: pointer;
  }

  .ub-toolbar button:hover,
  .ub-toolbar button:focus-visible {
    background: rgb(255 255 255 / 0.14);
  }

  .ub-toolbar .ub-toolbar__grab {
    cursor: grab;
    touch-action: none;
  }

  .ub-toolbar button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .ub-toolbar .ub-toolbar__danger:hover {
    color: #0b0b0c;
    background: var(--color-accent, #f3a505);
  }

  .ub-movebar {
    position: fixed;
    top: calc(var(--header-height) + 0.75rem);
    left: 50%;
    z-index: 1003;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: calc(100vw - 2rem);
    padding: 0.45rem 0.5rem 0.45rem 1rem;
    font-size: 0.85rem;
    color: #0b0b0c;
    border-radius: 999px;
    background: var(--color-accent, #f3a505);
    box-shadow: 0 10px 28px -10px rgb(0 0 0 / 0.5);
    translate: -50% 0;
  }

  .ub-movebar[hidden] {
    display: none;
  }

  .ub-movebar [data-ub-movebar-text] {
    min-width: 0;
    line-height: 1.3;
  }

  @media (max-width: 47.99rem) {
    .ub-movebar {
      width: calc(100vw - 1.5rem);
      padding: 0.5rem 0.5rem 0.5rem 0.9rem;
      font-size: 0.8rem;
      border-radius: 1rem;
    }

    .ub-movebar [data-ub-movebar-text] {
      flex: 1;
    }
  }

  .ub-movebar button {
    flex: none;
    padding: 0.35rem 0.8rem;
    font: inherit;
    font-weight: 700;
    color: #ffffff;
    border: 0;
    border-radius: 999px;
    background: #0b0b0c;
    cursor: pointer;
  }

  /* Einstellungen */
  .ub-panel {
    z-index: 1004;
    width: min(23rem, calc(100vw - 2rem));
    top: calc(var(--header-height) + 4.5rem);
    bottom: auto;
    overflow-y: auto;
    max-height: calc(100dvh - var(--header-height) - 10rem);
  }

  .ub-panel__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .ub-panel__fields {
    display: grid;
    gap: 0.8rem;
  }

  .ub-panel__fields :global(.ub-f) {
    display: grid;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #373735;
  }

  .ub-panel__fields :global(.ub-f small) {
    font-weight: 400;
    color: #62625e;
  }

  .ub-panel__fields :global(:is(input[type='text'], textarea, select)) {
    width: 100%;
    min-width: 0;
    padding: 0.45rem 0.55rem;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 400;
    color: #0b0b0c;
    border: 1px solid #cacac6;
    border-radius: 0.5rem;
    background: #ffffff;
  }

  .ub-panel__fields :global(textarea) {
    min-height: 5.5rem;
    resize: vertical;
  }

  .ub-panel__fields :global(.ub-f--toggle) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ub-panel__fields :global(.ub-f__invalid) {
    color: #8a5c00;
  }

  .ub-panel__fields :global(.ub-f__image) {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
  }

  .ub-panel__fields :global(.ub-f__thumb) {
    width: 5rem;
    height: 3.6rem;
    overflow: hidden;
    border-radius: 0.45rem;
    background: #efefed;
  }

  .ub-panel__fields :global(.ub-f__thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ub-panel__fields :global(.ub-f__buttons) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .ub-panel__fields :global(.ub-f__buttons button),
  .ub-panel__fields :global(.ub-f__mini) {
    padding: 0.35rem 0.7rem;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    color: #19191a;
    border: 1px solid #cacac6;
    border-radius: 999px;
    background: #ffffff;
    cursor: pointer;
  }

  .ub-panel__fields :global(.ub-f__list) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ub-panel__fields :global(.ub-f__list li) {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 0.45rem;
    background: #efefed;
  }

  .ub-panel__fields :global(.ub-f__list img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ub-panel__fields :global(.ub-f__list span) {
    position: absolute;
    right: 0.15rem;
    bottom: 0.15rem;
    left: 0.15rem;
    display: flex;
    justify-content: space-between;
  }

  .ub-panel__fields :global(.ub-f__list button) {
    width: 1.35rem;
    height: 1.35rem;
    padding: 0;
    font-size: 0.7rem;
    line-height: 1;
    color: #111a24;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    cursor: pointer;
  }

  .ub-panel__fields :global(.ub-f__icons) {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .ub-panel__fields :global(.ub-f__icons button) {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 0;
    font-size: 1.05rem;
    color: #19191a;
    border: 1px solid #e2e2df;
    border-radius: 0.4rem;
    background: #ffffff;
    cursor: pointer;
  }

  .ub-panel__fields :global(.ub-f__icons button[aria-pressed='true']) {
    border-color: #0b0b0c;
