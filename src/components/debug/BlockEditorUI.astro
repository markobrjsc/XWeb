---
/**
 * Oberfläche des Element-Baukastens (Logik: src/scripts/block-editor.ts), eingebunden in EditMode.astro.
 *  part="library":  Auswahl im Einfügen-Bereich der Seitenleiste – Vorlagen, Basis-Elemente und Container
 *                   mit echter, verkleinerter Vorschau; anklicken oder auf die Seite ziehen
 *  part="overlays": Bildauswahl, Einfüge-Markierung (grüne Linie) und Zieh-Etikett
 * Stile der Einstellungsfelder in der Seitenleiste: EditMode.astro (.ed-block-fields).
 */
import Icon from '@/components/ui/Icon.astro';
import { PRESETS } from '@/lib/blocks/presets';
import { BLOCKS, type BlockDef } from '@/lib/blocks/schema';

interface Props {
  part: 'library' | 'overlays';
}

const { part } = Astro.props;
const defs = Object.entries(BLOCKS as Record<string, BlockDef>);
const groups = [
  { id: 'basis', title: 'Basis', hint: 'Einzelne Bausteine – frei kombinierbar, auch in Karten und Spalten.' },
  { id: 'container', title: 'Container', hint: 'Nehmen andere Elemente auf – auch ineinander verschachtelt.' },
];
---

{
  part === 'library' && (
    <div class="ub-library" data-ub-library>
      <div class="ub-library__tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-ub-tab="vorlagen">
          Vorlagen
        </button>
        {groups.map((group) => (
          <button type="button" role="tab" aria-selected="false" data-ub-tab={group.id}>
            {group.title}
          </button>
        ))}
      </div>

      <section class="ub-library__panel" data-ub-tabpanel="vorlagen">
        <p class="ub-library__hint">Fertig gestaltete Abschnitte – passen auf Computer, Tablet und Handy.</p>
        <ul class="ub-library__grid" role="list">
          {PRESETS.map((preset) => (
            <li>
              <button type="button" class="ub-tile ub-tile--preset" data-ub-choice={`preset:${preset.id}`}>
                <span class="ub-tile__preview" data-ub-preview aria-hidden="true">
                  <span class="ub-tile__stage" data-ub-stage />
                </span>
                <span class="ub-tile__meta">
                  <span class="ub-tile__icon">
                    <Icon name={preset.icon} size="1rem" />
                  </span>
                  <span class="ub-tile__text">
                    <strong>{preset.label}</strong>
                    <small>{preset.description}</small>
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </section>

      {groups.map((group) => (
        <section class="ub-library__panel" data-ub-tabpanel={group.id} hidden>
          <p class="ub-library__hint">{group.hint}</p>
          <ul class="ub-library__grid ub-library__grid--small" role="list">
            {defs
              .filter(([, def]) => def.group === group.id)
              .map(([type, def]) => (
                <li>
                  <button type="button" class="ub-tile" data-ub-choice={`block:${type}`}>
                    <span class="ub-tile__preview" data-ub-preview aria-hidden="true">
                      <span class="ub-tile__stage" data-ub-stage />
                    </span>
                    <span class="ub-tile__meta">
                      <span class="ub-tile__icon">
                        <Icon name={def.icon} size="1rem" />
                      </span>
                      <span class="ub-tile__text">
                        <strong>{def.label}</strong>
                      </span>
                    </span>
                  </button>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </div>
  )
}

{
  part === 'overlays' && (
    <>
      <dialog class="gallery-dialog" data-ub-picker aria-labelledby="ub-picker-title">
        <form method="dialog" class="gallery-dialog__inner">
          <header class="gallery-dialog__head">
            <div>
              <p class="gallery-dialog__kicker">Bilder</p>
              <h2 class="gallery-dialog__title" id="ub-picker-title" data-ub-picker-title>
                Bild auswählen
              </h2>
            </div>
            <button class="gallery-dialog__close" type="button" aria-label="Schließen">
              <Icon name="x" size="1.1rem" />
            </button>
          </header>
          <ol class="gallery-dialog__grid hero-choices" data-ub-picker-grid />
          <footer class="gallery-dialog__foot">
            <label class="gallery-dialog__add">
              <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-ub-picker-upload />
              <Icon name="image-plus" size="1rem" /> Neues Bild hochladen
            </label>
            <p class="gallery-dialog__status" data-ub-picker-status aria-live="polite" />
            <button class="ed-btn ed-btn--primary" type="button" data-ub-picker-done hidden>
              Übernehmen
            </button>
          </footer>
        </form>
      </dialog>

      <div class="ub-drop" data-ub-drop hidden>
        <span class="ub-drop__tag" data-ub-drop-label>
          Hier einfügen
        </span>
        <button type="button" class="ub-drop__ok" data-ub-drop-ok hidden>
          Hier einfügen
        </button>
      </div>
      <div class="ub-ghost" data-ub-ghost hidden aria-hidden="true" />
    </>
  )
}

<style is:global>
  /* ---------- Auswahl im Einfügen-Bereich ---------- */
  .ub-library {
    display: grid;
    gap: 0.75rem;
  }

  .ub-library__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--ed-surface);
  }

  .ub-library__tabs button {
    padding: 0.45rem 0.5rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ed-muted);
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .ub-library__tabs button[aria-selected='true'] {
    color: var(--ed-accent-ink);
    background: var(--ed-accent);
  }

  .ub-library__panel {
    display: grid;
    gap: 0.6rem;
  }

  .ub-library__panel[hidden] {
    display: none;
  }

  .ub-library__hint {
    font-size: 0.78rem;
    color: var(--ed-muted);
  }

  .ub-library__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ub-library__grid--small {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ub-tile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    height: 100%;
    padding: 0.45rem 0.45rem 0.6rem;
    font: inherit;
    text-align: left;
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.85rem;
    background: var(--ed-surface);
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .ub-tile:hover,
  .ub-tile:focus-visible {
    border-color: var(--ed-accent);
    background: var(--ed-surface-2);
  }

  /* Echte Vorschau: in Originalbreite gezeichnet und verkleinert (Maße setzt block-editor.ts) */
  .ub-tile__preview {
    position: relative;
    display: block;
    overflow: hidden;
    height: 6rem;
    border-radius: 0.55rem;
    background: var(--color-bg, #ffffff);
    pointer-events: none;
  }

  .ub-tile__stage {
    position: absolute;
    top: var(--ub-top, 0);
    left: 0;
    display: block;
    font-size: var(--text-base, 1rem);
    line-height: var(--leading-normal, 1.6);
    text-align: left;
    white-space: normal;
    color: var(--color-text, #373735);
    transform: scale(var(--ub-scale, 0.25));
    transform-origin: 0 0;
  }

  .ub-tile:not(.ub-tile--preset) .ub-tile__stage {
    padding: 2rem;
  }

  .ub-tile__meta {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    padding-inline: 0.15rem;
  }

  .ub-tile__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.8rem;
    height: 1.8rem;
    color: var(--ed-accent);
    border-radius: 0.5rem;
    background: var(--ed-bg);
  }

  .ub-tile__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .ub-tile__text strong {
    font-size: 0.84rem;
  }

  .ub-tile__text small {
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--ed-muted);
  }

  /* ---------- Einfüge-Stelle und Zieh-Etikett ---------- */
  .ub-drop {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1006;
    border-radius: 999px;
    background: var(--ed-accent);
    box-shadow:
      0 0 0 2px #ffffff,
      0 6px 18px -6px rgb(0 0 0 / 0.55);
    pointer-events: none;
  }

  .ub-drop[hidden],
  .ub-drop [hidden],
  .ub-ghost[hidden] {
    display: none;
  }

  .ub-drop[data-axis='box'] {
    border-radius: 0.8rem;
    background: rgb(52 211 153 / 0.16);
    box-shadow: inset 0 0 0 2px var(--ed-accent);
  }

  .ub-drop__tag,
  .ub-drop__ok {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    padding: 0.3rem 0.75rem;
    font: 700 0.75rem/1.2 var(--font-sans);
    white-space: nowrap;
    border-radius: 999px;
  }

  .ub-drop__tag {
    color: var(--ed-accent);
    background: var(--ed-bg);
  }

  .ub-drop__ok {
    left: 50%;
    translate: -50% 0;
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
    color: var(--ed-accent-ink);
    border: 0;
    background: var(--ed-accent);
    box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.6);
    cursor: pointer;
    pointer-events: auto;
  }

  .ub-drop[data-flip] :is(.ub-drop__tag, .ub-drop__ok) {
    top: calc(100% + 6px);
    bottom: auto;
  }

  .ub-drop[data-axis='x'] :is(.ub-drop__tag, .ub-drop__ok) {
    top: 0;
    bottom: auto;
    left: 10px;
    translate: none;
  }

  .ub-ghost {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1007;
    padding: 0.45rem 0.9rem;
    font: 700 0.8rem/1.2 var(--font-sans);
    white-space: nowrap;
    color: var(--ed-accent-ink);
    border-radius: 999px;
    background: var(--ed-accent);
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.5);
    pointer-events: none;
  }

  .ub-dragging,
  .ub-dragging * {
    cursor: grabbing !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  .ub-moving main,
  .ub-moving main * {
    cursor: crosshair !important;
  }

  /* ---------- Elemente auf der Seite (nur im Bearbeiten-Modus) ---------- */
  .ub-add {
    display: none;
  }

  .is-editing .ub-add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.2rem;
    padding: 0.3rem 0.9rem;
    font: 600 0.78rem/1.2 var(--font-sans);
    color: #0f5132;
    border: 1.5px dashed rgb(16 185 129 / 0.55);
    border-radius: 0.7rem;
    background: rgb(236 253 245 / 0.75);
    cursor: pointer !important;
    opacity: 0.6;
    transition: opacity 150ms ease;
  }

  .is-editing .ub-add:hover,
  .is-editing .ub-add:focus-visible,
  .is-editing .ub-add--empty {
    opacity: 1;
    border-color: var(--ed-accent-strong);
  }

  .is-editing .ub-add--zone {
    flex: 1 1 100%;
    width: calc(100% - var(--gutter) * 2);
    max-width: var(--container-max);
    margin: 0.6rem auto;
  }

  .is-editing ub-zone {
    display: flow-root;
  }

  .ub-moving .ub-add {
    color: var(--ed-accent-ink);
    border-style: solid;
    border-color: var(--ed-accent-strong);
    background: rgb(52 211 153 / 0.25);
    opacity: 1;
  }

  .ub-moving .ub-add[data-ub-invalid] {
    display: none;
  }
</style>
