---
/**
 * EditMode – Bearbeiten-Modus der Website (Stift oben rechts).
 *  · Jeder sichtbare Text wird anklickbar und direkt editierbar. Speichern → Commit auf main
 *    (src/content/edits.json), beim nächsten Build eingesetzt von src/middleware.ts.
 *  · Kopfbilder (Startseite + Seitenköpfe, [data-hero-edit]): aus allen Fotos wählen oder neues hochladen
 *    (src/content/heroes.json, neue Bilder unter src/assets/images/hero/).
 *  · Farben: Farbwähler für Akzent (Gelb), Onyx-Töne und hellen Hintergrund – Vorschau sofort,
 *    Speichern schreibt src/styles/custom-colors.css (überschreibt tokens.css).
 *  · Abstände: Element anklicken → Außen- (margin, orange) und Innenabstände (padding, grün) werden angezeigt
 *    und lassen sich einstellen; Speichern schreibt src/content/spacing.json (→ scripts/build-spacing.mjs).
 *  · Galerien (Carousel mit `folder`): Bilder hinzufügen, Reihenfolge per Ziehen ändern, ausblenden
 *    (src/content/galleries.json, neue Bilder als Dateien unter src/assets/images/<ordner>/).
 *  · Elemente: „+“ zwischen den Abschnitten und in Containern fügt Vorlagen, Basis-Elemente und Container ein;
 *    Texte/Bilder direkt änderbar, verschachtelbar (src/scripts/block-editor.ts → src/content/blocks.json).
 * Erscheint nur, wenn der Worker den Modus meldet (GET /api/edit/status/) – Server-Teil: worker/edit.ts.
 */
import { getImage } from 'astro:assets';
import BlockEditorUI from './BlockEditorUI.astro';
import Icon from '@/components/ui/Icon.astro';
import { listImages } from '@/lib/images';

// Auswahl fürs Kopfbild: alle Querformat-Fotos als kleine Vorschau (erst beim Öffnen des Dialogs geladen)
const heroChoices = await Promise.all(
  listImages()
    .filter(({ image }) => image.width > image.height)
    .sort((a, b) => a.name.localeCompare(b.name, 'de', { numeric: true }))
    .map(async ({ name, image }) => ({ name, thumb: (await getImage({ src: image, width: 320, format: 'webp', quality: 60 })).src })),
);
---

<div class="edit-ui" data-edit-ui hidden>
  <button class="edit-toggle" type="button" data-edit-toggle aria-pressed="false" title="Bearbeiten-Modus">
    <Icon name="pencil" size="1.15rem" class="edit-toggle__on" />
    <Icon name="x" size="1.15rem" class="edit-toggle__off" />
    <span class="visually-hidden">Bearbeiten-Modus</span>
  </button>

  <div class="edit-bar" data-edit-bar hidden>
    <span class="edit-bar__dot" aria-hidden="true"></span>
    <p class="edit-bar__text" data-edit-status aria-live="polite">Bearbeiten-Modus: Text anklicken und ändern · „+“ fügt Elemente ein.</p>
    <button class="edit-bar__btn" type="button" data-spacing-toggle aria-pressed="false">Abstände</button>
    <button class="edit-bar__btn" type="button" data-colors-open>Farben</button>
    <button class="edit-bar__btn" type="button" data-edit-discard>Verwerfen</button>
    <button class="edit-bar__btn edit-bar__btn--primary" type="button" data-edit-save>Speichern</button>
  </div>

  <!-- Abstände: Markierung (margin orange, padding grün) und Einstell-Feld -->
  <div class="spacing-overlay" data-spacing-overlay hidden aria-hidden="true">
    <div class="spacing-overlay__margin" data-spacing-margin></div>
    <div class="spacing-overlay__padding" data-spacing-padding></div>
    <div class="spacing-overlay__label" data-spacing-label></div>
  </div>

  <div class="spacing-panel" data-spacing-panel hidden>
    <div class="spacing-panel__head">
      <p class="spacing-panel__title">Abstände</p>
      <code class="spacing-panel__target" data-spacing-target></code>
    </div>
    <fieldset class="spacing-panel__group spacing-panel__group--margin">
      <legend>Außen (margin) in px</legend>
      <label>Oben <input type="number" step="1" data-spacing-prop="margin-top" /></label>
      <label>Rechts <input type="number" step="1" data-spacing-prop="margin-right" /></label>
      <label>Unten <input type="number" step="1" data-spacing-prop="margin-bottom" /></label>
      <label>Links <input type="number" step="1" data-spacing-prop="margin-left" /></label>
    </fieldset>
    <fieldset class="spacing-panel__group spacing-panel__group--padding">
      <legend>Innen (padding) in px</legend>
      <label>Oben <input type="number" step="1" min="0" data-spacing-prop="padding-top" /></label>
      <label>Rechts <input type="number" step="1" min="0" data-spacing-prop="padding-right" /></label>
      <label>Unten <input type="number" step="1" min="0" data-spacing-prop="padding-bottom" /></label>
      <label>Links <input type="number" step="1" min="0" data-spacing-prop="padding-left" /></label>
    </fieldset>
    <p class="spacing-panel__status" data-spacing-status aria-live="polite"></p>
    <div class="spacing-panel__actions">
      <button class="spacing-panel__btn" type="button" data-spacing-reset>Element zurücksetzen</button>
      <button class="spacing-panel__btn" type="button" data-spacing-done>Fertig</button>
      <button class="spacing-panel__btn spacing-panel__btn--primary" type="button" data-spacing-save disabled>Abstände speichern</button>
    </div>
  </div>

  <dialog class="gallery-dialog colors-dialog" data-colors-dialog aria-labelledby="colors-dialog-title">
    <form method="dialog" class="gallery-dialog__inner">
      <header class="gallery-dialog__head">
        <div>
          <p class="gallery-dialog__kicker">Farben</p>
          <h2 class="gallery-dialog__title" id="colors-dialog-title">Farben der Website anpassen</h2>
        </div>
        <button class="gallery-dialog__close" type="button" aria-label="Schließen">
          <Icon name="x" size="1.1rem" />
        </button>
      </header>
      <p class="gallery-dialog__hint">Änderungen sind sofort als Vorschau sichtbar. Hell- und Hover-Töne werden automatisch berechnet.</p>
      <div class="colors-grid">
        <label class="color-field">
          <input type="color" data-color-var="--yellow-500" />
          <span><strong>Akzent (Gelb)</strong><small>Buttons, Hervorhebungen, aktive Reiter</small></span>
          <code data-color-code></code>
        </label>
        <label class="color-field">
          <input type="color" data-color-var="--onyx-950" />
          <span><strong>Onyx dunkel</strong><small>Header, Footer, Überschriften, Verdunklungen</small></span>
          <code data-color-code></code>
        </label>
        <label class="color-field">
          <input type="color" data-color-var="--onyx-800" />
          <span><strong>Onyx mittel</strong><small>Links, Flächen im dunklen Bereich</small></span>
          <code data-color-code></code>
        </label>
        <label class="color-field">
          <input type="color" data-color-var="--onyx-600" />
          <span><strong>Onyx Flächen</strong><small>Icon-Flächen, Badges</small></span>
          <code data-color-code></code>
        </label>
        <label class="color-field">
          <input type="color" data-color-var="--gray-50" />
          <span><strong>Heller Hintergrund</strong><small>Hellgraue Abschnitte</small></span>
          <code data-color-code></code>
        </label>
      </div>
      <footer class="gallery-dialog__foot">
        <button class="gallery-dialog__add" type="button" data-colors-reset>Auf Standard zurücksetzen</button>
        <p class="gallery-dialog__status" data-colors-status aria-live="polite"></p>
        <button class="edit-bar__btn edit-bar__btn--primary" type="button" data-colors-save>Farben speichern</button>
      </footer>
    </form>
  </dialog>

  <dialog class="gallery-dialog" data-hero-dialog aria-labelledby="hero-dialog-title">
    <form method="dialog" class="gallery-dialog__inner">
      <header class="gallery-dialog__head">
        <div>
          <p class="gallery-dialog__kicker">Kopfbild ändern</p>
          <h2 class="gallery-dialog__title" id="hero-dialog-title">Foto auswählen oder neues hochladen</h2>
        </div>
        <button class="gallery-dialog__close" type="button" aria-label="Schließen">
          <Icon name="x" size="1.1rem" />
        </button>
      </header>
      <ol class="gallery-dialog__grid hero-choices" data-hero-grid>
        {
          heroChoices.map((choice) => (
            <li>
              <button type="button" class="hero-choice" data-hero-choice={choice.name} title={choice.name}>
                <img src={choice.thumb} alt={choice.name} loading="lazy" decoding="async" width="320" height="200" />
              </button>
            </li>
          ))
        }
      </ol>
      <footer class="gallery-dialog__foot">
        <label class="gallery-dialog__add">
          <input type="file" accept="image/jpeg,image/png,image/webp" data-hero-upload />
