  </dialog>

  <dialog class="gallery-dialog" data-gallery-dialog aria-labelledby="gallery-dialog-title">
    <form method="dialog" class="gallery-dialog__inner">
      <header class="gallery-dialog__head">
        <div>
          <p class="gallery-dialog__kicker">Galerie bearbeiten</p>
          <h2 class="gallery-dialog__title" id="gallery-dialog-title" data-gallery-title></h2>
        </div>
        <button class="gallery-dialog__close" type="submit" value="cancel" aria-label="Schließen">
          <Icon name="x" size="1.1rem" />
        </button>
      </header>
      <p class="gallery-dialog__hint">
        Ziehen zum Sortieren (oder Pfeile) · Auge zum Aus-/Einblenden · neue Bilder werden automatisch verkleinert.
      </p>
      <ol class="gallery-dialog__grid" data-gallery-grid></ol>
      <footer class="gallery-dialog__foot">
        <label class="gallery-dialog__add">
          <input type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-gallery-add />
          <Icon name="image-plus" size="1rem" /> Bilder hinzufügen
        </label>
        <p class="gallery-dialog__status" data-gallery-status aria-live="polite"></p>
        <button class="edit-bar__btn edit-bar__btn--primary" type="button" data-gallery-save>Galerie speichern</button>
      </footer>
    </form>
  </dialog>

  <BlockEditorUI />
</div>

<script>
  import { createBlockEditor } from '@/scripts/block-editor';

  const ui = document.querySelector<HTMLElement>('[data-edit-ui]');

  type Tracked = { block: HTMLElement; nodes: { node: Text; original: string }[]; scope: 'global' | 'page' };
  const SKIP = 'script, style, noscript, template, svg, textarea, select, option, input, [data-edit-ui], [data-design-panel], ub-zone, [data-count-to], [data-carousel], .visually-hidden, [aria-hidden="true"]';
  const normalize = (text: string) => text.replace(/\s+/g, ' ').trim();

  async function init() {
    if (!ui) return;
    try {
      const status = await (await fetch('/api/edit/status/')).json();
      if (!status?.enabled) return;
    } catch {
      return;
    }
    ui.hidden = false;

    const toggle = ui.querySelector<HTMLButtonElement>('[data-edit-toggle]')!;
    const bar = ui.querySelector<HTMLElement>('[data-edit-bar]')!;
    const statusText = ui.querySelector<HTMLElement>('[data-edit-status]')!;
    const saveButton = ui.querySelector<HTMLButtonElement>('[data-edit-save]')!;
    let tracked: Tracked[] = [];
    // wird unten vom Abstands-Modus gesetzt
    let spacingToggleOff = () => {};
    let editing = false;
    const IDLE = 'Bearbeiten-Modus: Text anklicken und ändern · „+“ fügt Elemente ein.';

    // Elemente einfügen und bearbeiten (src/scripts/block-editor.ts)
    const blocks = createBlockEditor(ui, {
      onChange: () => updateBar(),
      shrink: (file) => shrink(file),
      status: (message) => (statusText.textContent = message),
    });

    const supportsPlain = (() => {
      const probe = document.createElement('div');
      probe.contentEditable = 'plaintext-only';
      return probe.contentEditable === 'plaintext-only';
    })();

    /* ---------------- Texte ---------------- */
    const collect = () => {
      const blocks = new Map<HTMLElement, Tracked>();
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode: (node) => {
          const parent = node.parentElement;
          if (!parent || !normalize(node.textContent ?? '')) return NodeFilter.FILTER_REJECT;
          if (parent.closest(SKIP)) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        },
      });
      for (let node = walker.nextNode() as Text | null; node; node = walker.nextNode() as Text | null) {
        const block = node.parentElement!;
        const entry = blocks.get(block) ?? {
          block,
          nodes: [],
          scope: block.closest('header, footer, .hero__legal') ? ('global' as const) : ('page' as const),
        };
        entry.nodes.push({ node, original: node.textContent ?? '' });
        blocks.set(block, entry);
      }
      return [...blocks.values()];
    };

    const changes = () => {
      const list: { scope: 'global' | 'page'; from: string; to: string }[] = [];
      for (const entry of tracked) {
        const detached = entry.nodes.some(({ node }) => !node.isConnected || node.parentElement !== entry.block);
        if (detached && entry.nodes.length === 1) {
          const to = normalize(entry.block.textContent ?? '');
          const from = normalize(entry.nodes[0].original);
          if (from !== to) list.push({ scope: entry.scope, from, to });
          continue;
        }
        for (const { node, original } of entry.nodes) {
          const from = normalize(original);
          const to = normalize(node.isConnected ? (node.textContent ?? '') : '');
          if (from !== to) list.push({ scope: entry.scope, from, to });
        }
      }
      return list;
    };

    const updateBar = () => {
      const count = changes().length;
      const parts = [
        ...(count ? [`${count} ${count === 1 ? 'Textänderung' : 'Textänderungen'}`] : []),
        ...(blocks.dirty() ? ['Elemente geändert'] : []),
      ];
      statusText.textContent = parts.length ? `${parts.join(' · ')} – noch nicht gespeichert` : IDLE;
      saveButton.disabled = parts.length === 0;
    };
    const unsaved = () => changes().length > 0 || blocks.dirty();

    const start = () => {
      editing = true;
      document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-revealed'));
      tracked = collect();
      tracked.forEach(({ block }) => {
        block.setAttribute('contenteditable', supportsPlain ? 'plaintext-only' : 'true');
        block.dataset.editable = '';
        block.spellcheck = true;
      });
      document.querySelectorAll<HTMLElement>('[data-carousel][data-gallery]').forEach(addGalleryButton);
      document.querySelectorAll<HTMLElement>('[data-hero-edit]').forEach(addHeroButton);
      document.documentElement.classList.add('is-editing');
      toggle.setAttribute('aria-pressed', 'true');
      bar.hidden = false;
      updateBar();
      blocks.start();
    };

    const stop = () => {
      editing = false;
      tracked.forEach(({ block }) => {
        block.removeAttribute('contenteditable');
        delete block.dataset.editable;
      });
      document.querySelectorAll('[data-gallery-edit], [data-hero-edit-btn]').forEach((button) => button.remove());
      blocks.stop();
      document.documentElement.classList.remove('is-editing');
      spacingToggleOff();
      toggle.setAttribute('aria-pressed', 'false');
      bar.hidden = true;
    };

    const discard = () => {
      for (const entry of tracked) {
        if (entry.nodes.length === 1 && !entry.nodes[0].node.isConnected) {
          entry.block.textContent = entry.nodes[0].original;
          entry.nodes[0].node = entry.block.firstChild as Text;
          continue;
        }
        entry.nodes.forEach(({ node, original }) => node.isConnected && (node.textContent = original));
      }
      blocks.discard();
      updateBar();
    };

    toggle.addEventListener('click', () => {
      if (!editing) return start();
      if (unsaved() && !confirm('Es gibt ungespeicherte Änderungen. Trotzdem beenden (Änderungen bleiben nur bis zum Neuladen sichtbar)?')) return;
      stop();
    });
    ui.querySelector('[data-edit-discard]')!.addEventListener('click', discard);

    saveButton.addEventListener('click', async () => {
      const list = changes();
      const blocksDirty = blocks.dirty();
      if (!list.length && !blocksDirty) return;
      saveButton.disabled = true;
      statusText.textContent = 'Wird gespeichert …';
      try {
        if (list.length) {
          const response = await fetch('/api/edit/texte/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: location.pathname, changes: list }),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || 'Speichern fehlgeschlagen.');
          // Gespeicherter Stand ist der neue Ausgangspunkt
          tracked = collect();
        }
        if (blocksDirty) await blocks.save();
        statusText.textContent = 'Gespeichert – nach dem automatischen Build in ca. 2 Minuten live.';
      } catch (error) {
        statusText.textContent = error instanceof Error ? error.message : 'Speichern fehlgeschlagen.';
        saveButton.disabled = false;
      }
    });

    // Während des Bearbeitens: keine Links/Buttons auslösen, keine Zeilenumbrüche, nur reiner Text
    document.addEventListener(
      'click',
      (event) => {
        if (!editing) return;
        const target = event.target as HTMLElement;
        if (target.closest('[data-edit-ui], [data-design-panel], [data-gallery-edit], [data-hero-edit-btn]')) return;
        if (target.closest('a, button, summary, label')) event.preventDefault();
      },
      true,
    );
    document.addEventListener(
      'submit',
      (event) => {
        if (editing && !(event.target as HTMLElement).closest('[data-edit-ui]')) event.preventDefault();
      },
      true,
    );
    document.addEventListener('keydown', (event) => {
      // Zeilenumbrüche nur in mehrzeiligen Feldern von Elementen (Text, Antwort …)
      const target = event.target as HTMLElement;
      if (editing && event.key === 'Enter' && target.isContentEditable && !target.closest('[data-ub-multiline]')) event.preventDefault();
    });
    document.addEventListener('paste', (event) => {
      const target = event.target as HTMLElement;
      if (!editing || !target.isContentEditable || supportsPlain) return;
      event.preventDefault();
      document.execCommand('insertText', false, event.clipboardData?.getData('text/plain') ?? '');
    });
    document.addEventListener('input', () => editing && updateBar());
    window.addEventListener('beforeunload', (event) => {
      if (editing && unsaved()) event.preventDefault();
    });

    /* ---------------- Abstände ---------------- */
    const spacingToggle = ui.querySelector<HTMLButtonElement>('[data-spacing-toggle]')!;
    const overlay = ui.querySelector<HTMLElement>('[data-spacing-overlay]')!;
    const marginBox = overlay.querySelector<HTMLElement>('[data-spacing-margin]')!;
    const paddingBox = overlay.querySelector<HTMLElement>('[data-spacing-padding]')!;
    const spacingLabel = overlay.querySelector<HTMLElement>('[data-spacing-label]')!;
    const panel = ui.querySelector<HTMLElement>('[data-spacing-panel]')!;
    const panelTarget = panel.querySelector<HTMLElement>('[data-spacing-target]')!;
    const spacingStatus = panel.querySelector<HTMLElement>('[data-spacing-status]')!;
    const spacingSave = panel.querySelector<HTMLButtonElement>('[data-spacing-save]')!;
    const propInputs = [...panel.querySelectorAll<HTMLInputElement>('[data-spacing-prop]')];
    const SIDES = ['top', 'right', 'bottom', 'left'] as const;
    let spacingMode = false;
    let selected: HTMLElement | null = null;
    const pending = new Map<string, Record<string, string | null> | null>();

    const isUi = (el: Element | null) => Boolean(el?.closest('[data-edit-ui], [data-design-panel], [data-gallery-edit], [data-hero-edit-btn]'));

    // Eindeutiger, stabiler Selektor – Header/Footer gelten auf allen Seiten, sonst nur auf dieser Seite
    const selectorFor = (el: HTMLElement) => {
      const parts: string[] = [];
      let node: HTMLElement | null = el;
      while (node && node !== document.body) {
        const tag = node.tagName.toLowerCase();
        if (node.id && /^[a-zA-Z][a-zA-Z0-9_-]*$/.test(node.id)) {
          parts.unshift(`${tag}#${node.id}`);
          break;
        }
        const classes = [...node.classList].filter((c) => /^[a-zA-Z][a-zA-Z0-9_-]*$/.test(c) && !/^(is-|js$)/.test(c));
        let part = tag + classes.map((c) => `.${c}`).join('');
        const parent: HTMLElement | null = node.parentElement;
        if (parent) {
          const same = [...parent.children].filter((child) => child.tagName === node!.tagName);
          if (same.length > 1) part += `:nth-of-type(${same.indexOf(node) + 1})`;
        }
        parts.unshift(part);
        node = parent;
      }
      const chain = parts.join(' > ');
      const rooted = node === document.body ? `> ${chain}` : chain;
      return el.closest('header, footer')
        ? `body ${rooted}`
        : `body[data-page="${location.pathname}"] ${rooted}`;
    };

    const px = (value: string) => Math.round(parseFloat(value) || 0);

    const draw = (el: HTMLElement | null) => {
      if (!el) {
        overlay.hidden = true;
        return;
      }
      const cs = getComputedStyle(el);
      const r = el.getBoundingClientRect();
      const m = SIDES.map((side) => px(cs.getPropertyValue(`margin-${side}`)));
      const pd = SIDES.map((side) => px(cs.getPropertyValue(`padding-${side}`)));
      const b = SIDES.map((side) => px(cs.getPropertyValue(`border-${side}-width`)));
      const pos = Math.max.bind(null, 0);
      const set = (box: HTMLElement, left: number, top: number, width: number, height: number, widths: number[]) => {
        box.style.left = `${left}px`;
        box.style.top = `${top}px`;
        box.style.width = `${Math.max(0, width)}px`;
        box.style.height = `${Math.max(0, height)}px`;
        box.style.borderWidth = widths.map((w) => `${pos(w)}px`).join(' ');
      };
      set(marginBox, r.left - pos(m[3]), r.top - pos(m[0]), r.width + pos(m[1]) + pos(m[3]), r.height + pos(m[0]) + pos(m[2]), m);
      set(paddingBox, r.left + b[3], r.top + b[0], r.width - b[1] - b[3], r.height - b[0] - b[2], pd);
      const name = el.tagName.toLowerCase() + (el.classList[0] ? `.${el.classList[0]}` : '');
      spacingLabel.textContent = `${name}   Außen ${m.join(' ')} · Innen ${pd.join(' ')}`;
      spacingLabel.style.left = `${Math.max(4, r.left - pos(m[3]))}px`;
      spacingLabel.style.top = `${Math.max(4, r.top - pos(m[0]) - 26)}px`;
      overlay.hidden = false;
    };

    const updateSaveButton = () => {
      spacingSave.disabled = pending.size === 0;
      spacingSave.textContent = pending.size ? `Abstände speichern (${pending.size})` : 'Abstände speichern';
    };

    const select = (el: HTMLElement) => {
      selected = el;
      const cs = getComputedStyle(el);
      propInputs.forEach((input) => (input.value = String(px(cs.getPropertyValue(input.dataset.spacingProp!)))));
      panelTarget.textContent = el.tagName.toLowerCase() + [...el.classList].slice(0, 2).map((c) => `.${c}`).join('');
      panelTarget.title = selectorFor(el);
      spacingStatus.textContent = el.closest('header, footer') ? 'Gilt auf allen Seiten (Header/Footer).' : 'Gilt nur auf dieser Seite.';
      panel.hidden = false;
      draw(el);
    };

    const setSpacingMode = (on: boolean) => {
      spacingMode = on;
      spacingToggle.setAttribute('aria-pressed', String(on));
      document.documentElement.classList.toggle('is-spacing', on);
      if (!on) {
        selected = null;
        panel.hidden = true;
        overlay.hidden = true;
      }
    };
    spacingToggle.addEventListener('click', () => setSpacingMode(!spacingMode));
    spacingToggleOff = () => setSpacingMode(false);

    document.addEventListener('mousemove', (event) => {
      if (!spacingMode || selected) return;
      const target = event.target as HTMLElement;
      draw(isUi(target) || target === document.body || target === document.documentElement ? null : target);
    });
    // Im Abstands-Modus: Klick wählt ein Element (kein Textcursor, keine Links)
    const intercept = (event: Event) => {
      if (!spacingMode) return;
      const target = event.target as HTMLElement;
      if (isUi(target)) return;
      event.preventDefault();
      event.stopPropagation();
      if (event.type === 'click' && target !== document.body) select(target);
    };
    document.addEventListener('mousedown', intercept, true);
    document.addEventListener('click', intercept, true);
    window.addEventListener('scroll', () => selected && draw(selected), { passive: true });
    window.addEventListener('resize', () => selected && draw(selected));

    propInputs.forEach((input) =>
      input.addEventListener('input', () => {
        if (!selected) return;
        const prop = input.dataset.spacingProp!;
        const value = input.value === '' ? null : `${Math.round(Number(input.value))}px`;
        if (value) selected.style.setProperty(prop, value, 'important');
        else selected.style.removeProperty(prop);
        const key = selectorFor(selected);
        const entry = pending.get(key) ?? {};
        pending.set(key, { ...entry, [prop]: value });
        updateSaveButton();
        draw(selected);
      }),
    );

    panel.querySelector('[data-spacing-reset]')!.addEventListener('click', () => {
      if (!selected) return;
      propInputs.forEach((input) => selected!.style.removeProperty(input.dataset.spacingProp!));
      pending.set(selectorFor(selected), null);
      updateSaveButton();
      select(selected);
      spacingStatus.textContent = 'Zurückgesetzt – gespeicherte Abstände dieses Elements werden beim Speichern entfernt.';
    });

    panel.querySelector('[data-spacing-done]')!.addEventListener('click', () => {
      selected = null;
      panel.hidden = true;
      overlay.hidden = true;
    });

    spacingSave.addEventListener('click', async () => {
      if (!pending.size) return;
      spacingSave.disabled = true;
      spacingStatus.textContent = 'Wird gespeichert …';
      try {
        const response = await fetch('/api/edit/abstaende/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rules: Object.fromEntries(pending) }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Speichern fehlgeschlagen.');
        pending.clear();
        updateSaveButton();
        spacingStatus.textContent = 'Gespeichert – nach dem automatischen Build in ca. 2 Minuten live.';
      } catch (error) {
        spacingStatus.textContent = error instanceof Error ? error.message : 'Speichern fehlgeschlagen.';
        spacingSave.disabled = false;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && spacingMode && selected) {
        selected = null;
        panel.hidden = true;
        overlay.hidden = true;
      }
    });

    /* ---------------- Farben ---------------- */
    // Standardwerte wie in src/styles/tokens.css
    const COLOR_DEFAULTS: Record<string, string> = {
      '--yellow-500': '#f3a505',
      '--onyx-950': '#0b0b0c',
      '--onyx-800': '#19191a',
      '--onyx-600': '#2c2c2d',
      '--gray-50': '#f7f7f6',
    };
    const colorsDialog = ui.querySelector<HTMLDialogElement>('[data-colors-dialog]')!;
    const colorsStatus = colorsDialog.querySelector<HTMLElement>('[data-colors-status]')!;
    const colorInputs = [...colorsDialog.querySelectorAll<HTMLInputElement>('[data-color-var]')];
    const root = document.documentElement;

    const hexToRgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
    const rgbToHex = (rgb: number[]) => `#${rgb.map((v) => Math.round(Math.max(0, Math.min(255, v))).toString(16).padStart(2, '0')).join('')}`;
    const mix = (hex: string, target: string, amount: number) => {
      const a = hexToRgb(hex);
      const b = hexToRgb(target);
      return rgbToHex(a.map((v, i) => v + (b[i] - v) * amount));
    };
    const toHex = (value: string) => {
      const v = value.trim();
      if (/^#[0-9a-f]{6}$/i.test(v)) return v.toLowerCase();
      const probe = document.createElement('span');
      probe.style.color = v;
      document.body.append(probe);
      const rgb = getComputedStyle(probe).color.match(/\d+/g)?.slice(0, 3).map(Number) ?? [0, 0, 0];
      probe.remove();
      return rgbToHex(rgb);
    };

    // Aus den gewählten Grundfarben alle abhängigen Töne berechnen
    const derive = (base: Record<string, string>) => {
      const y = base['--yellow-500'];
      const o = base['--onyx-950'];
      return {
        ...base,
        '--yellow-50': mix(y, '#ffffff', 0.9),
        '--yellow-100': mix(y, '#ffffff', 0.75),
        '--yellow-300': mix(y, '#ffffff', 0.35),
        '--yellow-600': mix(y, '#000000', 0.1),
        '--yellow-700': mix(y, '#000000', 0.45),
        '--onyx-900': mix(o, '#ffffff', 0.03),
        '--ink': hexToRgb(o).join(' '),
      };
    };

    const currentBase = () =>
      Object.fromEntries(colorInputs.map((input) => [input.dataset.colorVar!, input.value.toLowerCase()]));

    const preview = () => {
      Object.entries(derive(currentBase())).forEach(([name, value]) => root.style.setProperty(name, value));
      colorInputs.forEach((input) => {
        const code = input.parentElement?.querySelector('[data-color-code]');
        if (code) code.textContent = input.value.toUpperCase();
      });
    };

    ui.querySelector('[data-colors-open]')!.addEventListener('click', () => {
      const styles = getComputedStyle(root);
      colorInputs.forEach((input) => (input.value = toHex(styles.getPropertyValue(input.dataset.colorVar!))));
      preview();
      colorsStatus.textContent = '';
      colorsDialog.showModal();
    });
    colorInputs.forEach((input) => input.addEventListener('input', preview));

    colorsDialog.querySelector('[data-colors-reset]')!.addEventListener('click', () => {
      colorInputs.forEach((input) => (input.value = COLOR_DEFAULTS[input.dataset.colorVar!]));
      preview();
      colorsStatus.textContent = 'Standardfarben als Vorschau – zum Übernehmen speichern.';
    });

    colorsDialog.querySelector('[data-colors-save]')!.addEventListener('click', async () => {
      const base = currentBase();
      const isDefault = Object.entries(COLOR_DEFAULTS).every(([name, value]) => base[name] === value);
      colorsStatus.textContent = 'Wird gespeichert …';
      try {
        const response = await fetch('/api/edit/farben/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ colors: isDefault ? {} : derive(base) }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Speichern fehlgeschlagen.');
        colorsStatus.textContent = 'Gespeichert – nach dem automatischen Build in ca. 2 Minuten live.';
      } catch (error) {
        colorsStatus.textContent = error instanceof Error ? error.message : 'Speichern fehlgeschlagen.';
      }
    });

    /* ---------------- Kopfbilder ---------------- */
    const heroDialog = ui.querySelector<HTMLDialogElement>('[data-hero-dialog]')!;
    const heroStatus = heroDialog.querySelector<HTMLElement>('[data-hero-status]')!;
    let heroSection: HTMLElement | null = null;

    function addHeroButton(section: HTMLElement) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'gallery-edit-btn hero-edit-btn';
      button.dataset.heroEditBtn = '';
      button.textContent = 'Bild ändern';
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        heroSection = section;
        heroStatus.textContent = '';
        heroDialog.showModal();
      });
      section.append(button);
    }

    // Vorschau sofort auf der Seite zeigen (volle Qualität nach dem Build)
    const previewHero = (src: string) => {
      const img = heroSection?.querySelector<HTMLImageElement>('.hero__bg img, .page-hero__photo img');
      if (!img) return;
      img.closest('picture')?.querySelectorAll('source').forEach((source) => source.remove());
      img.removeAttribute('srcset');
      img.src = src;
    };

    const saveHero = async (image: string, preview: string) => {
      heroStatus.textContent = 'Wird gespeichert …';
      const response = await fetch('/api/edit/hero/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ page: heroSection?.dataset.heroEdit ?? location.pathname, image }),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error || 'Speichern fehlgeschlagen.');
      previewHero(preview);
      heroStatus.textContent = 'Gespeichert – nach dem automatischen Build in ca. 2 Minuten live.';
    };

    heroDialog.querySelectorAll<HTMLButtonElement>('[data-hero-choice]').forEach((button) =>
      button.addEventListener('click', async () => {
        try {
          await saveHero(button.dataset.heroChoice ?? '', button.querySelector('img')?.src ?? '');
        } catch (error) {
          heroStatus.textContent = error instanceof Error ? error.message : 'Speichern fehlgeschlagen.';
        }
      }),
    );

    heroDialog.querySelector<HTMLInputElement>('[data-hero-upload]')!.addEventListener('change', async (event) => {
      const input = event.target as HTMLInputElement;
      const file = input.files?.[0];
      input.value = '';
      if (!file) return;
      try {
        heroStatus.textContent = 'Bild wird hochgeladen …';
        const base64 = await shrink(file);
        const name = `neu-${Date.now().toString(36)}.jpg`;
        const response = await fetch(`/api/edit/bild/?folder=hero&name=${name}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'text/plain' },
          body: base64,
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Hochladen fehlgeschlagen.');
        await saveHero(`hero/${result.name}`, `data:image/jpeg;base64,${base64}`);
      } catch (error) {
        heroStatus.textContent = error instanceof Error ? error.message : 'Hochladen fehlgeschlagen.';
      }
    });

    /* ---------------- Galerien ---------------- */
    const dialog = ui.querySelector<HTMLDialogElement>('[data-gallery-dialog]')!;
    const grid = dialog.querySelector<HTMLOListElement>('[data-gallery-grid]')!;
    const galleryStatus = dialog.querySelector<HTMLElement>('[data-gallery-status]')!;
    const addInput = dialog.querySelector<HTMLInputElement>('[data-gallery-add]')!;
    const gallerySave = dialog.querySelector<HTMLButtonElement>('[data-gallery-save]')!;
    type Item = { name: string; thumb: string; hidden: boolean; file?: File };
    let items: Item[] = [];
    let folder = '';
    let dragIndex = -1;

    // Schließen: X-Knopf und Klick auf den abgedunkelten Hintergrund (alle Dialoge)
    ui.querySelectorAll<HTMLDialogElement>('dialog').forEach((dlg) => {
      dlg.querySelector('.gallery-dialog__close')?.addEventListener('click', (event) => {
        event.preventDefault();
        dlg.close();
      });
      dlg.addEventListener('click', (event) => {
        if (event.target === dlg) dlg.close();
      });
    });

    function addGalleryButton(carousel: HTMLElement) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'gallery-edit-btn';
      button.dataset.galleryEdit = '';
      button.textContent = 'Galerie bearbeiten';
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        openGallery(carousel);
      });
      carousel.append(button);
    }

    const renderGrid = () => {
      grid.replaceChildren(
        ...items.map((item, index) => {
          const li = document.createElement('li');
          li.className = 'gallery-item';
          li.draggable = true;
          if (item.hidden) li.dataset.hidden = '';
          if (item.file) li.dataset.new = '';
          const img = document.createElement('img');
          img.alt = item.name;
          if (item.thumb) img.src = item.thumb;
          const label = document.createElement('span');
          label.className = 'gallery-item__label';
          label.textContent = item.file ? 'neu' : item.hidden ? 'ausgeblendet' : `${index + 1}`;
          const tools = document.createElement('span');
          tools.className = 'gallery-item__tools';
          const mk = (text: string, title: string, fn: () => void) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.textContent = text;
            b.title = title;
            b.setAttribute('aria-label', title);
            b.addEventListener('click', fn);
            return b;
          };
          tools.append(
            mk('←', 'Nach vorne', () => move(index, index - 1)),
            mk(item.hidden ? '◌' : '◉', item.hidden ? 'Einblenden' : 'Ausblenden', () => {
              if (item.file) items.splice(index, 1);
              else item.hidden = !item.hidden;
              renderGrid();
            }),
            mk('→', 'Nach hinten', () => move(index, index + 1)),
          );
          li.append(img, label, tools);
          li.addEventListener('dragstart', () => (dragIndex = index));
          li.addEventListener('dragover', (event) => event.preventDefault());
          li.addEventListener('drop', (event) => {
            event.preventDefault();
            move(dragIndex, index);
          });
          return li;
        }),
      );
    };

    const move = (from: number, to: number) => {
      if (from < 0 || to < 0 || from >= items.length || to >= items.length || from === to) return;
      const [item] = items.splice(from, 1);
      items.splice(to, 0, item);
      renderGrid();
    };

    function openGallery(carousel: HTMLElement) {
      folder = carousel.dataset.gallery ?? '';
      dialog.querySelector('[data-gallery-title]')!.textContent = carousel.dataset.galleryLabel ?? folder;
      const visible = [...carousel.querySelectorAll<HTMLElement>('.carousel__slide[data-name]')].map((slide) => {
        const img = slide.querySelector('img');
        return { name: slide.dataset.name ?? '', thumb: img?.currentSrc || img?.src || '', hidden: false };
      });
      const hidden = (carousel.dataset.galleryHidden ?? '')
        .split(',')
        .filter(Boolean)
        .map((name) => ({ name, thumb: '', hidden: true }));
      items = [...visible, ...hidden];
      galleryStatus.textContent = '';
      gallerySave.disabled = false;
      renderGrid();
      dialog.showModal();
    }

    const readAsDataUrl = (blob: Blob) =>
      new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result));
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(blob);
      });

    addInput.addEventListener('change', async () => {
      for (const file of addInput.files ?? []) {
        items.push({ name: '', thumb: await readAsDataUrl(file), hidden: false, file });
      }
      addInput.value = '';
      renderGrid();
    });

    // Neue Bilder vor dem Hochladen auf max. 2400 px verkleinern (JPEG)
    const shrink = async (file: File) => {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, 2400 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob>((resolve, reject) =>
        canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('Bild konnte nicht verarbeitet werden.'))), 'image/jpeg', 0.85),
      );
      return (await readAsDataUrl(blob)).split(',')[1];
    };

    gallerySave.addEventListener('click', async () => {
      gallerySave.disabled = true;
      try {
        const pending = items.filter((item) => item.file);
        for (const [index, item] of pending.entries()) {
          galleryStatus.textContent = `Lade Bild ${index + 1} von ${pending.length} hoch …`;
          const base64 = await shrink(item.file!);
          const name = `neu-${Date.now().toString(36)}-${index}.jpg`;
          const response = await fetch(`/api/edit/bild/?folder=${encodeURIComponent(folder)}&name=${name}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'text/plain' },
            body: base64,
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || 'Hochladen fehlgeschlagen.');
          item.name = result.name;
          item.file = undefined;
        }
        galleryStatus.textContent = 'Speichere Reihenfolge …';
        const response = await fetch('/api/edit/galerie/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            folder,
            order: items.map((item) => item.name),
            hidden: items.filter((item) => item.hidden).map((item) => item.name),
          }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Speichern fehlgeschlagen.');
        galleryStatus.textContent = 'Gespeichert – nach dem automatischen Build in ca. 2 Minuten live.';
        renderGrid();
      } catch (error) {
        galleryStatus.textContent = error instanceof Error ? error.message : 'Speichern fehlgeschlagen.';
      } finally {
        gallerySave.disabled = false;
      }
    });
  }

  init();
</script>

