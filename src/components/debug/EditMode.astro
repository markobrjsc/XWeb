---
/**
 * EditMode – Bearbeiten-Modus der Website (Knopf „Bearbeiten“ oben rechts).
 * Seitenleiste links, schlicht in Weiß auf Schwarz; alles, was auf der Seite selbst zur Bearbeitung gehört
 * (Markierungen, Werkzeugleiste am Element, „+“-Punkte, Einfügestellen), bleibt grün:
 *  · Auswahl:  Element anklicken (Text → nur der Text, freie Fläche → Karte/Abschnitt). Die Leiste zeigt den Pfad und
 *              einen Einstellungsbereich mit einklappbaren Unterabschnitten – nur mit dem, was für die Elementart
 *              sinnvoll ist (Katalog: src/scripts/editor/kinds.ts). Aktionen (hoch/runter, verschieben, duplizieren,
 *              löschen) stehen in der Werkzeugleiste direkt am Element.
 *  · Einfügen: Vorlagen, Basis-Elemente und Container mit Vorschau (BlockEditorUI.astro)
 *  · Ebenen:   Aufbau der Seite als Baum
 *  · Abstände: Außen-/Innenabstände sichtbar machen und einstellen
 * Logik: src/scripts/editor/ (Seitenleiste) und src/scripts/block-editor.ts (Elemente) · Server: worker/edit.ts.
 * Erscheint nur, wenn der Worker den Modus meldet (GET /api/edit/status/).
 */
import { getImage } from 'astro:assets';
import BlockEditorUI from './BlockEditorUI.astro';
import Icon from '@/components/ui/Icon.astro';
import { listImages } from '@/lib/images';
import HeaderLogo from '@/components/layout/HeaderLogo.astro';
import { LOGO_DESIGNS } from '@/lib/logo';
import { KINDS } from '@/scripts/editor/kinds';

// Auswahl fürs Kopfbild: alle Querformat-Fotos als kleine Vorschau (erst beim Öffnen des Dialogs geladen)
const heroChoices = await Promise.all(
  listImages()
    .filter(({ image }) => image.width > image.height)
    .sort((a, b) => a.name.localeCompare(b.name, 'de', { numeric: true }))
    .map(async ({ name, image }) => ({ name, thumb: (await getImage({ src: image, width: 320, format: 'webp', quality: 60 })).src })),
);

// Symbole für die Seitenleiste (werden im Browser geklont – src/scripts/editor/index.ts), dazu die der Elementarten
const ICONS = [
  ...new Set([
    'box', 'mouse-pointer-click', 'square-plus', 'layers', 'blocks', 'type', 'square', 'hand', 'image', 'images',
    'rotate-ccw', 'align-left', 'align-center', 'align-right', 'align-justify', 'crosshair', 'x', 'chevron-right',
    'sliders-horizontal', 'smartphone', 'monitor', 'eye-off', 'corner-left-up', 'corner-right-down', 'file-plus', 'link',
    ...Object.values(KINDS).map((kind) => kind.icon),
  ]),
];
---

<div class="edit-ui" data-edit-ui hidden>
  <button class="ed-toggle" type="button" data-ed-toggle title="Seite bearbeiten">
    <Icon name="pencil" size="1rem" />
    <span>Bearbeiten</span>
  </button>

  <aside class="ed-sidebar" data-ed-sidebar data-size="half" hidden aria-label="Bearbeiten">
    <div class="ed-top">
      <button class="ed-expand" type="button" data-ed-collapse title="Leiste ausklappen" aria-label="Leiste ausklappen">
        <Icon name="panel-left-open" size="1.05rem" />
      </button>
      <div class="ed-pill" role="group" aria-label="Leiste">
        <button class="ed-pill__btn ed-sheet-btn" type="button" data-ed-sheet title="Leiste größer oder kleiner">
          <Icon name="chevrons-up-down" size="0.9rem" /><span>Größe</span>
        </button>
        <button class="ed-pill__btn ed-collapse-btn" type="button" data-ed-collapse title="Leiste einklappen">
          <Icon name="panel-left-close" size="0.9rem" /><span>Einklappen</span>
        </button>
        <button class="ed-pill__btn" type="button" data-ed-close title="Bearbeiten beenden">
          <Icon name="x" size="0.9rem" /><span>Schließen</span>
        </button>
      </div>
    </div>

    <nav class="ed-tabs" role="tablist" aria-label="Werkzeuge">
      <button type="button" role="tab" data-ed-tab="inspect" aria-selected="true" title="Auswahl"><Icon name="mouse-pointer-2" size="1rem" /><span>Auswahl</span></button>
      <button type="button" role="tab" data-ed-tab="insert" aria-selected="false" title="Einfügen"><Icon name="square-plus" size="1rem" /><span>Einfügen</span></button>
      <button type="button" role="tab" data-ed-tab="layers" aria-selected="false" title="Ebenen"><Icon name="layers" size="1rem" /><span>Ebenen</span></button>
      <button type="button" role="tab" data-ed-tab="spacing" aria-selected="false" title="Abstände"><Icon name="move-diagonal" size="1rem" /><span>Abstände</span></button>
      <button type="button" role="tab" data-ed-tab="colors" aria-selected="false" title="Farben der Website"><Icon name="palette" size="1rem" /><span>Farben</span></button>
    </nav>

    <div class="ed-hint" data-ed-hint hidden>
      <span data-ed-hint-text></span>
      <button type="button" data-ed-hint-cancel>Abbrechen</button>
    </div>

    <div class="ed-body">
      <section data-ed-panel="inspect"><div data-ed-inspector></div></section>
      <section data-ed-panel="insert" hidden>
        <div data-ed-target></div>
        <BlockEditorUI part="library" />
      </section>
      <section data-ed-panel="layers" hidden><div class="ed-tree" data-ed-tree></div></section>
      <section data-ed-panel="spacing" hidden><div class="ed-spacing" data-ed-spacing></div></section>
      <section data-ed-panel="colors" hidden><div class="ed-colors" data-ed-colors></div></section>
    </div>

    <footer class="ed-foot">
      <p class="ed-status" data-ed-status aria-live="polite"></p>
      <div class="ed-foot__buttons">
        <button class="ed-btn ed-btn--icon" type="button" data-ed-interact aria-pressed="false" title="Seite bedienen (Reiter, Galerien …) – geht auch mit Alt + Klick" aria-label="Seite bedienen">
          <Icon name="hand" size="1rem" />
        </button>
        <button class="ed-btn" type="button" data-ed-discard disabled><Icon name="undo-2" size="1rem" /><span>Verwerfen</span></button>
        <button class="ed-btn ed-btn--primary" type="button" data-ed-save disabled><Icon name="save" size="1rem" /><span>Speichern</span></button>
      </div>
    </footer>
  </aside>

  <!-- Markierungen auf der Seite -->
  <div class="ed-box ed-box--hover" data-ed-hover hidden><span class="ed-box__tag"></span></div>
  <div class="ed-box ed-box--select" data-ed-select hidden>
    <div class="ed-box__bar">
      <span class="ed-box__tag"></span>
      <button type="button" data-ed-quick="up" title="Nach oben bzw. nach vorne"><Icon name="arrow-up" size="0.95rem" /></button>
      <button type="button" data-ed-quick="down" title="Nach unten bzw. nach hinten"><Icon name="arrow-down" size="0.95rem" /></button>
      <button type="button" class="ed-grab" data-ed-quick="move" title="Verschieben – ziehen oder anklicken und Stelle wählen"><Icon name="move" size="0.95rem" /></button>
      <button type="button" data-ed-quick="duplicate" title="Duplizieren"><Icon name="copy" size="0.95rem" /></button>
      <button type="button" data-ed-quick="perform" title="Auf der Seite auslösen (z. B. Reiter wechseln)"><Icon name="play" size="0.95rem" /></button>
      <button type="button" data-ed-quick="delete" title="Löschen"><Icon name="trash-2" size="0.95rem" /></button>
    </div>
    <button class="ed-plus" type="button" data-ed-plus="before" title="Davor einfügen"><Icon name="plus" size="0.95rem" /></button>
    <button class="ed-plus" type="button" data-ed-plus="after" title="Dahinter einfügen"><Icon name="plus" size="0.95rem" /></button>
  </div>
  <div class="ed-spacing-overlay" data-ed-spacing-overlay hidden>
    <div class="ed-spacing-overlay__margin" data-ed-margin></div>
    <div class="ed-spacing-overlay__padding" data-ed-padding></div>
  </div>

  <!-- Logo-Designs für die Auswahl (src/scripts/editor/logo.ts) -->
  {LOGO_DESIGNS.map(([id]) => <template data-ed-logo={id}><HeaderLogo design={id} /></template>)}

  <template data-ed-icons>
    {ICONS.map((name) => <span class="ed-ico" data-icon={name}><Icon name={name} size="1rem" /></span>)}
  </template>

  <dialog class="gallery-dialog" data-hero-dialog aria-labelledby="hero-dialog-title">
    <form method="dialog" class="gallery-dialog__inner">
      <header class="gallery-dialog__head">
        <div>
          <p class="gallery-dialog__kicker">Kopfbild ändern</p>
          <h2 class="gallery-dialog__title" id="hero-dialog-title">Foto auswählen oder neues hochladen</h2>
        </div>
        <button class="gallery-dialog__close" type="button" aria-label="Schließen">
          <Icon name="x" size="1.1rem" />
        </button>
      </header>
      <ol class="gallery-dialog__grid hero-choices" data-hero-grid>
        {
          heroChoices.map((choice) => (
            <li>
              <button type="button" class="hero-choice" data-hero-choice={choice.name} title={choice.name}>
                <img src={choice.thumb} alt={choice.name} loading="lazy" decoding="async" width="320" height="200" />
              </button>
            </li>
          ))
        }
      </ol>
      <footer class="gallery-dialog__foot">
        <label class="gallery-dialog__add">
          <input type="file" accept="image/jpeg,image/png,image/webp" data-hero-upload />
          <Icon name="image-plus" size="1rem" /> Neues Bild hochladen
        </label>
        <p class="gallery-dialog__status" data-hero-status aria-live="polite"></p>
      </footer>
    </form>
  </dialog>

  <dialog class="gallery-dialog" data-gallery-dialog aria-labelledby="gallery-dialog-title">
    <form method="dialog" class="gallery-dialog__inner">
      <header class="gallery-dialog__head">
        <div>
          <p class="gallery-dialog__kicker">Galerie bearbeiten</p>
          <h2 class="gallery-dialog__title" id="gallery-dialog-title" data-gallery-title></h2>
        </div>
        <button class="gallery-dialog__close" type="button" aria-label="Schließen">
          <Icon name="x" size="1.1rem" />
        </button>
      </header>
      <p class="gallery-dialog__hint">Ziehen zum Sortieren (oder Pfeile) · Auge zum Aus-/Einblenden · neue Bilder werden automatisch verkleinert.</p>
      <ol class="gallery-dialog__grid" data-gallery-grid></ol>
      <footer class="gallery-dialog__foot">
        <label class="gallery-dialog__add">
          <input type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-gallery-add />
          <Icon name="image-plus" size="1rem" /> Bilder hinzufügen
        </label>
        <p class="gallery-dialog__status" data-gallery-status aria-live="polite"></p>
        <button class="ed-btn ed-btn--primary" type="button" data-gallery-save>Galerie speichern</button>
      </footer>
    </form>
  </dialog>

  <dialog class="gallery-dialog" data-certs-dialog aria-labelledby="certs-dialog-title">
    <form method="dialog" class="gallery-dialog__inner">
      <header class="gallery-dialog__head">
        <div>
          <p class="gallery-dialog__kicker">Zertifikate bearbeiten</p>
          <h2 class="gallery-dialog__title" id="certs-dialog-title">Reihenfolge, Angaben und Sichtbarkeit</h2>
        </div>
        <button class="gallery-dialog__close" type="button" aria-label="Schließen">
          <Icon name="x" size="1.1rem" />
        </button>
      </header>
      <p class="gallery-dialog__hint">Ziehen oder Pfeile zum Sortieren · Auge zum Aus-/Einblenden · neue PDFs bekommen ihre Vorschau beim nächsten Build.</p>
      <ol class="certs-edit" data-certs-list></ol>
      <footer class="gallery-dialog__foot">
        <label class="gallery-dialog__add">
          <input type="file" accept="application/pdf,.pdf" multiple data-certs-add />
          <Icon name="file-plus" size="1rem" /> PDF hinzufügen
        </label>
        <p class="gallery-dialog__status" data-certs-status aria-live="polite"></p>
        <button class="ed-btn ed-btn--primary" type="button" data-certs-save>Zertifikate speichern</button>
      </footer>
    </form>
  </dialog>

  <BlockEditorUI part="overlays" />
</div>

<script>
  import { initEditor } from '@/scripts/editor';

  initEditor();
</script>

<style is:global>
  /* ======================================================================
     Bearbeiten-Modus
     Grün: alles auf der Seite (Knopf „Bearbeiten“, Markierungen, Werkzeugleiste, Einfügestellen)
     Weiß auf Schwarz: Seitenleiste und Dialoge (Variablen unten überschrieben)
     ====================================================================== */
  :root {
    --ed-w: 23rem;
    --ed-rail: 3.5rem;
    --ed-font: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --ed-bg: #0c2b21;
    --ed-bg-2: #0f3428;
    --ed-surface: #154335;
    --ed-surface-2: #1b5341;
    --ed-line: rgb(255 255 255 / 0.1);
    --ed-line-strong: rgb(255 255 255 / 0.2);
    --ed-text: #e9f6f0;
    --ed-muted: #9cc2b1;
    --ed-accent: #34d399;
    --ed-accent-strong: #10b981;
    --ed-accent-ink: #04271b;
    --ed-danger: #fca5a5;
  }

  .ed-sidebar,
  .edit-ui .gallery-dialog {
    --ed-bg: #0a0a0a;
    --ed-bg-2: #111111;
    --ed-surface: #1a1a1a;
    --ed-surface-2: #242424;
    --ed-line: rgb(255 255 255 / 0.08);
    --ed-line-strong: rgb(255 255 255 / 0.18);
    --ed-text: #f4f4f5;
    --ed-muted: #a1a1aa;
    --ed-accent: #ffffff;
    --ed-accent-strong: #ffffff;
    --ed-accent-ink: #0a0a0a;
    --ed-danger: #f87171;
    --ed-changed: #fbbf24;
  }

  .edit-ui[hidden],
  .edit-ui [hidden] {
    display: none !important;
  }

  /* Knopf zum Starten */
  .ed-toggle {
    position: fixed;
    top: calc(var(--header-height) + 0.75rem);
    right: 1rem;
    z-index: 1001;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1rem 0.6rem 0.85rem;
    font: 700 0.85rem/1 var(--font-sans);
    color: var(--ed-text);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: var(--ed-bg);
    box-shadow: 0 12px 30px -12px rgb(0 0 0 / 0.55);
    cursor: pointer;
  }

  .ed-toggle .icon {
    color: var(--ed-accent);
  }

  /*
   * Platz für die Seitenleiste (ab Tablet): Die Seite wird neben der Leiste proportional verkleinert (--ed-zoom,
   * gesetzt von src/scripts/editor/index.ts) – so bleibt das Layout genau wie in voller Breite, nichts bricht um.
   * Auf dem Handy liegt die Leiste unten und die Seite bekommt dort Luft.
   */
  @media (min-width: 48rem) {
    html.is-editing {
      --ed-space: var(--ed-w);
    }

    html.is-editing.ed-collapsed {
      --ed-space: var(--ed-rail);
    }

    html.is-editing body {
      padding-left: var(--ed-space);
    }

    html.is-editing :is(main, .site-footer) {
      zoom: var(--ed-zoom, 1);
    }

    html.is-editing .site-header {
      zoom: var(--ed-zoom, 1);
      left: calc(var(--ed-space) / var(--ed-zoom, 1));
    }
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    :root {
      --ed-w: 20rem;
    }
  }

  @media (min-width: 100rem) {
    :root {
      --ed-w: 25rem;
    }
  }

  @media (max-width: 47.99rem) {
    html.is-editing body {
      padding-bottom: 55dvh;
    }
  }

  /* Beim Auswählen keine Textcursor/Links auf der Seite */
  html.is-editing:not(.ed-interact) :is(main, .site-header, .site-footer) * {
    cursor: default;
  }

  /* Ausgeblendete Elemente bleiben im Bearbeiten-Modus abgeblendet sichtbar */
  html.is-editing [data-ed-hide] {
    opacity: 0.4 !important;
    outline: 2px dashed rgb(16 185 129 / 0.6);
    outline-offset: -2px;
  }

  /* ---------------- Seitenleiste ---------------- */
  .ed-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 1005;
    display: flex;
    flex-direction: column;
    width: var(--ed-w);
    font: 400 0.8125rem/1.45 var(--ed-font);
    color: var(--ed-text);
    border-right: 1px solid var(--ed-line);
    background: var(--ed-bg);
    box-shadow: 8px 0 40px -24px rgb(0 0 0 / 0.7);
    color-scheme: dark;
    -webkit-font-smoothing: antialiased;
    animation: ed-slide-in 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transition: width 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes ed-slide-in {
    from {
      transform: translateX(-100%);
    }
  }

  @keyframes ed-fade-up {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .ed-body > section:not([hidden]) {
    animation: ed-fade-up 200ms ease;
  }

  .ed-sidebar :is(h1, h2, h3, p, ul, ol) {
    margin: 0;
  }

  .ed-sidebar .icon {
    flex: none;
  }

  /* Oben rechts: Einklappen / Schließen */
  .ed-top {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: flex-end;
    padding: 0.65rem 0.65rem 0;
  }

  .ed-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    border: 1px solid var(--ed-line);
    border-radius: 999px;
    background: var(--ed-bg-2);
  }

  .ed-pill__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    font: 500 0.75rem/1.2 var(--ed-font);
    color: var(--ed-muted);
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .ed-pill__btn + .ed-pill__btn {
    position: relative;
  }

  .ed-pill__btn + .ed-pill__btn::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 25%;
    height: 50%;
    border-left: 1px solid var(--ed-line);
  }

  .ed-pill__btn:hover,
  .ed-pill__btn:focus-visible {
    color: var(--ed-text);
    background: var(--ed-surface);
  }

  .ed-pill__btn:hover::before,
  .ed-pill__btn:hover + .ed-pill__btn::before {
    opacity: 0;
  }

  .ed-expand {
    display: none;
  }

  .ed-sheet-btn {
    display: none !important;
  }

  /* Eingeklappt: schmale Symbolleiste – Werkzeuge bleiben mit einem Klick erreichbar */
  @media (min-width: 48rem) {
    .ed-sidebar[data-collapsed] {
      width: var(--ed-rail);
    }

    .ed-sidebar[data-collapsed] :is(.ed-pill, .ed-hint, .ed-body, .ed-status, .ed-tabs span, .ed-foot__buttons span, [data-ed-discard]) {
      display: none !important;
    }

    .ed-sidebar[data-collapsed] .ed-top {
      justify-content: center;
      padding-inline: 0;
    }

    .ed-sidebar[data-collapsed] .ed-expand {
      display: grid;
      place-items: center;
      width: 2.2rem;
      height: 2.2rem;
      color: var(--ed-text);
      border: 1px solid var(--ed-line);
      border-radius: 999px;
      background: var(--ed-bg-2);
      cursor: pointer;
    }

    .ed-sidebar[data-collapsed] .ed-tabs {
      grid-template-columns: 1fr;
      margin-inline: 0.45rem;
    }

    .ed-sidebar[data-collapsed] .ed-tabs button {
      justify-content: center;
      padding-block: 0.6rem;
    }

    .ed-sidebar[data-collapsed] .ed-foot {
      margin-top: auto;
      padding-inline: 0.45rem;
    }

    .ed-sidebar[data-collapsed] .ed-foot__buttons {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47.99rem) {
    .ed-collapse-btn {
      display: none !important;
    }

    .ed-sidebar {
      inset: auto 0 0 0;
      width: 100%;
      height: 52dvh;
      border-top: 1px solid var(--ed-line);
      border-right: 0;
      border-radius: 1rem 1rem 0 0;
      box-shadow: 0 -10px 40px -16px rgb(0 0 0 / 0.6);
      transition: height 250ms ease;
    }

    .ed-sidebar[data-size='full'] {
      height: 88dvh;
    }

    .ed-sidebar[data-size='min'] {
      height: auto;
    }

    .ed-sidebar[data-size='min'] :is(.ed-tabs, .ed-body, .ed-foot) {
      display: none;
    }

    .ed-sheet-btn {
      display: inline-flex !important;
    }
  }

  /* Reiter */
  .ed-tabs {
    display: grid;
    flex: none;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2px;
    margin: 0.6rem 0.75rem 0;
    padding: 2px;
    border: 1px solid var(--ed-line);
    border-radius: 0.6rem;
    background: var(--ed-bg-2);
  }

  /* Symbol über der Beschriftung – fünf Reiter passen so nebeneinander */
  .ed-tabs button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-width: 0;
    padding: 0.4rem 0.15rem 0.35rem;
    font: 500 0.68rem/1.2 var(--ed-font);
    color: var(--ed-muted);
    border: 0;
    border-radius: 0.45rem;
    background: transparent;
    cursor: pointer;
  }

  .ed-tabs button span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ed-tabs button:hover {
    color: var(--ed-text);
  }

  .ed-tabs button[aria-selected='true'] {
    color: var(--ed-text);
    background: var(--ed-surface-2);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.4);
  }

  .ed-hint {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.6rem;
    margin: 0.6rem 0.75rem 0;
    padding: 0.5rem 0.5rem 0.5rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ed-accent-ink);
    border-radius: 0.6rem;
    background: var(--ed-accent);
  }

  .ed-hint span {
    flex: 1;
  }

  .ed-hint button {
    padding: 0.3rem 0.7rem;
    font: inherit;
    color: var(--ed-text);
    border: 0;
    border-radius: 999px;
    background: var(--ed-bg);
    cursor: pointer;
  }

  .ed-body {
    flex: 1;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.85rem 0.75rem 1.2rem;
    scrollbar-color: var(--ed-surface-2) transparent;
    scrollbar-width: thin;
  }

  .ed-body > section {
    display: grid;
    gap: 0.75rem;
  }

  .ed-foot {
    display: grid;
    flex: none;
    gap: 0.5rem;
    padding: 0.65rem 0.75rem 0.75rem;
    border-top: 1px solid var(--ed-line);
  }

  .ed-status {
    font-size: 0.72rem;
    color: var(--ed-muted);
  }

  .ed-status.is-dirty {
    color: var(--ed-text);
  }

  .ed-status.is-dirty::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--ed-changed);
  }

  .ed-foot__buttons {
    display: grid;
    grid-template-columns: auto 1fr 1.5fr;
    gap: 0.4rem;
  }

  /* ---------------- Bausteine der Seitenleiste ---------------- */
  .ed-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.1rem;
    padding: 0.4rem 0.8rem;
    font: 500 0.78rem/1.2 var(--ed-font);
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.5rem;
    background: var(--ed-surface);
    cursor: pointer;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }

  .ed-btn:hover:not(:disabled),
  .ed-btn:focus-visible {
    border-color: var(--ed-line-strong);
    background: var(--ed-surface-2);
  }

  .ed-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .ed-btn--primary {
    font-weight: 600;
    color: var(--ed-accent-ink);
    border-color: var(--ed-accent);
    background: var(--ed-accent);
  }

  .ed-btn--primary:hover:not(:disabled),
  .ed-btn--primary:focus-visible {
    color: var(--ed-accent-ink);
    border-color: #e4e4e7;
    background: #e4e4e7;
  }

  .ed-btn--icon {
    width: 2.1rem;
    padding: 0;
  }

  .ed-btn[aria-pressed='true'] {
    color: var(--ed-accent-ink);
    border-color: var(--ed-accent);
    background: var(--ed-accent);
  }

  .ed-btn--danger:hover:not(:disabled) {
    color: #450a0a;
    border-color: var(--ed-danger);
    background: var(--ed-danger);
  }

  .ed-btn--ghost {
    min-height: 1.9rem;
    padding: 0.3rem 0.4rem;
    color: var(--ed-muted);
    border-color: transparent;
    background: transparent;
  }

  .ed-btn--ghost:hover:not(:disabled) {
    color: var(--ed-text);
  }

  .ed-btn--block {
    width: 100%;
  }

  .ed-btn--small {
    min-height: 1.8rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.74rem;
  }

  .ed-note {
    display: block;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--ed-muted);
  }

  .ed-note--ok {
    padding: 0.5rem 0.65rem;
    color: var(--ed-text);
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.06);
  }

  .ed-muted {
    color: var(--ed-muted);
  }

  .ed-code {
    padding: 0.4rem 0.55rem;
    overflow-wrap: anywhere;
    font: 0.75rem/1.4 ui-monospace, 'Cascadia Code', monospace;
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.45rem;
    background: var(--ed-bg);
  }

  .ed-row2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .ed-count {
    min-width: 1.2rem;
    padding: 0.05rem 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ed-accent);
    border-radius: 999px;
    background: var(--ed-accent-ink);
  }

  /* Leerer Zustand */
  .ed-empty {
    display: grid;
    gap: 0.5rem;
    padding: 0.2rem 0.15rem;
  }

  .ed-empty > strong {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .ed-empty > p {
    color: var(--ed-muted);
  }

  .ed-steps {
    display: grid;
    margin-top: 0.4rem;
    overflow: hidden;
    border: 1px solid var(--ed-line);
    border-radius: 0.7rem;
    background: var(--ed-bg-2);
  }

  .ed-step {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.7rem;
    font: inherit;
    text-align: left;
    color: var(--ed-text);
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .ed-step + .ed-step {
    border-top: 1px solid var(--ed-line);
  }

  .ed-step:hover {
    background: var(--ed-surface);
  }

  .ed-step > .ed-ico {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    color: var(--ed-muted);
    border: 1px solid var(--ed-line);
    border-radius: 0.5rem;
  }

  .ed-step span {
    display: grid;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .ed-step strong {
    font-weight: 500;
  }

  .ed-step small {
    color: var(--ed-muted);
  }

  /* Pfad (Brotkrumen) */
  .ed-inspect {
    display: grid;
    gap: 0.7rem;
  }

  .ed-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.1rem;
  }

  .ed-crumb {
    min-height: 1.6rem;
    padding: 0.15rem 0.35rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ed-muted);
    border-color: transparent;
    border-radius: 0.35rem;
    background: transparent;
  }

  .ed-crumb + .ed-crumb::before {
    content: '/';
    margin-right: 0.45rem;
    color: rgb(255 255 255 / 0.25);
  }

  .ed-crumb:hover:not(:disabled) {
    color: var(--ed-text);
    border-color: transparent;
    background: var(--ed-surface);
  }

  .ed-crumb.is-current {
    font-weight: 600;
    color: var(--ed-text);
  }

  .ed-grab {
    cursor: grab !important;
    touch-action: none;
  }

  /* Ein Einstellungsbereich mit einklappbaren Unterabschnitten (src/scripts/editor/panel.ts) */
  .ed-panel {
    overflow: hidden;
    border: 1px solid var(--ed-line);
    border-radius: 0.7rem;
    background: var(--ed-bg-2);
  }

  .ed-panel--plain {
    display: grid;
    gap: 0.75rem;
    padding: 0.8rem;
  }

  /* Karte „Übergeordnetes / Untergeordnetes Element wählen“ unter den Einstellungen */
  .ed-nav {
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .ed-sub + .ed-sub,
  .ed-panel__foot {
    border-top: 1px solid var(--ed-line);
  }

  .ed-sub > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  .ed-sub > summary::-webkit-details-marker {
    display: none;
  }

  .ed-sub > summary:hover {
    background: rgb(255 255 255 / 0.025);
  }

  .ed-sub > summary::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    margin-left: auto;
    border-right: 1.5px solid var(--ed-muted);
    border-bottom: 1.5px solid var(--ed-muted);
    rotate: -45deg;
    transition: rotate 150ms ease;
  }

  .ed-sub[open] > summary::after {
    rotate: 45deg;
  }

  .ed-sub__body {
    display: grid;
    gap: 0.8rem;
    padding: 0.1rem 0.85rem 0.95rem;
  }

  .ed-panel__foot {
    padding: 0.4rem 0.5rem;
  }

  /* Felder */
  .ed-field,
  .ed-panel .ub-f {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ed-muted);
  }

  .ed-field.is-changed > span::after {
    content: ' · geändert';
    color: var(--ed-changed);
  }

  .ed-sidebar :is(input[type='text'], input[type='number'], input:not([type]), textarea, select) {
    width: 100%;
    min-width: 0;
    min-height: 2rem;
    padding: 0.35rem 0.55rem;
    font: 400 0.8125rem/1.4 var(--ed-font);
    color: var(--ed-text);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.45rem;
    background: var(--ed-bg);
  }

  .ed-sidebar :is(input, textarea, select):focus {
    outline: none;
    border-color: rgb(255 255 255 / 0.5);
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.1);
  }

  .ed-sidebar textarea {
    resize: vertical;
    overflow: hidden;
  }

  .ed-sidebar input::placeholder,
  .ed-sidebar textarea::placeholder {
    color: rgb(161 161 170 / 0.55);
  }

  .ed-sidebar input[type='checkbox'] {
    accent-color: #ffffff;
  }

  .ed-unit {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 400;
  }

  /* Hell / Dunkel */
  .ed-design {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 0.4rem;
  }

  .ed-design__opt {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.55rem;
    font: 500 0.78rem/1.2 var(--ed-font);
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.55rem;
    background: var(--ed-bg);
    cursor: pointer;
  }

  .ed-design__opt:hover {
    border-color: var(--ed-line-strong);
  }

  .ed-design__opt[aria-pressed='true'] {
    border-color: #ffffff;
    box-shadow: inset 0 0 0 1px #ffffff;
  }

  .ed-design__chip {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    font: 700 0.62rem/1 var(--ed-font);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 0.35rem;
  }

  .ed-design__chip--light {
    background: #ffffff;
  }

  .ed-design__chip--gray {
    background: #e4e4e7;
  }

  .ed-design__chip--dark {
    background: #0b0b0c;
  }

  .ed-design[data-mode='ink'] .ed-design__chip--light {
    color: #ffffff;
    background: #52525b;
  }

  .ed-design[data-mode='ink'] .ed-design__chip--dark {
    color: #0b0b0c;
    background: #e4e4e7;
  }

  .ed-design[data-mode='shade'] .ed-design__chip--light {
    background: linear-gradient(135deg, #ffffff, #a1a1aa);
  }

  .ed-design[data-mode='shade'] .ed-design__chip--dark {
    background: linear-gradient(135deg, #52525b, #09090b);
  }

  /* Farben */
  .ed-color,
  .ed-panel .ub-color {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .ed-color input[type='color'],
  .ed-panel .ub-color input[type='color'] {
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 0.4rem;
    background: none;
    cursor: pointer;
  }

  .ed-color code,
  .ed-panel .ub-color code {
    min-width: 3.9rem;
    font: 0.72rem/1.2 ui-monospace, 'Cascadia Code', monospace;
    color: var(--ed-text);
  }

  .ed-swatches,
  .ed-panel .ub-swatches {
    display: flex;
    gap: 0.25rem;
  }

  .ed-swatch,
  .ed-panel .ub-swatches button {
    width: 1.25rem;
    height: 1.25rem;
    min-height: 1.25rem !important;
    padding: 0 !important;
    border: 1px solid rgb(255 255 255 / 0.3) !important;
    border-radius: 50% !important;
    background: var(--swatch) !important;
    cursor: pointer;
  }

  /* Umschalter */
  .ed-seg,
  .ed-panel .ub-align {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--ed-line);
    border-radius: 0.5rem;
    background: var(--ed-bg);
  }

  .ed-seg .ed-btn,
  .ed-panel .ub-align button {
    display: grid;
    place-items: center;
    min-height: 1.8rem;
    padding: 0.25rem;
    font: 500 0.72rem/1.2 var(--ed-font);
    color: var(--ed-muted);
    border: 0;
    border-radius: 0.38rem;
    background: transparent;
    cursor: pointer;
  }

  .ed-seg .ed-btn:hover:not(:disabled),
  .ed-panel .ub-align button:hover {
    color: var(--ed-text);
    background: var(--ed-surface);
  }

  .ed-seg .ed-btn[aria-pressed='true'],
  .ed-panel .ub-align button[aria-pressed='true'] {
    color: var(--ed-accent-ink);
    background: var(--ed-accent);
  }

  .ed-panel .ub-align svg {
    width: 1rem;
    height: 1rem;
  }

  /* Schieberegler mit Zahlenfeld */
  .ed-range {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.6rem;
    align-items: center;
    gap: 0.6rem;
  }

  .ed-range input[type='range'] {
    width: 100%;
    accent-color: #ffffff;
    cursor: pointer;
  }

  .ed-range .ed-unit input {
    padding-inline: 0.4rem;
  }

  /* Abstände je Seite (oben, rechts, unten, links) */
  .ed-sides {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.3rem;
  }

  .ed-sides label {
    display: grid;
    gap: 0.15rem;
  }

  .ed-sides small {
    font-size: 0.66rem;
    color: rgb(161 161 170 / 0.8);
  }

  .ed-sidebar .ed-sides input {
    padding-inline: 0.35rem;
    text-align: center;
  }

  .ed-spacing {
    display: grid;
    gap: 0.75rem;
  }

  .ed-spacing__name {
    font-weight: 600;
  }

  /* Logo-Auswahl: Kacheln mit echter Vorschau auf dunklem Grund (wie die Kopfzeile) */
  .ed-logos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .ed-logo {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
    padding: 0.4rem 0.4rem 0.5rem;
    font: inherit;
    text-align: left;
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.6rem;
    background: var(--ed-bg);
    cursor: pointer;
  }

  .ed-logo:hover {
    border-color: var(--ed-line-strong);
  }

  .ed-logo[aria-pressed='true'] {
    border-color: #ffffff;
    box-shadow: inset 0 0 0 1px #ffffff;
  }

  .ed-logo__stage {
    --header-item-h: 2.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.4rem;
    overflow: hidden;
    border-radius: 0.45rem;
    background: rgb(28 28 30);
    font-family: var(--font-sans);
  }

  .ed-logo__stage .hlogo {
    max-width: 100%;
  }

  .ed-logo__stage .hlogo--band {
    height: 2rem;
  }

  .ed-logo__stage .hlogo--standard .hlogo__name,
  .ed-logo__stage .hlogo--monogramm .hlogo__name {
    font-size: 0.78rem;
  }

  .ed-logo__stage .hlogo--schrift .hlogo__name {
    font-size: 0.95rem;
  }

  .ed-logo__stage .hlogo__sub {
    font-size: 0.42rem;
  }

  .ed-logo__stage .hlogo--standard {
    padding: 0 0.7rem 0 0.5rem;
  }

  .ed-logo strong {
    font-size: 0.74rem;
    font-weight: 600;
  }

  .ed-logo small {
    font-size: 0.66rem;
    line-height: 1.3;
    color: var(--ed-muted);
  }

  .ed-logo--empty .ed-logo__stage {
    font-size: 0.7rem;
    color: var(--ed-muted);
  }

  /* Farben der Website */
  .ed-colors {
    display: grid;
    gap: 0.75rem;
  }

  .ed-basecolor {
    display: grid;
    grid-template-columns: 2.3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
  }

  .ed-basecolor input[type='color'] {
    width: 2.3rem;
    height: 2.3rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 0.5rem;
    background: none;
    cursor: pointer;
  }

  .ed-basecolor__text {
    display: grid;
    gap: 0.05rem;
    min-width: 0;
  }

  .ed-basecolor__text strong {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ed-text);
  }

  .ed-basecolor__text small {
    font-size: 0.7rem;
    color: var(--ed-muted);
  }

  .ed-basecolor__text code {
    font: 0.7rem/1.3 ui-monospace, 'Cascadia Code', monospace;
    color: var(--ed-muted);
  }

  .ed-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .ed-preset {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem 0.25rem 0.3rem;
    font: 500 0.7rem/1.2 var(--ed-font);
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 999px;
    background: var(--ed-bg);
    cursor: pointer;
  }

  .ed-preset:hover,
  .ed-preset[aria-pressed='true'] {
    border-color: rgb(255 255 255 / 0.6);
  }

  .ed-preset::before {
    content: '';
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }

  .ed-warn {
    padding: 0.45rem 0.6rem;
    font-size: 0.72rem;
    color: #fde68a;
    border: 1px solid rgb(251 191 36 / 0.35);
    border-radius: 0.5rem;
    background: rgb(251 191 36 / 0.08);
  }

  /* Einfügen */
  .ed-target {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.7rem;
    border: 1px dashed var(--ed-line-strong);
    border-radius: 0.7rem;
  }

  .ed-target > .ed-ico {
    font-size: 1.1rem;
    color: var(--ed-muted);
  }

  .ed-target > span {
    display: grid;
    flex: 1;
    gap: 0.1rem;
    font-size: 0.76rem;
  }

  .ed-target strong {
    font-weight: 600;
  }

  .ed-target small {
    font-size: 0.72rem;
    color: var(--ed-muted);
  }

  .ed-target.is-set {
    border-style: solid;
    border-color: rgb(255 255 255 / 0.5);
    background: rgb(255 255 255 / 0.05);
  }

  /* Ebenen */
  .ed-node {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    padding: 0.38rem 0.5rem;
    font: 400 0.78rem/1.3 var(--ed-font);
    text-align: left;
    color: var(--ed-text);
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    cursor: pointer;
  }

  .ed-node:hover,
  .ed-node:focus-visible {
    background: var(--ed-surface);
  }

  .ed-node.is-current {
    background: var(--ed-surface-2);
    box-shadow: inset 2px 0 0 #ffffff;
  }

  .ed-node > .ed-ico {
    color: var(--ed-muted);
  }

  .ed-node__name {
    flex: none;
    font-weight: 500;
  }

  .ed-node__text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--ed-muted);
  }

  .ed-badge {
    flex: none;
    padding: 0.05rem 0.4rem;
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--ed-muted);
    border: 1px solid var(--ed-line-strong);
    border-radius: 999px;
  }

  .ed-tree {
    display: grid;
    gap: 0.1rem;
  }

  .ed-tree__line {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    min-width: 0;
    padding-left: calc(var(--depth, 0) * 0.9rem);
  }

  .ed-tree__line > .ed-node {
    overflow: hidden;
  }

  .ed-twisty {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    min-height: 1.5rem !important;
    padding: 0 !important;
    color: var(--ed-muted);
    border: 0 !important;
    background: transparent !important;
  }

  .ed-twisty .icon {
    transition: rotate 150ms ease;
  }

  .ed-twisty.is-open .icon {
    rotate: 90deg;
  }

  /* Projekte einer Leistungskarte */
  .ed-projects {
    display: grid;
    gap: 0.6rem;
  }

  .ed-projects__list {
    display: grid;
    gap: 0.3rem;
    padding: 0;
    list-style: none;
  }

  .ed-projects__list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.55rem;
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.5rem;
    background: var(--ed-bg);
  }

  .ed-projects__list li > span {
    display: grid;
