---
/**
 * EditMode – Bearbeiten-Modus der Website (Knopf „Bearbeiten“ oben rechts).
 * Seitenleiste links in Dunkelgrün – so ist alles, was zur Bearbeitung gehört, klar von der Website zu unterscheiden:
 *  · Auswahl:  Element anklicken (Text → nur der Text, freie Fläche → Karte/Abschnitt) und in der Leiste bearbeiten:
 *              Text, Kopfbild, Galerie, Referenzprojekte, Gestaltung, Abstände, Einfügen, enthaltene Elemente
 *  · Einfügen: Vorlagen, Basis-Elemente und Container mit Vorschau (BlockEditorUI.astro)
 *  · Ebenen:   Aufbau der Seite als Baum
 *  · Abstände: Außen-/Innenabstände sichtbar machen und einstellen
 * Logik: src/scripts/editor/ (Seitenleiste) und src/scripts/block-editor.ts (Elemente) · Server: worker/edit.ts.
 * Erscheint nur, wenn der Worker den Modus meldet (GET /api/edit/status/).
 */
import { getImage } from 'astro:assets';
import BlockEditorUI from './BlockEditorUI.astro';
import Icon from '@/components/ui/Icon.astro';
import { listImages } from '@/lib/images';

// Auswahl fürs Kopfbild: alle Querformat-Fotos als kleine Vorschau (erst beim Öffnen des Dialogs geladen)
const heroChoices = await Promise.all(
  listImages()
    .filter(({ image }) => image.width > image.height)
    .sort((a, b) => a.name.localeCompare(b.name, 'de', { numeric: true }))
    .map(async ({ name, image }) => ({ name, thumb: (await getImage({ src: image, width: 320, format: 'webp', quality: 60 })).src })),
);

// Symbole für die Seitenleiste (werden im Browser geklont – src/scripts/editor/index.ts)
const ICONS = [
  'box', 'mouse-pointer-click', 'plus', 'layers', 'corner-left-up', 'arrow-up', 'arrow-down', 'copy', 'move', 'trash-2',
  'play', 'blocks', 'link', 'palette', 'move-diagonal', 'list-tree', 'type', 'image', 'images', 'folder-plus',
  'rotate-ccw', 'align-left', 'align-center', 'align-right', 'align-justify', 'arrow-up-to-line', 'panel-top-open',
  'panel-bottom-open', 'arrow-down-to-line', 'crosshair', 'hand', 'x', 'chevron-right', 'sliders-horizontal',
  'panel-top', 'panel-bottom', 'square-stack', 'minus', 'heading', 'highlighter', 'tag', 'shapes', 'square', 'dot',
  'list', 'quote', 'text-cursor-input', 'menu', 'layout-template', 'layout-grid', 'rows-3',
  'eye', 'eye-off', 'smartphone', 'monitor', 'sparkles', 'square-plus',
];
---

<div class="edit-ui" data-edit-ui hidden>
  <button class="ed-toggle" type="button" data-ed-toggle title="Seite bearbeiten">
    <Icon name="pencil" size="1rem" />
    <span>Bearbeiten</span>
  </button>

  <aside class="ed-sidebar" data-ed-sidebar data-size="half" hidden aria-label="Bearbeiten">
    <header class="ed-head">
      <button class="ed-head__logo" type="button" data-ed-collapse title="Leiste ein- oder ausklappen">
        <Icon name="pencil" size="1rem" class="ed-head__pen" />
        <Icon name="panel-left-open" size="1.05rem" class="ed-head__open" />
      </button>
      <div class="ed-head__title">
        <strong>Bearbeiten</strong>
        <small data-ed-page></small>
      </div>
      <button class="ed-icon-btn" type="button" data-ed-interact aria-pressed="false" title="Seite bedienen (Reiter, Galerien …) – geht auch mit Alt + Klick">
        <Icon name="hand" size="1.05rem" />
      </button>
      <button class="ed-icon-btn ed-sheet-btn" type="button" data-ed-sheet title="Leiste größer oder kleiner">
        <Icon name="chevrons-up-down" size="1.05rem" />
      </button>
      <button class="ed-icon-btn ed-collapse-btn" type="button" data-ed-collapse title="Leiste einklappen">
        <Icon name="panel-left-close" size="1.05rem" />
      </button>
      <button class="ed-icon-btn" type="button" data-ed-close title="Bearbeiten beenden">
        <Icon name="x" size="1.1rem" />
      </button>
    </header>

    <nav class="ed-tabs" role="tablist" aria-label="Werkzeuge">
      <button type="button" role="tab" data-ed-tab="inspect" aria-selected="true"><Icon name="mouse-pointer-2" size="1.05rem" /><span>Auswahl</span></button>
      <button type="button" role="tab" data-ed-tab="insert" aria-selected="false"><Icon name="square-plus" size="1.05rem" /><span>Einfügen</span></button>
      <button type="button" role="tab" data-ed-tab="layers" aria-selected="false"><Icon name="layers" size="1.05rem" /><span>Ebenen</span></button>
      <button type="button" role="tab" data-ed-tab="spacing" aria-selected="false"><Icon name="move-diagonal" size="1.05rem" /><span>Abstände</span></button>
    </nav>

    <div class="ed-hint" data-ed-hint hidden>
      <span data-ed-hint-text></span>
      <button type="button" data-ed-hint-cancel>Abbrechen</button>
    </div>

    <div class="ed-body">
      <section data-ed-panel="inspect"><div data-ed-inspector></div></section>
      <section data-ed-panel="insert" hidden>
        <div data-ed-target></div>
        <BlockEditorUI part="library" />
      </section>
      <section data-ed-panel="layers" hidden><div class="ed-tree" data-ed-tree></div></section>
      <section data-ed-panel="spacing" hidden><div class="ed-spacing" data-ed-spacing></div></section>
    </div>

    <footer class="ed-foot">
      <p class="ed-status" data-ed-status aria-live="polite"></p>
      <div class="ed-foot__buttons">
        <button class="ed-btn" type="button" data-ed-discard disabled><Icon name="undo-2" size="1rem" /><span>Verwerfen</span></button>
        <button class="ed-btn ed-btn--primary" type="button" data-ed-save disabled><Icon name="save" size="1rem" /><span>Speichern</span></button>
      </div>
    </footer>
  </aside>

  <!-- Markierungen auf der Seite -->
  <div class="ed-box ed-box--hover" data-ed-hover hidden><span class="ed-box__tag"></span></div>
  <div class="ed-box ed-box--select" data-ed-select hidden>
    <div class="ed-box__bar">
      <span class="ed-box__tag"></span>
      <button type="button" data-ed-quick="parent" title="Übergeordnetes Element wählen"><Icon name="corner-left-up" size="0.95rem" /></button>
      <button type="button" data-ed-quick="duplicate" title="Duplizieren"><Icon name="copy" size="0.95rem" /></button>
      <button type="button" data-ed-quick="delete" title="Löschen"><Icon name="trash-2" size="0.95rem" /></button>
    </div>
    <button class="ed-plus" type="button" data-ed-plus="before" title="Davor einfügen"><Icon name="plus" size="0.95rem" /></button>
    <button class="ed-plus" type="button" data-ed-plus="after" title="Dahinter einfügen"><Icon name="plus" size="0.95rem" /></button>
  </div>
  <div class="ed-spacing-overlay" data-ed-spacing-overlay hidden>
    <div class="ed-spacing-overlay__margin" data-ed-margin></div>
    <div class="ed-spacing-overlay__padding" data-ed-padding></div>
  </div>

  <template data-ed-icons>
    {ICONS.map((name) => <span class="ed-ico" data-icon={name}><Icon name={name} size="1rem" /></span>)}
  </template>

  <dialog class="gallery-dialog" data-hero-dialog aria-labelledby="hero-dialog-title">
    <form method="dialog" class="gallery-dialog__inner">
      <header class="gallery-dialog__head">
        <div>
          <p class="gallery-dialog__kicker">Kopfbild ändern</p>
          <h2 class="gallery-dialog__title" id="hero-dialog-title">Foto auswählen oder neues hochladen</h2>
        </div>
        <button class="gallery-dialog__close" type="button" aria-label="Schließen">
          <Icon name="x" size="1.1rem" />
        </button>
      </header>
      <ol class="gallery-dialog__grid hero-choices" data-hero-grid>
        {
          heroChoices.map((choice) => (
            <li>
              <button type="button" class="hero-choice" data-hero-choice={choice.name} title={choice.name}>
                <img src={choice.thumb} alt={choice.name} loading="lazy" decoding="async" width="320" height="200" />
              </button>
            </li>
          ))
        }
      </ol>
      <footer class="gallery-dialog__foot">
        <label class="gallery-dialog__add">
          <input type="file" accept="image/jpeg,image/png,image/webp" data-hero-upload />
          <Icon name="image-plus" size="1rem" /> Neues Bild hochladen
        </label>
        <p class="gallery-dialog__status" data-hero-status aria-live="polite"></p>
      </footer>
    </form>
  </dialog>

  <dialog class="gallery-dialog" data-gallery-dialog aria-labelledby="gallery-dialog-title">
    <form method="dialog" class="gallery-dialog__inner">
      <header class="gallery-dialog__head">
        <div>
          <p class="gallery-dialog__kicker">Galerie bearbeiten</p>
          <h2 class="gallery-dialog__title" id="gallery-dialog-title" data-gallery-title></h2>
        </div>
        <button class="gallery-dialog__close" type="button" aria-label="Schließen">
          <Icon name="x" size="1.1rem" />
        </button>
      </header>
      <p class="gallery-dialog__hint">Ziehen zum Sortieren (oder Pfeile) · Auge zum Aus-/Einblenden · neue Bilder werden automatisch verkleinert.</p>
      <ol class="gallery-dialog__grid" data-gallery-grid></ol>
      <footer class="gallery-dialog__foot">
        <label class="gallery-dialog__add">
          <input type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-gallery-add />
          <Icon name="image-plus" size="1rem" /> Bilder hinzufügen
        </label>
        <p class="gallery-dialog__status" data-gallery-status aria-live="polite"></p>
        <button class="ed-btn ed-btn--primary" type="button" data-gallery-save>Galerie speichern</button>
      </footer>
    </form>
  </dialog>

  <BlockEditorUI part="overlays" />
</div>

<script>
  import { initEditor } from '@/scripts/editor';

  initEditor();
</script>

<style is:global>
  /* ======================================================================
     Bearbeiten-Modus – eigenes dunkelgrünes Farbschema, klar getrennt von der Website
     ====================================================================== */
  :root {
    --ed-w: 23rem;
    --ed-rail: 3.75rem;
    --ed-bg: #0c2b21;
    --ed-bg-2: #0f3428;
    --ed-surface: #154335;
    --ed-surface-2: #1b5341;
    --ed-line: rgb(255 255 255 / 0.1);
    --ed-text: #e9f6f0;
    --ed-muted: #9cc2b1;
    --ed-accent: #34d399;
    --ed-accent-strong: #10b981;
    --ed-accent-ink: #04271b;
    --ed-danger: #fca5a5;
  }

  .edit-ui[hidden],
  .edit-ui [hidden] {
    display: none !important;
  }

  /* Knopf zum Starten */
  .ed-toggle {
    position: fixed;
    top: calc(var(--header-height) + 0.75rem);
    right: 1rem;
    z-index: 1001;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1rem 0.6rem 0.85rem;
    font: 700 0.85rem/1 var(--font-sans);
    color: var(--ed-text);
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: var(--ed-bg);
    box-shadow: 0 12px 30px -12px rgb(0 0 0 / 0.55);
    cursor: pointer;
  }

  .ed-toggle .icon {
    color: var(--ed-accent);
  }

  /*
   * Platz für die Seitenleiste (ab Tablet): Die Seite wird neben der Leiste proportional verkleinert (--ed-zoom,
   * gesetzt von src/scripts/editor/index.ts) – so bleibt das Layout genau wie in voller Breite, nichts bricht um.
   * Auf dem Handy liegt die Leiste unten und die Seite bekommt dort Luft.
   */
  @media (min-width: 48rem) {
    html.is-editing {
      --ed-space: var(--ed-w);
    }

    html.is-editing.ed-collapsed {
      --ed-space: var(--ed-rail);
    }

    html.is-editing body {
      padding-left: var(--ed-space);
    }

    html.is-editing :is(main, .site-footer) {
      zoom: var(--ed-zoom, 1);
    }

    html.is-editing .site-header {
      zoom: var(--ed-zoom, 1);
      left: calc(var(--ed-space) / var(--ed-zoom, 1));
    }
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    :root {
      --ed-w: 20rem;
    }
  }

  @media (min-width: 100rem) {
    :root {
      --ed-w: 25rem;
    }
  }

  @media (max-width: 47.99rem) {
    html.is-editing body {
      padding-bottom: 55dvh;
    }
  }

  /* Beim Auswählen keine Textcursor/Links auf der Seite */
  html.is-editing:not(.ed-interact) :is(main, .site-header, .site-footer) * {
    cursor: default;
  }

  /* Ausgeblendete Elemente bleiben im Bearbeiten-Modus abgeblendet sichtbar */
  html.is-editing [data-ed-hide] {
    opacity: 0.4 !important;
    outline: 2px dashed rgb(16 185 129 / 0.6);
    outline-offset: -2px;
  }

  /* ---------------- Seitenleiste ---------------- */
  .ed-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 1005;
    display: flex;
    flex-direction: column;
    width: var(--ed-w);
    font: 400 0.875rem/1.45 var(--font-sans);
    color: var(--ed-text);
    border-right: 1px solid var(--ed-line);
    background: var(--ed-bg);
    box-shadow: 8px 0 40px -20px rgb(0 0 0 / 0.6);
    color-scheme: dark;
    animation: ed-slide-in 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
    transition: width 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes ed-slide-in {
    from {
      transform: translateX(-100%);
    }
  }

  @keyframes ed-fade-up {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .ed-body > section:not([hidden]) {
    animation: ed-fade-up 220ms ease;
  }

  .ed-sidebar :is(h1, h2, h3, p, ul, ol) {
    margin: 0;
  }

  .ed-sidebar .icon {
    flex: none;
  }

  .ed-sheet-btn {
    display: none !important;
  }

  .ed-sidebar .ed-head__logo .ed-head__open {
    display: none;
  }

  /* Eingeklappt: schmale Symbolleiste – Werkzeuge bleiben mit einem Klick erreichbar */
  @media (min-width: 48rem) {
    .ed-sidebar[data-collapsed] {
      width: var(--ed-rail);
    }

    .ed-sidebar[data-collapsed] :is(.ed-head__title, .ed-head .ed-icon-btn, .ed-hint, .ed-body, .ed-status, .ed-tabs span, .ed-foot__buttons span, [data-ed-discard]) {
      display: none !important;
    }

    .ed-sidebar[data-collapsed] .ed-head {
      justify-content: center;
      padding-inline: 0;
    }

    .ed-sidebar[data-collapsed] .ed-head__logo .ed-head__pen {
      display: none;
    }

    .ed-sidebar[data-collapsed] .ed-head__logo .ed-head__open {
      display: block;
    }

    .ed-sidebar[data-collapsed] .ed-tabs {
      grid-template-columns: 1fr;
      border-bottom: 0;
    }

    .ed-sidebar[data-collapsed] .ed-tabs button {
      padding-block: 0.7rem;
    }

    .ed-sidebar[data-collapsed] .ed-foot {
      margin-top: auto;
      padding-inline: 0.5rem;
    }

    .ed-sidebar[data-collapsed] .ed-foot__buttons {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47.99rem) {
    .ed-collapse-btn {
      display: none !important;
    }

    .ed-sidebar {
      inset: auto 0 0 0;
      width: 100%;
      height: 52dvh;
      border-right: 0;
      border-radius: 1.1rem 1.1rem 0 0;
      box-shadow: 0 -10px 40px -16px rgb(0 0 0 / 0.6);
      transition: height 250ms ease;
    }

    .ed-sidebar[data-size='full'] {
      height: 88dvh;
    }

    .ed-sidebar[data-size='min'] {
      height: auto;
    }

    .ed-sidebar[data-size='min'] :is(.ed-tabs, .ed-body, .ed-foot) {
      display: none;
    }

    .ed-sheet-btn {
      display: grid !important;
    }
  }

  .ed-head {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.6rem 0.6rem 0.9rem;
    border-bottom: 1px solid var(--ed-line);
  }

  .ed-head__logo {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    color: var(--ed-accent-ink);
    border: 0;
    border-radius: 0.65rem;
    background: linear-gradient(140deg, #6ee7b7, var(--ed-accent-strong));
    box-shadow: 0 6px 16px -8px rgb(16 185 129 / 0.8);
    cursor: pointer;
  }

  .ed-head__title {
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.25;
  }

  .ed-head__title small {
    overflow: hidden;
    font-size: 0.75rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--ed-muted);
  }

  .ed-icon-btn {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    color: var(--ed-muted);
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    cursor: pointer;
  }

  .ed-icon-btn:hover,
  .ed-icon-btn:focus-visible {
    color: var(--ed-text);
    background: var(--ed-surface);
  }

  .ed-icon-btn[aria-pressed='true'] {
    color: var(--ed-accent-ink);
    background: var(--ed-accent);
  }

  .ed-tabs {
    display: grid;
    flex: none;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--ed-line);
  }

  .ed-tabs button {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    padding: 0.45rem 0.2rem 0.4rem;
    font: 600 0.72rem/1.2 var(--font-sans);
    color: var(--ed-muted);
    border: 0;
    border-radius: 0.6rem;
    background: transparent;
    cursor: pointer;
  }

  .ed-tabs button:hover {
    color: var(--ed-text);
  }

  .ed-tabs button[aria-selected='true'] {
    color: var(--ed-text);
    background: var(--ed-surface);
    box-shadow: inset 0 -2px 0 var(--ed-accent);
  }

  .ed-tabs button[aria-selected='true'] .icon {
    color: var(--ed-accent);
  }

  .ed-hint {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.6rem;
    margin: 0.6rem 0.6rem 0;
    padding: 0.55rem 0.55rem 0.55rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ed-accent-ink);
    border-radius: 0.7rem;
    background: var(--ed-accent);
  }

  .ed-hint span {
    flex: 1;
  }

  .ed-hint button {
    padding: 0.35rem 0.7rem;
    font: inherit;
    color: var(--ed-text);
    border: 0;
    border-radius: 999px;
    background: var(--ed-bg);
    cursor: pointer;
  }

  .ed-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.8rem 0.8rem 1.2rem;
    scrollbar-color: var(--ed-surface-2) transparent;
  }

  .ed-body > section {
    display: grid;
    gap: 0.75rem;
  }

  .ed-foot {
    display: grid;
    flex: none;
    gap: 0.5rem;
    padding: 0.65rem 0.8rem 0.8rem;
    border-top: 1px solid var(--ed-line);
    background: var(--ed-bg-2);
  }

  .ed-status {
    font-size: 0.76rem;
    color: var(--ed-muted);
  }

  .ed-status.is-dirty {
    color: var(--ed-text);
  }

  .ed-status.is-dirty::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: #fbbf24;
  }

  .ed-foot__buttons {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 0.5rem;
  }

  /* ---------------- Bausteine der Seitenleiste ---------------- */
  .ed-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.2rem;
    padding: 0.4rem 0.8rem;
    font: 600 0.8rem/1.2 var(--font-sans);
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.6rem;
    background: var(--ed-surface);
    cursor: pointer;
  }

  .ed-btn:hover:not(:disabled),
  .ed-btn:focus-visible {
    border-color: rgb(52 211 153 / 0.6);
    background: var(--ed-surface-2);
  }

  .ed-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .ed-btn--primary {
    color: var(--ed-accent-ink);
    border-color: var(--ed-accent);
    background: var(--ed-accent);
  }

  .ed-btn--primary:hover:not(:disabled),
  .ed-btn--primary:focus-visible {
    color: var(--ed-accent-ink);
    background: #6ee7b7;
  }

  .ed-btn--danger:hover:not(:disabled) {
    color: #450a0a;
    border-color: var(--ed-danger);
    background: var(--ed-danger);
  }

  .ed-btn--ghost {
    min-height: 1.9rem;
    padding: 0.3rem;
    border-color: transparent;
    background: transparent;
  }

  .ed-btn--block {
    width: 100%;
  }

  .ed-btn--small {
    min-height: 1.8rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
  }

  .ed-note {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ed-muted);
  }

  .ed-note--ok {
    padding: 0.5rem 0.65rem;
    color: var(--ed-text);
    border-radius: 0.6rem;
    background: rgb(52 211 153 / 0.15);
  }

  .ed-muted {
    color: var(--ed-muted);
  }

  .ed-code {
    padding: 0.4rem 0.55rem;
    overflow-wrap: anywhere;
    font: 0.78rem/1.4 ui-monospace, 'Cascadia Code', monospace;
    border-radius: 0.45rem;
    background: var(--ed-bg-2);
  }

  .ed-row2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  /* Leerer Zustand */
  .ed-empty {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding: 0.4rem 0.2rem;
  }

  .ed-empty__art {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 7.5rem;
    overflow: hidden;
    border-radius: 1rem;
    background:
      radial-gradient(circle at 30% 30%, rgb(52 211 153 / 0.35), transparent 55%),
      radial-gradient(circle at 80% 70%, rgb(16 185 129 / 0.25), transparent 50%),
      var(--ed-surface);
  }

  .ed-empty__art::before {
    content: '';
    position: absolute;
    inset: 1.4rem 2.2rem;
    border: 2px dashed rgb(110 231 183 / 0.7);
    border-radius: 0.6rem;
  }

  .ed-empty__art .ed-ico {
    position: relative;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    font-size: 1.4rem;
    color: var(--ed-accent-ink);
    border-radius: 50%;
    background: var(--ed-accent);
    box-shadow: 0 10px 24px -8px rgb(16 185 129 / 0.9);
  }

  .ed-empty strong {
    font-size: 1rem;
  }

  .ed-empty p {
    color: var(--ed-muted);
  }

  .ed-tips {
    display: grid;
    gap: 0.35rem;
    width: 100%;
    padding: 0.7rem 0.8rem 0.7rem 1.6rem !important;
    font-size: 0.8rem;
    border-radius: 0.7rem;
    background: var(--ed-bg-2);
  }

  .ed-empty .ed-row2 {
    width: 100%;
  }

  /* Pfad (Brotkrumen) */
  .ed-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  .ed-crumb {
    min-height: 1.6rem;
    padding: 0.15rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ed-muted);
    border-color: transparent;
    border-radius: 999px;
    background: var(--ed-bg-2);
  }

  .ed-crumb + .ed-crumb::before {
    content: '›';
    margin-right: 0.15rem;
    opacity: 0.6;
  }

  .ed-crumb.is-current {
    color: var(--ed-accent-ink);
    background: var(--ed-accent);
  }

  /* Titel des gewählten Elements */
  .ed-title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .ed-title__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    font-size: 1.15rem;
    color: var(--ed-accent);
    border-radius: 0.7rem;
    background: var(--ed-surface);
  }

  .ed-title__text {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }

  .ed-title__text strong {
    font-size: 1.02rem;
  }

  .ed-title__text code {
    overflow: hidden;
    font: 0.72rem/1.4 ui-monospace, 'Cascadia Code', monospace;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--ed-muted);
  }

  .ed-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .ed-actions .ed-btn {
    min-width: 2.2rem;
    padding-inline: 0.5rem;
  }

  .ed-grab {
    cursor: grab;
    touch-action: none;
  }

  /* Aufklappbare Gruppen (auch die Felder der Baukasten-Elemente) */
  .ed-group,
  .ed-block-fields .ub-g {
    border: 1px solid var(--ed-line);
    border-radius: 0.8rem;
    background: var(--ed-bg-2);
  }

  .ed-block-fields {
    display: grid;
    gap: 0.75rem;
  }

  .ed-group > summary,
  .ed-block-fields .ub-g > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  .ed-group > summary::-webkit-details-marker,
  .ed-block-fields .ub-g > summary::-webkit-details-marker {
    display: none;
  }

  .ed-group > summary .icon {
    color: var(--ed-accent);
  }

  .ed-group > summary::after,
  .ed-block-fields .ub-g > summary::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    margin-left: auto;
    border-right: 2px solid var(--ed-muted);
    border-bottom: 2px solid var(--ed-muted);
    rotate: -45deg;
    transition: rotate 150ms ease;
  }

  .ed-group[open] > summary::after,
  .ed-block-fields .ub-g[open] > summary::after {
    rotate: 45deg;
  }

  .ed-group > :not(summary),
  .ed-block-fields .ub-g > :not(summary) {
    margin: 0 0.75rem 0.75rem;
  }

  .ed-group[open] > summary,
  .ed-block-fields .ub-g[open] > summary {
    padding-bottom: 0.45rem;
  }

  /* Felder */
  .ed-field,
  .ed-block-fields .ub-f {
    display: grid;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ed-muted);
  }

  .ed-field.is-changed > span::after {
    content: ' · geändert';
    color: #fbbf24;
  }

  .ed-sidebar :is(input[type='text'], input[type='number'], textarea, select) {
    width: 100%;
    min-width: 0;
    padding: 0.45rem 0.55rem;
    font: 400 0.88rem/1.4 var(--font-sans);
    color: var(--ed-text);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 0.5rem;
    background: var(--ed-bg);
  }

  .ed-sidebar :is(input, textarea, select):focus {
    outline: none;
    border-color: var(--ed-accent);
    box-shadow: 0 0 0 3px rgb(52 211 153 / 0.25);
  }

  .ed-sidebar textarea {
    resize: vertical;
    overflow: hidden;
  }

  .ed-sidebar input::placeholder,
  .ed-sidebar textarea::placeholder {
    color: rgb(156 194 177 / 0.6);
  }

  .ed-unit {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 400;
  }

  .ed-color {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .ed-color input[type='color'] {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 0.45rem;
    background: none;
    cursor: pointer;
  }

  .ed-color code {
    min-width: 4.6rem;
    font-size: 0.72rem;
    color: var(--ed-text);
  }

  .ed-swatches {
    display: flex;
    gap: 0.25rem;
  }

  .ed-swatch {
    width: 1.35rem;
    min-height: 1.35rem !important;
    padding: 0 !important;
    border: 1px solid rgb(255 255 255 / 0.35) !important;
    border-radius: 50% !important;
    background: var(--swatch) !important;
  }

  .ed-seg {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 2px;
    padding: 2px;
    border-radius: 0.6rem;
    background: var(--ed-bg);
  }

  .ed-seg .ed-btn {
    min-height: 2rem;
    padding: 0.3rem 0.25rem;
    font-size: 0.72rem;
    border-color: transparent;
    border-radius: 0.45rem;
    background: transparent;
  }

  .ed-seg .ed-btn[aria-pressed='true'] {
    color: var(--ed-accent-ink);
    background: var(--ed-accent);
  }

  .ed-subhead {
    margin-top: 0.3rem !important;
    padding-top: 0.6rem;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ed-accent);
    border-top: 1px solid var(--ed-line);
  }

  .ed-subhead:first-of-type {
    margin-top: 0 !important;
    padding-top: 0;
    border-top: 0;
  }

  /* Schieberegler mit Zahlenfeld */
  .ed-range {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.6rem;
    align-items: center;
    gap: 0.6rem;
  }

  .ed-range input[type='range'] {
    width: 100%;
    accent-color: var(--ed-accent);
    cursor: pointer;
  }

  .ed-range .ed-unit input {
    padding-inline: 0.4rem;
  }

  /* Startbildschirm */
  .ed-steps {
    display: grid;
    gap: 0.45rem;
    width: 100%;
  }

  .ed-step {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr);
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.7rem;
    font: inherit;
    text-align: left;
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.8rem;
    background: var(--ed-bg-2);
    cursor: pointer;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  .ed-step:hover {
    border-color: rgb(52 211 153 / 0.6);
    transform: translateX(2px);
  }

  .ed-step > .ed-ico {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    color: var(--ed-accent);
    border-radius: 0.6rem;
    background: var(--ed-surface);
  }

  .ed-step span {
    display: grid;
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .ed-step small {
    color: var(--ed-muted);
  }

  .ed-count {
    min-width: 1.3rem;
    padding: 0.05rem 0.35rem;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--ed-accent);
    border-radius: 999px;
    background: var(--ed-accent-ink);
  }

  /* Abstände als Box (wie in den Entwicklerwerkzeugen) */
  .ed-bm,
  .ed-bm__inner {
    position: relative;
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr) 3.6rem;
    grid-template-areas: '. t .' 'l c r' '. b .';
    align-items: center;
    justify-items: center;
    gap: 0.35rem;
    padding: 1.3rem 0.45rem 0.45rem;
    border: 1px dashed rgb(251 146 60 / 0.7);
    border-radius: 0.7rem;
    background: rgb(251 146 60 / 0.1);
  }

  .ed-bm__inner {
    grid-area: c;
    width: 100%;
    border-color: rgb(56 189 248 / 0.7);
    background: rgb(56 189 248 / 0.1);
  }

  .ed-bm__label {
    position: absolute;
    top: 0.25rem;
    left: 0.5rem;
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ed-muted);
  }

  .ed-bm input {
    width: 3.4rem !important;
    padding: 0.3rem 0.25rem !important;
    font-size: 0.8rem !important;
    text-align: center;
  }

  .ed-bm__mt,
  .ed-bm__pt {
    grid-area: t;
  }

  .ed-bm__ml,
  .ed-bm__pl {
    grid-area: l;
  }

  .ed-bm__mr,
  .ed-bm__pr {
    grid-area: r;
  }

  .ed-bm__mb,
  .ed-bm__pb {
    grid-area: b;
  }

  .ed-bm__size {
    grid-area: c;
    font-size: 0.7rem;
    color: var(--ed-muted);
    white-space: nowrap;
  }

  /* Einfügen relativ zum Element */
  .ed-insert-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .ed-insert-grid .ed-btn {
    justify-content: flex-start;
  }

  .ed-target {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.7rem;
    border: 1px dashed rgb(52 211 153 / 0.45);
    border-radius: 0.8rem;
  }

  .ed-target > .ed-ico {
    font-size: 1.2rem;
    color: var(--ed-accent);
  }

  .ed-target > span {
    display: grid;
    flex: 1;
    gap: 0.1rem;
    font-size: 0.78rem;
  }

  .ed-target small {
    font-size: 0.74rem;
    color: var(--ed-muted);
  }

  .ed-target.is-set {
    border-style: solid;
    border-color: var(--ed-accent);
    background: rgb(52 211 153 / 0.12);
  }

  /* Listen: enthaltene Elemente und Ebenen */
  .ed-nodes {
    display: grid;
    gap: 0.15rem;
  }

  .ed-node {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    padding: 0.4rem 0.5rem;
    font: 400 0.8rem/1.3 var(--font-sans);
    text-align: left;
    color: var(--ed-text);
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    cursor: pointer;
  }

  .ed-node:hover,
  .ed-node:focus-visible {
    background: var(--ed-surface);
  }

  .ed-node.is-current {
    background: var(--ed-surface-2);
    box-shadow: inset 2px 0 0 var(--ed-accent);
  }

  .ed-node > .ed-ico {
    color: var(--ed-accent);
  }

  .ed-node__name {
    flex: none;
    font-weight: 600;
  }

  .ed-node__text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--ed-muted);
  }

  .ed-badge {
    flex: none;
    padding: 0.05rem 0.4rem;
    font-size: 0.66rem;
    font-weight: 700;
    color: #fde68a;
    border-radius: 999px;
    background: rgb(251 191 36 / 0.15);
  }

  .ed-tree {
    display: grid;
    gap: 0.1rem;
  }

  .ed-tree__line {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    min-width: 0;
    padding-left: calc(var(--depth, 0) * 0.9rem);
  }

  .ed-tree__line > .ed-node {
    overflow: hidden;
  }

  .ed-body {
    overflow-x: hidden;
  }

  .ed-twisty {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    min-height: 1.5rem !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
  }

  .ed-twisty .icon {
    transition: rotate 150ms ease;
  }

  .ed-twisty.is-open .icon {
    rotate: 90deg;
  }

  /* Projekte einer Leistungskarte */
  .ed-projects {
    display: grid;
    gap: 0.6rem;
  }

  .ed-projects__list {
    display: grid;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }

  .ed-projects__list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.55rem;
    border-radius: 0.55rem;
    background: var(--ed-surface);
  }

  .ed-projects__list li > span {
    display: grid;
    flex: 1;
    min-width: 0;
    font-size: 0.8rem;
  }

  .ed-projects__list small {
    font-size: 0.7rem;
    color: var(--ed-muted);
  }

  .ed-form {
    display: grid;
    gap: 0.55rem;
  }

  .ed-upload {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0.9rem 0.7rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-align: center;
    color: var(--ed-text);
    border: 1.5px dashed rgb(52 211 153 / 0.55);
    border-radius: 0.7rem;
    cursor: pointer;
  }

  .ed-upload input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .ed-thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.3rem;
  }

  .ed-thumbs:empty {
    display: none;
  }

  .ed-thumbs img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.4rem;
  }

  .ed-thumbs img:first-child {
    outline: 2px solid var(--ed-accent);
  }

  .ed-form__status:empty {
    display: none;
  }

  .ed-form__status {
    font-size: 0.75rem;
    color: var(--ed-muted);
  }

  /* Einstellungsfelder der Baukasten-Elemente (src/scripts/block-editor.ts) */
  .ed-block-fields .ub-f small {
    font-weight: 400;
    color: var(--ed-muted);
  }

  .ed-block-fields .ub-f--toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ed-text);
  }

  .ed-block-fields .ub-f__invalid {
    color: #fde68a !important;
  }

  .ed-block-fields .ub-f__image {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
  }

  .ed-block-fields .ub-f__thumb {
    width: 5rem;
    height: 3.6rem;
    overflow: hidden;
    border-radius: 0.45rem;
    background: var(--ed-bg);
  }

  .ed-block-fields .ub-f__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ed-block-fields .ub-f__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .ed-block-fields :is(.ub-f__buttons button, .ub-f__mini, .ub-reset, .ub-color__reset, .ub-f__list button) {
    padding: 0.35rem 0.7rem;
    font: 600 0.75rem/1.2 var(--font-sans);
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.5rem;
    background: var(--ed-surface);
    cursor: pointer;
  }

  .ed-block-fields .ub-f__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }

  .ed-block-fields .ub-f__list li {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 0.45rem;
    background: var(--ed-bg);
  }

  .ed-block-fields .ub-f__list img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ed-block-fields .ub-f__list span {
    position: absolute;
    inset: auto 0.2rem 0.2rem;
    display: flex;
    justify-content: space-between;
  }

  .ed-block-fields .ub-f__list button {
    padding: 0.1rem 0.35rem;
  }

  .ed-block-fields .ub-f__icons {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .ed-block-fields .ub-f__icons button {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: 1rem;
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.45rem;
    background: var(--ed-bg);
    cursor: pointer;
  }

  .ed-block-fields .ub-f__icons button[aria-pressed='true'] {
    color: var(--ed-accent-ink);
    background: var(--ed-accent);
  }

  .ed-block-fields .ub-num {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 400;
  }

  .ed-block-fields .ub-sides {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.3rem;
  }

  .ed-block-fields .ub-sides label {
    display: grid;
    gap: 0.15rem;
    font-size: 0.66rem;
  }

  .ed-block-fields .ub-align {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.25rem;
  }

  .ed-block-fields .ub-align button {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: 0.35rem 0.2rem;
    font: 600 0.65rem/1.2 var(--font-sans);
    color: var(--ed-text);
    border: 1px solid var(--ed-line);
    border-radius: 0.5rem;
    background: var(--ed-bg);
    cursor: pointer;
  }

  .ed-block-fields .ub-align button[aria-pressed='true'] {
    color: var(--ed-accent-ink);
    background: var(--ed-accent);
  }

  .ed-block-fields .ub-color {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .ed-block-fields .ub-color input[type='color'] {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 0.45rem;
    background: none;
  }

  .ed-block-fields .ub-color code {
    font-size: 0.72rem;
    color: var(--ed-text);
  }

  .ed-block-fields .ub-swatches {
    display: flex;
    gap: 0.25rem;
  }

  .ed-block-fields .ub-swatches button {
    width: 1.35rem;
    height: 1.35rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    background: var(--swatch);
    cursor: pointer;
  }

  /* ---------------- Markierungen auf der Seite ---------------- */
  .ed-box {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1003;
    border-radius: 3px;
    pointer-events: none;
  }

  .ed-box--hover {
    outline: 1.5px dashed var(--ed-accent-strong);
    outline-offset: 1px;
    background: rgb(52 211 153 / 0.06);
  }

  .ed-box--select {
    outline: 2px solid var(--ed-accent-strong);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px rgb(52 211 153 / 0.18);
  }

  .ed-box__tag {
    position: absolute;
    bottom: calc(100% + 5px);
    left: -2px;
    padding: 0.15rem 0.5rem;
    font: 700 0.7rem/1.35 var(--font-sans);
    white-space: nowrap;
    color: var(--ed-accent-ink);
    border-radius: 0.35rem;
    background: var(--ed-accent);
  }

  .ed-box--hover .ed-box__tag {
    color: var(--ed-accent);
    background: var(--ed-bg);
  }

  .ed-box[data-below] .ed-box__tag {
    top: calc(100% + 5px);
    bottom: auto;
  }

  .ed-box__tag:empty {
    display: none;
  }

