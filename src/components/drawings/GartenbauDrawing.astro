---
/**
 * Technische Zeichnung „Regelquerschnitt Terrasse und Pflanzfläche“: Pflasterbelag mit Bettung
 * und Tragschicht, Randeinfassung mit Rückenstütze, Pflanzfläche mit verankertem Baum und Stauden.
 * Schematische Darstellung ohne Maßstab.
 */
import HatchPatterns from './HatchPatterns.astro';
import { type Callout, drawingUid, leaderLeft, leaderRight } from '@/lib/drawing';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const uid = drawingUid('garten');
const url = (name: string) => `url(#${uid}-${name})`;

// Geometrie
const xL = 130; // linke Schnittkante (Terrasse)
const xE = 300; // Randeinfassung
const xR = 470; // rechte Schnittkante (Pflanzfläche)
const y0 = 130; // Oberkante Gelände

const joints = Array.from({ length: 9 }, (_, i) => xL + 17 * (i + 1)).filter((x) => x < xE);

// Baumkrone als gewellter Umriss
const crown = { x: 400, y: 42, r: 33 };
const lobes = 11;
const crownPath =
  Array.from({ length: lobes + 1 }, (_, i) => {
    const a = (i / lobes) * Math.PI * 2 - Math.PI / 2;
    const px = (crown.x + Math.cos(a) * crown.r).toFixed(1);
    const py = (crown.y + Math.sin(a) * crown.r).toFixed(1);
    return i === 0 ? `M${px} ${py}` : `A10.5 10.5 0 0 1 ${px} ${py}`;
  }).join(' ') + ' Z';

// Staude/Strauch in Ansicht: gewölbter, gewellter Umriss
const shrubPath = 'M441 130 A6 6 0 0 1 446 121 A6.5 6.5 0 0 1 455 115.5 A6.5 6.5 0 0 1 464 121 A5.5 5.5 0 0 1 467 130 Z';

const left: Callout[] = [
  { x: xL, y: 135, ly: 112, text: 'Pflasterbelag' },
  { x: xL, y: 142.5, ly: 132, text: 'Bettung (Splitt)' },
  { x: xL, y: 165, ly: 156, text: 'Tragschicht' },
  { x: xL, y: 212, ly: 206, text: 'Untergrund' },
];

const right: Callout[] = [
  { x: 428, y: 100, ly: 80, text: 'Baumverankerung' },
  { x: 464, y: 122, ly: 106, text: 'Staudenpflanzung' },
  { x: xR, y: 137, ly: 132, text: 'Oberboden' },
  { x: 416, y: 156, ly: 158, text: 'Wurzelballen' },
  { x: xR, y: 202, ly: 204, text: 'Unterboden' },
];
---

<svg
  class:list={['drawing', className]}
  viewBox="-10 0 620 305"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Schematischer Querschnitt einer gepflasterten Terrasse mit Randeinfassung und angrenzender Pflanzfläche mit Baum"
>
  <HatchPatterns uid={uid} use={['soil', 'topsoil', 'gravel-fine', 'sand', 'concrete', 'mesh', 'fade', 'dot']} />

  <!-- Untergrund unter der Terrasse, Unterboden der Pflanzfläche -->
  <rect x={xL} y="185" width={xE - xL} height="75" fill={url('soil')} mask={url('fade-mask')} />
  <rect x={xE} y="160" width={xR - xE} height="100" fill={url('soil')} mask={url('fade-mask')} />

  <!-- Terrasse: Tragschicht, Bettung, Pflaster -->
  <rect class="d-fill" x={xL} y="145" width={xE - xL} height="40" />
  <rect x={xL} y="145" width={xE - xL} height="40" fill={url('gravel-fine')} />
  <rect x={xL} y="140" width={xE - xL} height="5" fill={url('sand')} />
  <rect class="d-fill-strong" x={xL} y={y0} width={xE - xL} height="10" />
  <path class="d-thin" d={joints.map((x) => `M${x} ${y0} V${y0 + 10}`).join(' ')} />

  <!-- Pflanzfläche: Oberboden -->
  <rect class="d-fill" x={xE} y={y0} width={xR - xE} height="30" />
  <rect x={xE} y={y0} width={xR - xE} height="30" fill={url('topsoil')} />

  <!-- Randeinfassung mit Rückenstütze -->
  <polygon class="d-fill" points="308,142 316,142 320,172 292,172 292,162 300,162" />
  <polygon points="308,142 316,142 320,172 292,172 292,162 300,162" fill={url('concrete')} />
  <polygon class="d-line" points="308,142 316,142 320,172 292,172 292,162 300,162" />
  <rect class="d-fill-strong" x={xE} y={y0} width="8" height="32" />
  <rect class="d-line" x={xE} y={y0} width="8" height="32" />

  <!-- Wurzelballen und Baumverankerung -->
  <ellipse class="d-paper" cx="400" cy="150" rx="20" ry="18" />
  <ellipse cx="400" cy="150" rx="20" ry="18" fill={url('mesh')} />
  <ellipse class="d-line" cx="400" cy="150" rx="20" ry="18" />
  <rect class="d-fill-strong" x="370.5" y="84" width="3" height="94" />
  <rect class="d-fill-strong" x="426.5" y="84" width="3" height="94" />
  <rect class="d-line" x="370.5" y="84" width="3" height="94" />
  <rect class="d-line" x="426.5" y="84" width="3" height="94" />
  <line class="d-line" x1="366" y1="92" x2="434" y2="92" />
  <path class="d-thin" d="M374 98 Q386 94 397 99 M426 98 Q414 94 403 99" />

  <!-- Baum -->
  <rect class="d-fill-strong" x="397.5" y="62" width="5" height={y0 - 62} />
  <rect class="d-line" x="397.5" y="62" width="5" height={y0 - 62} />
  <path class="d-fill" d={crownPath} />
  <path class="d-line" d={crownPath} />
  <path class="d-thin" d="M400 70 L386 44 M400 64 L415 38 M400 58 L401 24 M386 44 L376 38 M415 38 L424 46" />

  <!-- Stauden -->
  <path class="d-fill-strong" d={shrubPath} />
  <path class="d-soft" d={shrubPath} />
  <path class="d-thin" d="M454 130 L450 122 M454 130 L458 121 M454 130 V118" />

  <!-- Schichtgrenzen, Kontur -->
  <line class="d-thin" x1={xL} y1="140" x2={xE} y2="140" />
  <line class="d-thin" x1={xL} y1="145" x2={xE} y2="145" />
  <line class="d-thin" x1={xL} y1="185" x2={xE} y2="185" />
  <line class="d-thin" x1={xE + 8} y1="160" x2={xR} y2="160" />
  <line class="d-outline" x1={xL} y1={y0} x2={xR} y2={y0} />
  <line class="d-line" x1={xL} y1={y0} x2={xL} y2="200" />
  <line class="d-line" x1={xR} y1={y0} x2={xR} y2="200" />

  <!-- Gefälle -->
  <line class="d-dim" x1="180" y1="120" x2="262" y2="120" />
  <polygon class="d-arrow" points="262,120 255,117 255,123" />
  <text class="d-note" x="221" y="114" text-anchor="middle">Gefälle</text>

  <!-- Randeinfassung (Beschriftung oben) -->
  <path class="d-leader" d="M304 130 V94 H292" marker-start={url('dot')} />
  <text class="d-label" x="288" y="97.5" text-anchor="end">Randeinfassung</text>

  <!-- Beschriftung -->
  {
    right.map((c) => (
      <>
        <path class="d-leader" d={leaderRight(c, xR)} marker-start={url('dot')} />
        <text class="d-label" x={xR + 26} y={c.ly + 3.5}>
          {c.text}
        </text>
      </>
    ))
  }
  {
    left.map((c) => (
      <>
        <path class="d-leader" d={leaderLeft(c, xL)} marker-start={url('dot')} />
        <text class="d-label" x={xL - 26} y={c.ly + 3.5} text-anchor="end">
          {c.text}
        </text>
      </>
    ))
  }

  <!-- Plankopf -->
  <text class="d-title" x={xL} y="282">Regelquerschnitt Terrasse und Pflanzfläche</text>
  <text class="d-note" x={xL} y="297">Schematische Darstellung · ohne Maßstab</text>
</svg>
