---
/**
 * Choice – Auswahl als runde Chips (Einfachauswahl = Radio, Mehrfachauswahl = Checkbox).
 */
interface Props {
  name: string;
  label: string;
  options: readonly string[];
  multiple?: boolean;
  required?: boolean;
  /** Vorausgewählte Option(en) */
  value?: string | readonly string[];
  hint?: string;
  span?: 'full' | 'half' | 'third' | 'two-thirds';
}

const { name, label, options, multiple = false, required = false, value, hint, span = 'full' } = Astro.props;
const selected = new Set(Array.isArray(value) ? value : value ? [value] : []);
---

<fieldset class="choice" data-span={span}>
  <legend class="choice__label">
    {label}
    {required ? <abbr title="Pflichtfeld">*</abbr> : <span class="choice__optional">{multiple ? '(mehrere möglich)' : '(optional)'}</span>}
  </legend>
  <div class="choice__options">
    {
      options.map((option, index) => (
        <label class="choice__option">
          <input
            type={multiple ? 'checkbox' : 'radio'}
            name={name}
            value={option}
            required={required && !multiple && index === 0}
            checked={selected.has(option)}
          />
          <span class="choice__pill">{option}</span>
        </label>
      ))
    }
  </div>
  {hint && <p class="choice__hint">{hint}</p>}
</fieldset>

<style>
  .choice {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .choice__label {
    margin-bottom: 0.25rem;
    padding: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }

  .choice__label abbr {
    margin-left: 0.15em;
    text-decoration: none;
    color: var(--color-danger);
  }

  .choice__optional {
    margin-left: 0.35em;
    font-weight: var(--weight-regular);
    color: var(--color-text-subtle);
  }

  .choice__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .choice__option {
    position: relative;
    cursor: pointer;
  }

  .choice__option input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .choice__pill {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.8rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--gray-700);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: #ffffff;
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease,
      color var(--duration-base) ease;
  }

  .choice__option:hover .choice__pill {
    border-color: var(--blue-400);
    color: var(--blue-800);
  }

  .choice__option input:checked + .choice__pill {
    color: #ffffff;
    border-color: var(--blue-600);
    background: var(--blue-600);
  }

  .choice__option input:focus-visible + .choice__pill {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .choice__option input:user-invalid + .choice__pill {
    border-color: var(--color-danger);
  }

  .choice__hint {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
</style>
