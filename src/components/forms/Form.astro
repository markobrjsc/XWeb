---
/**
 * Form – Rahmen für Kontakt- und Bewerbungsformular: Felder (Slot), Spam-Schutz, Einwilligung,
 * Absende-Schaltfläche, Statusmeldung und Erfolgsansicht. Versand: src/scripts/forms.ts → /api/senden.
 *
 * <Form form="kontakt" submitLabel="Anfrage senden" successTitle="…" successText="…"> …Fieldsets… </Form>
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/config/site';
import type { FormId } from '@/lib/forms';

interface Props {
  form: FormId;
  submitLabel: string;
  successTitle: string;
  successText: string;
  /** Text der Einwilligung (ohne Link auf die Datenschutzerklärung) */
  consentText?: string;
  /** Überschrift oben in der Karte */
  title?: string;
  /** id der Überschrift – für aria-labelledby des umgebenden Abschnitts */
  titleId?: string;
  class?: string;
}

const {
  form,
  submitLabel,
  successTitle,
  successText,
  consentText = 'Ich bin einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage gespeichert und verwendet werden.',
  title,
  titleId,
  class: className,
} = Astro.props;
---

<div class:list={['form-shell', className]}>
  {title && <h2 class="form-shell__title" id={titleId}>{title}</h2>}
  <form class="form" data-form={form} action="/api/senden/" method="post">
    <noscript>
      <p class="form__noscript">
        Zum Absenden des Formulars wird JavaScript benötigt. Sie erreichen uns auch telefonisch unter
        <a href={site.contact.phoneHref}>{site.contact.phone}</a> oder per E-Mail an
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
      </p>
    </noscript>

    <slot />

    <!-- Spam-Schutz: für Menschen unsichtbar, Bots füllen es aus -->
    <div class="form__hp" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="form__footer">
      <label class="form__consent">
        <input type="checkbox" name="consent" required />
        <span class="form__consent-box" aria-hidden="true"><Icon name="check" size="0.9rem" /></span>
        <span>
          {consentText} Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>. <abbr title="Pflichtfeld">*</abbr>
        </span>
      </label>

      <div class="form__actions">
        <Button type="submit" variant="primary" size="lg" icon="send" class="form__submit">{submitLabel}</Button>
        <p class="form__required"><abbr title="Pflichtfeld">*</abbr> Pflichtfeld</p>
      </div>

      <p class="form__status" role="status" aria-live="polite" data-form-status></p>
    </div>
  </form>

  <div class="form-success" data-form-success tabindex="-1" hidden>
    <span class="form-success__icon" aria-hidden="true"><Icon name="check" size="1.75rem" /></span>
    <h2 class="form-success__title">{successTitle}</h2>
    <p class="form-success__text">{successText}</p>
    <Button href="/" variant="secondary" icon="arrow-right">Zur Startseite</Button>
  </div>
</div>

<script>
  import '@/scripts/forms.ts';
</script>

<style>
  .form-shell {
    padding: clamp(1rem, 0.7rem + 1vw, 1.4rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .form-shell__title {
    margin-bottom: var(--space-4);
    font-size: var(--text-2xl);
    text-align: center;
  }

  .form {
    display: grid;
    gap: var(--space-4);
  }

  .form__noscript {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }

  .form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__footer {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .form__consent {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .form__consent input {
    position: absolute;
    opacity: 0;
    width: 1.35rem;
    height: 1.35rem;
    margin: 0;
  }

  .form__consent-box {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.1rem;
    color: transparent;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: #ffffff;
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;
  }

  .form__consent input:checked + .form__consent-box {
    color: #ffffff;
    border-color: var(--blue-600);
    background: var(--blue-600);
  }

  .form__consent input:focus-visible + .form__consent-box {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .form__consent input:user-invalid + .form__consent-box {
    border-color: var(--color-danger);
  }

  .form__consent a {
    color: var(--color-link);
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }

  .form__required {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  abbr {
    text-decoration: none;
    color: var(--color-danger);
  }

  .form__status {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  .form__status:empty {
    display: none;
  }

  .form__status[data-state='error'] {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    color: var(--color-danger);
    background: var(--color-danger-soft);
  }

  .form__status[data-state='busy']::before {
    content: '';
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-right: 0.5em;
    vertical-align: -0.1em;
    border: 2px solid var(--blue-200);
    border-top-color: var(--blue-600);
    border-radius: 50%;
    animation: form-spin 800ms linear infinite;
  }

  @keyframes form-spin {
    to {
      rotate: 1turn;
    }
  }

  .form-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem) var(--space-4);
    text-align: center;
    outline: none;
  }

  .form-success[hidden] {
    display: none;
  }

  .form-success__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    color: var(--color-success);
    border-radius: 50%;
    background: var(--color-success-soft);
  }

  .form-success__title {
    font-size: var(--text-3xl);
  }

  .form-success__text {
    max-width: 32rem;
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
