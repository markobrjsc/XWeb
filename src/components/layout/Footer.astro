---
/**
 * Footer – Kurzprofil, Leistungen, Navigation, Kontakt und Rechtliches.
 */
import { legalNav, mainNav } from '@/config/navigation';
import { site } from '@/config/site';
import { pillars } from '@/data/services';
import Container from '@/components/ui/Container.astro';
import ContactList from '@/components/ui/ContactList.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import TechGrid from '@/components/ui/TechGrid.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';

const year = new Date().getFullYear();
const companyLinks = mainNav.filter((item) => item.href !== '/' && !item.href.includes('#'));
---

<footer class="site-footer" data-tone="dark">
  <TechGrid tone="light" class="site-footer__pattern" />
  <Container>
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo">
          <Logo size="lg" />
          <span class="visually-hidden"> – zur Startseite</span>
        </a>
        <p class="site-footer__claim">
          {site.claim}. Ihr Familienbetrieb für Gartenbau, Tiefbau und Straßenbau im Landkreis Konstanz.
        </p>
        <SocialLinks />
      </div>

      <nav class="site-footer__col" aria-labelledby="footer-leistungen">
        <h2 class="site-footer__heading" id="footer-leistungen">Leistungen</h2>
        <ul class="site-footer__links" role="list">
          {
            pillars.map((pillar) => (
              <li>
                <a href={`/#${pillar.id}`}>{pillar.title}</a>
                <ul class="site-footer__sublinks" role="list">
                  {pillar.services.map((service) => (
                    <li>
                      <a href={`/#leistung-${service.id}`}>{service.title}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__col" aria-labelledby="footer-unternehmen">
        <h2 class="site-footer__heading" id="footer-unternehmen">Unternehmen</h2>
        <ul class="site-footer__links" role="list">
          {
            companyLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li><a href="#kontakt">Kontakt</a></li>
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Kontakt</h2>
        <ContactList items={['phone', 'email', 'fax', 'address', 'hours']} size="sm" />
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">© {year} {site.name}</p>
      <ul class="site-footer__legal" role="list">
        {
          legalNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="site-footer__top-link" href="#top">
        Nach oben <Icon name="arrow-up" size="1em" />
      </a>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: calc(var(--footer-overlap) + clamp(3.5rem, 2.5rem + 3vw, 5rem));
    background: linear-gradient(180deg, var(--blue-950) 0%, #051224 100%);
  }

  .site-footer :global(.site-footer__pattern) {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: linear-gradient(to bottom, #000, transparent 70%);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-12) var(--space-8);
    padding-bottom: var(--space-16);
  }

  @media (min-width: 40rem) {
    .site-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .site-footer__top {
      grid-template-columns: 1.35fr 1fr 0.8fr 1.15fr;
    }
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .site-footer__logo {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__claim {
    max-width: 22rem;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .site-footer__heading {
    margin-bottom: var(--space-5);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--blue-200);
  }

  .site-footer__links,
  .site-footer__sublinks {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
  }

  .site-footer__sublinks {
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border);
  }

  .site-footer__links a {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: #ffffff;
    text-decoration: none;
  }

  .site-footer__sublinks a {
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: var(--color-text);
  }

  .site-footer__links a:hover {
    color: var(--blue-200);
    text-decoration: underline;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }

  .site-footer__legal {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
  }

  .site-footer__legal a,
  .site-footer__top-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .site-footer__legal a:hover,
  .site-footer__top-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .site-footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    font-weight: var(--weight-semibold);
  }
</style>
