---
/**
 * Footer – Kurzprofil, Fachbereiche, Navigation, Kontakt und Rechtliches.
 * Bewusst kompakt (ca. 35–45 % der Bildschirmhöhe): Einzelleistungen, Fax und Bürozeiten stehen auf den Unterseiten.
 */
import { legalNav, mainNav } from '@/config/navigation';
import { site } from '@/config/site';
import { pillars } from '@/data/services';
import Container from '@/components/ui/Container.astro';
import CopyButton from '@/components/ui/CopyButton.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';

const year = new Date().getFullYear();
const { address } = site;
const fullAddress = `${address.street}, ${address.postalCode} ${address.city}`;
// Apple-Geräte öffnen die Adresse in Apple Karten (Umschaltung im Skript unten), alle anderen in Google Maps
const appleMapsUrl = `https://maps.apple.com/?q=${encodeURIComponent(fullAddress)}`;
const companyLinks = mainNav.filter((item) => item.href !== '/' && !item.href.includes('#'));
---

<footer class="site-footer" data-tone="dark">
  <Container>
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo">
          <Logo />
          <span class="visually-hidden"> – zur Startseite</span>
        </a>
        <p class="site-footer__claim">Ihr Familienbetrieb für Garten-, Tief- und Straßenbau im Landkreis Konstanz.</p>
      </div>

      <nav class="site-footer__col site-footer__col--nav" aria-labelledby="footer-leistungen">
        <h2 class="site-footer__heading" id="footer-leistungen">Leistungen</h2>
        <ul class="site-footer__links" role="list">
          {
            pillars.map((pillar) => (
              <li>
                <a href={`/leistungen/#${pillar.id}`}>{pillar.title}</a>
                <span class="site-footer__sub">{pillar.subtitle}</span>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="site-footer__col site-footer__col--nav" aria-labelledby="footer-unternehmen">
        <h2 class="site-footer__heading" id="footer-unternehmen">Unternehmen</h2>
        <ul class="site-footer__links" role="list">
          {
            companyLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
      </nav>

      <div class="site-footer__col site-footer__col--contact">
        <h2 class="site-footer__heading">Kontakt</h2>
        <ul class="site-footer__contact" role="list">
          <li>
            <Icon name="phone" size="1em" />
            <a href={site.contact.phoneHref}>{site.contact.phone}</a>
            <CopyButton value={site.contact.phone} label="Telefonnummer" />
          </li>
          <li>
            <Icon name="mail" size="1em" />
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
            <CopyButton value={site.contact.email} label="E-Mail-Adresse" />
          </li>
          <li>
            <Icon name="map-pin" size="1em" />
            <a href={site.mapsUrl} data-apple-maps={appleMapsUrl} target="_blank" rel="noopener noreferrer">
              {address.street}, {address.postalCode} {address.city.replace(' am Bodensee', '')}-{address.district}
              <span class="visually-hidden"> (Karte öffnet in neuem Tab)</span>
            </a>
            <CopyButton value={fullAddress} label="Adresse" />
          </li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">© {year} {site.name}</p>
      <ul class="site-footer__legal" role="list">
        {
          legalNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <SocialLinks class="site-footer__social" />
      <a class="site-footer__top-link" href="#top" data-scroll-top>
        <span class="site-footer__top-text">Nach oben</span> <Icon name="arrow-up" size="1em" />
      </a>
    </div>
  </Container>
</footer>

<script>
  // Auf iPhone, iPad und Mac die Adresse in Apple Karten öffnen
  if (/iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent)) {
    document.querySelectorAll<HTMLAnchorElement>('a[data-apple-maps]').forEach((link) => {
      link.href = link.dataset.appleMaps ?? link.href;
    });
  }
</script>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(1.75rem, 1.25rem + 1.25vw, 2.25rem);
    background: linear-gradient(180deg, var(--blue-950) 0%, color-mix(in srgb, var(--blue-950) 70%, #000) 100%);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-6);
    padding-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .site-footer__brand,
  .site-footer__col--contact {
    grid-column: 1 / -1;
  }

  /* Tablet: Marke oben, darunter drei Spalten */
  @media (min-width: 40rem) {
    .site-footer__top {
      grid-template-columns: 1fr 0.8fr 1.3fr;
    }

    .site-footer__col--contact {
      grid-column: auto;
    }

    .site-footer__brand {
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
    }
  }

  /*
   * Handy: nur Logo, Kontakt und Rechtliches, damit der Footer flach bleibt –
   * die Seiten-Navigation steckt dort ohnehin im Menü des Headers.
   */
  @media (max-width: 39.99rem) {
    .site-footer__claim,
    .site-footer__col--nav {
      display: none;
    }

    /* nur optisch ausgeblendet – bleibt Name des Links für Screenreader */
    .site-footer__top-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .site-footer__copy {
      flex-basis: 100%;
    }

    .site-footer__bottom {
      gap: var(--space-2) var(--space-5);
    }
  }

  @media (min-width: 64rem) {
    .site-footer__brand {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .site-footer__top {
      grid-template-columns: 1.3fr 1fr 0.8fr 1.2fr;
      gap: var(--space-8);
    }

    .site-footer__brand,
    .site-footer__col--contact {
      grid-column: auto;
    }
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .site-footer__logo {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__claim {
    max-width: 22rem;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .site-footer__heading {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--blue-200);
  }

  .site-footer__links {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  .site-footer__links li {
    display: flex;
    flex-direction: column;
  }

  .site-footer__links a {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: #ffffff;
    text-decoration: none;
  }

  .site-footer__sub {
    font-size: var(--text-2xs);
    color: var(--color-text-subtle);
  }

  .site-footer__links a:hover {
    color: var(--blue-200);
    text-decoration: underline;
  }

  .site-footer__contact {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .site-footer__contact li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .site-footer__contact > li > :global(.icon) {
    flex: none;
    color: var(--blue-200);
  }

  .site-footer__contact a {
    overflow-wrap: anywhere;
    color: #ffffff;
    text-decoration: none;
  }

  .site-footer__contact a:hover {
    color: var(--blue-200);
    text-decoration: underline;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }

  .site-footer__legal {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
  }

  .site-footer__legal a,
  .site-footer__top-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .site-footer__legal a:hover,
  .site-footer__top-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .site-footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-semibold);
  }

  .site-footer__bottom :global(.site-footer__social) {
    margin-left: auto;
  }

  .site-footer__bottom :global(.site-footer__social .social__link) {
    width: 1.9rem;
    height: 1.9rem;
  }
</style>
