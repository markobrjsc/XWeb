---
/**
 * Header mit Hauptnavigation.
 * – Schwebende, runde Leiste auf allen Seiten: dunkel-milchig mit dünnem weißem Rand, links das Logo im hellen Label,
 *   aktiver Menüpunkt im weißen Label, rechts Instagram, Telefonnummer und Kontakt.
 * – Bleibt bei Seitenwechseln stehen, während der Inhalt seitlich hinein- bzw. hinausgleitet.
 * – Unterhalb von 1100 px Breite: Menü-Button, der ein Vollbild-Menü aus- und einklappt.
 * Menüpunkte kommen aus src/config/navigation.ts, das Verhalten aus src/scripts/site.ts.
 */
import { contactNavItem, mainNav, navOrder } from '@/config/navigation';
import { site } from '@/config/site';
import Button from '@/components/ui/Button.astro';
import ContactList from '@/components/ui/ContactList.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
const hasActiveNav = mainNav.some((item) => isCurrent(item.href));
---

<header class="site-header" id="top" data-site-header data-scrolled="false" data-menu-open="false">
  <div class="site-header__bar">
    <div class="site-header__inner">
      <a class="site-header__brand" href="/">
        <Logo eager />
        <span class="visually-hidden"> – zur Startseite</span>
      </a>

      <nav class="site-nav" aria-label="Hauptnavigation">
        <ul class="site-nav__list" role="list">
          {
            mainNav.map((item) => (
              <li>
                <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        {/* Weißes Label des aktiven Menüpunkts – eigenes Element, damit es beim Seitenwechsel hinübergleiten kann */}
        {hasActiveNav && <span class="site-nav__indicator" aria-hidden="true"></span>}
      </nav>

      <div class="site-header__actions">
        <a class="site-header__social" href={site.social.instagram} target="_blank" rel="noopener noreferrer">
          <Icon name="instagram" size="1.05rem" />
          <span class="visually-hidden">Instagram (öffnet in neuem Tab)</span>
        </a>
        <a class="site-header__phone" href={site.contact.phoneHref}>
          <span class="site-header__phone-icon" aria-hidden="true"><Icon name="phone" size="1em" /></span>
          <span class="site-header__phone-number">{site.contact.phone}</span>
          <span class="visually-hidden site-header__phone-sr">Anrufen: {site.contact.phone}</span>
        </a>
        <Button
          href={contactNavItem.href}
          variant="primary"
          size="sm"
          class="site-header__cta"
          aria-current={isCurrent(contactNavItem.href) ? 'page' : undefined}
        >
          {contactNavItem.label}
        </Button>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="menu-toggle__text" data-menu-label data-open="Menü" data-close="Schließen">Menü</span>
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu data-tone="dark">
    <div class="mobile-menu__inner">
      <nav aria-label="Mobile Navigation">
        <ul class="mobile-menu__list" role="list">
          {
            navOrder.map((item, index) => (
              <li class="mobile-menu__item">
                <a class="mobile-menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="mobile-menu__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="mobile-menu__text">
                    <span class="mobile-menu__label">{item.label}</span>
                    {item.description && <span class="mobile-menu__desc">{item.description}</span>}
                  </span>
                  <Icon name="arrow-right" class="mobile-menu__arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mobile-menu__footer">
        <ContactList items={['phone', 'email', 'hours']} size="sm" />
        <a class="mobile-menu__social" href={site.social.instagram} target="_blank" rel="noopener noreferrer">
          <Icon name="instagram" size="1.1rem" /> Instagram
        </a>
        <Button href={contactNavItem.href} variant="light" block icon="arrow-right">Projekt anfragen</Button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    /* Schwebende, runde Leiste – dunkel und milchig, mit dünnem weißen Rand (wie die Plakette am Seitenende) */
    --header-fg: #ffffff;
    --header-fg-muted: rgb(255 255 255 / 0.72);
    --header-bg: rgb(var(--glass-dark));
    --header-border: rgb(255 255 255 / 0.55);
    --header-accent: var(--color-accent);
    --header-h: var(--header-height);
    /* Innenabstand der Leiste – oben, unten, links und rechts gleich groß */
    --header-pad: 0.8rem;
    --header-item-h: 2.95rem;
    --header-bar-h: calc(var(--header-item-h) + var(--header-pad) * 2);
    --header-morph: 600ms var(--ease-in-out);
    --color-heading: var(--header-fg);
    --color-text-muted: var(--header-fg-muted);
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    padding: clamp(0.5rem, 0.3rem + 0.8vw, 0.9rem) clamp(0.5rem, 0.2rem + 0.8vw, 1rem) 0;
    pointer-events: none;
    transition: padding var(--header-morph);
    /* Eigene Ebene im Seitenübergang: Der Header gleitet nicht mit */
    view-transition-name: site-header;
  }

  .site-header[data-menu-open='true'] {
    --header-bg: var(--blue-900);
    --header-border: rgb(255 255 255 / 0.25);
  }

  .site-header__bar {
    position: relative;
    z-index: 2;
    pointer-events: auto;
    max-width: 120rem;
    margin-inline: auto;
    border: 1px solid var(--header-border);
    /* Genau halbe Höhe statt 999px – so lässt sich die Rundung weich auf 0 animieren */
    border-radius: calc(var(--header-bar-h) / 2 + 1px);
    background: var(--header-bg);
    box-shadow: 0 14px 34px -20px rgb(var(--ink) / 0.6);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
    transition:
      max-width var(--header-morph),
      border-radius var(--header-morph),
      border-color var(--header-morph),
      background-color var(--header-morph),
      box-shadow var(--header-morph);
  }

  /* Nach dem Scrollen: Die runde Leiste wird zur durchgehenden, soliden Leiste am oberen Rand */
  .site-header[data-scrolled='true'] {
    padding: 0;
  }

  .site-header[data-scrolled='true'] .site-header__bar {
    max-width: 100%;
    border-color: transparent transparent rgb(255 255 255 / 0.12);
    border-radius: 0;
    background: var(--blue-950);
    box-shadow: 0 10px 30px -16px rgb(var(--ink) / 0.55);
  }

  .site-header[data-scrolled='true'][data-menu-open='true'] .site-header__bar {
    background: var(--blue-900);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    height: var(--header-bar-h);
    /* Höhe = Elementhöhe + Innenabstand oben und unten */
    padding-inline: var(--header-pad);
    transition: padding var(--header-morph);
  }

  .site-header[data-scrolled='true'] .site-header__inner {
    padding-inline: clamp(0.8rem, 0.2rem + 1.6vw, 1.75rem);
  }

  /* Logo mit Schriftzug in einem hellen, runden Label */
  .site-header__brand {
    --color-heading: var(--blue-950);
    --color-text-muted: var(--gray-600);
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    height: var(--header-item-h);
    padding: 0 1.1rem 0 0.75rem;
    color: var(--blue-950);
    text-decoration: none;
    border-radius: 999px;
    background: #ffffff;
    transition: background-color var(--duration-base) ease;
  }

  .site-header__brand:hover {
    background: var(--gray-100);
  }

  /* Maskottchen mit Schriftzug im hellen, runden Label (ohne Akzentfarbe) */
  .site-header__brand :global(.logo) {
    --logo-height: calc(var(--header-item-h) - 0.75rem);
    gap: 0.6rem;
  }

  .site-header__brand :global(.logo__text) {
    padding-left: 0.6rem;
  }

  .site-header__brand :global(.logo__name) {
    font-size: 1.05rem;
  }

  .site-header__brand :global(.logo__sub) {
    font-size: 0.56rem;
  }

  /* Desktop-Navigation: Menüpunkte nebeneinander, aktiver Punkt im weißen Label */
  .site-nav {
    position: relative;
    display: none;
    margin-inline: auto;
  }

  .site-nav__list {
    position: relative;
    z-index: 1;
    /* Beschriftungen liegen im Seitenübergang über dem gleitenden Label */
    view-transition-name: site-nav-labels;
    display: flex;
    align-items: center;
    gap: clamp(0.1rem, 0.5vw, 0.4rem);
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--header-fg);
    text-decoration: none;
    border-radius: 999px;
    transition: background-color var(--duration-base) ease;
  }

  /* Während eines Seitenübergangs alle Menütexte weiß – siehe „site-nav-labels“ in global.css */
  :global(html:active-view-transition) .site-nav__link {
    color: #ffffff;
  }

  .site-nav__link:hover {
    color: var(--header-fg);
    background: rgb(255 255 255 / 0.14);
  }

  .site-nav__link[aria-current='page'] {
    font-weight: var(--weight-bold);
    color: var(--blue-950);
    background: #ffffff;
  }

  .site-nav__indicator {
    display: none;
  }

  /*
   * Mit Anker-Positionierung sitzt das weiße Label als eigenes Element unter dem aktiven Menüpunkt.
   * Beim Seitenwechsel gleitet es dadurch vom alten zum neuen Punkt (Animation: global.css).
   * Ohne Unterstützung trägt der aktive Link das Label einfach selbst.
   */
  @supports (anchor-name: --a) {
    .site-nav__link[aria-current='page'] {
      anchor-name: --site-nav-active;
    }

    .site-nav__link[aria-current='page'],
    .site-nav__link[aria-current='page']:hover {
      background: transparent;
    }

    .site-nav__indicator {
      position: absolute;
      z-index: 0;
      display: block;
      position-anchor: --site-nav-active;
      top: anchor(top);
      right: anchor(right);
      bottom: anchor(bottom);
      left: anchor(left);
      border-radius: 999px;
      background: #ffffff;
      view-transition-name: site-nav-indicator;
    }
  }

  /* Aktionen rechts */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }

  /* Instagram – runder Rahmen wie das Telefon-Symbol, als Gruppe dicht daneben */
  .site-header__social {
    margin-right: calc(var(--space-2) - var(--space-4));
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    color: var(--header-fg);
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--header-fg) 30%, transparent);
    transition:
      color var(--duration-base) ease,
      box-shadow var(--duration-base) ease;
  }

  .site-header__social:hover {
    color: var(--header-accent);
    box-shadow: inset 0 0 0 1px var(--header-accent);
  }

  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--header-fg);
    text-decoration: none;
    border-radius: 999px;
  }

  .site-header__phone:hover {
    color: var(--header-fg);
  }

  .site-header__phone:hover .site-header__phone-number {
    text-decoration: underline;
  }

  .site-header__phone-icon {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    font-size: 1.05rem;
    border-radius: 50%;
    color: var(--header-fg);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--header-fg) 30%, transparent);
  }

  .site-header__phone-number {
    display: none;
    letter-spacing: 0.01em;
  }

  /* Kontakt-Button */
  .site-header :global(.site-header__cta) {
    display: none;
  }

  .site-header :global(.site-header__cta.btn) {
    min-height: var(--header-item-h);
    border-radius: 999px;
  }

  .site-header :global(.site-header__cta[aria-current='page']) {
    --btn-bg: #ffffff;
    --btn-fg: var(--blue-950);
    --btn-border: #ffffff;
  }

  .site-header[data-menu-open='true'] :global(.site-header__cta.btn) {
    --btn-bg: #ffffff;
    --btn-fg: var(--blue-950);
    --btn-border: #ffffff;
    --btn-bg-hover: var(--blue-100);
    --btn-fg-hover: var(--blue-950);
    --btn-border-hover: var(--blue-100);
  }

  /* Menü-Button (Hamburger ↔ X) */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 2.6rem;
    padding: 0 0.9rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--header-fg);
    background: transparent;
    border: 1.5px solid color-mix(in srgb, var(--header-fg) 40%, transparent);
    border-radius: 999px;
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;
  }

  .menu-toggle:hover {
    border-color: var(--header-fg);
  }

  .menu-toggle__icon {
    position: relative;
    display: block;
    width: 1.15rem;
    height: 0.8rem;
  }

  .menu-toggle__icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform var(--duration-slow) var(--ease-out),
      opacity var(--duration-base) ease,
      top var(--duration-slow) var(--ease-out);
  }

  .menu-toggle__icon span:nth-child(1) {
    top: 0;
  }
  .menu-toggle__icon span:nth-child(2) {
    top: calc(50% - 1px);
  }
  .menu-toggle__icon span:nth-child(3) {
    top: calc(100% - 2px);
  }

  [data-menu-open='true'] .menu-toggle__icon span:nth-child(1) {
    top: calc(50% - 1px);
    transform: rotate(45deg);
  }
  [data-menu-open='true'] .menu-toggle__icon span:nth-child(2) {
    opacity: 0;
  }
  [data-menu-open='true'] .menu-toggle__icon span:nth-child(3) {
    top: calc(50% - 1px);
    transform: rotate(-45deg);
  }

  /* Mobiles Menü (ausklappbar) */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding-top: var(--header-h);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--blue-950);
    visibility: hidden;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 500ms var(--ease-out),
      opacity var(--duration-base) ease,
      visibility 0s linear 500ms;
  }

  [data-menu-open='true'] .mobile-menu {
    visibility: visible;
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 500ms var(--ease-out),
      opacity var(--duration-base) ease,
      visibility 0s;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    flex: 1;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-6) var(--gutter) max(var(--space-8), env(safe-area-inset-bottom));
  }

  .mobile-menu__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .mobile-menu__item {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 350ms var(--ease-out),
      translate 450ms var(--ease-out);
  }

  [data-menu-open='true'] .mobile-menu__item {
    opacity: 1;
    translate: 0 0;
  }

  [data-menu-open='true'] .mobile-menu__item:nth-child(1) {
    transition-delay: 60ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(2) {
    transition-delay: 100ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(3) {
    transition-delay: 140ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(4) {
    transition-delay: 180ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(5) {
    transition-delay: 220ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(6) {
    transition-delay: 260ms;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-1);
    color: #ffffff;
    text-decoration: none;
  }

  .mobile-menu__index {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--blue-300);
    font-variant-numeric: tabular-nums;
  }

  .mobile-menu__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
  }

  .mobile-menu__label {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
  }

  .mobile-menu__desc {
    font-size: var(--text-xs);
    color: rgb(255 255 255 / 0.6);
  }

  .mobile-menu :global(.mobile-menu__arrow) {
    color: rgb(255 255 255 / 0.4);
    transition:
      transform var(--duration-base) var(--ease-out),
      color var(--duration-base) ease;
  }

  .mobile-menu__link:hover :global(.mobile-menu__arrow),
  .mobile-menu__link[aria-current='page'] :global(.mobile-menu__arrow) {
    color: var(--blue-300);
    transform: translateX(3px);
  }

  .mobile-menu__link[aria-current='page'] .mobile-menu__label {
    color: var(--blue-200);
  }

  .mobile-menu__social {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: #ffffff;
    text-decoration: none;
  }

  .mobile-menu__social :global(.icon) {
    color: var(--color-accent);
  }

  .mobile-menu__footer {
    display: grid;
    gap: var(--space-6);
    margin-top: auto;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    opacity: 0;
    transition: opacity 400ms var(--ease-out) 0s;
  }

  [data-menu-open='true'] .mobile-menu__footer {
    opacity: 1;
    transition-delay: 300ms;
  }

  /* Tablet: Kontakt-Button zeigen */
  @media (min-width: 40rem) {
    .site-header :global(.site-header__cta) {
      display: inline-flex;
    }
  }

  /* Desktop: volle Navigation, kein Menü-Button */
  @media (min-width: 68.75rem) {
    /* Drei Spalten: Logo links, Reiter exakt mittig, Aktionen rechts – unabhängig von deren Breite */
    .site-header__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }

    .site-header__brand {
      justify-self: start;
    }

    .site-nav {
      display: block;
      margin-inline: 0;
    }

    .site-header__actions {
      justify-self: end;
      margin-left: 0;
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }

  @media (min-width: 82rem) {
    .site-header__phone-number {
      display: inline;
    }

    .site-header__phone-sr {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .site-header__inner {
      gap: var(--space-3);
    }

    .site-header__actions {
      gap: var(--space-2);
    }

    .site-header__brand :global(.logo__sub) {
      display: none;
    }

    /* Beschriftung nur visuell ausblenden – für Screenreader bleibt der Button benannt */
    .menu-toggle__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .menu-toggle {
      position: relative;
      padding: 0 0.7rem;
    }
  }

  @media (max-width: 22.5rem) {
    .site-header__brand :global(.logo) {
      gap: 0.5rem;
    }

    .site-header__brand :global(.logo__text) {
      padding-left: 0.5rem;
    }

    .site-header__brand :global(.logo__name) {
      font-size: 1rem;
      letter-spacing: 0.04em;
    }

    .site-header__phone-icon {
      width: 2.25rem;
      height: 2.25rem;
    }

    .menu-toggle {
      height: 2.35rem;
      padding: 0 0.6rem;
    }
  }
</style>
