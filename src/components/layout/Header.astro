---
/**
 * Header mit Hauptnavigation.
 * – Über dem dunklen Seitenkopf transparent, beim Scrollen kompakt und weiß („eingeklappt“).
 * – Unterhalb von 1100 px Breite: Menü-Button, der ein Vollbild-Menü aus- und einklappt.
 * Menüpunkte kommen aus src/config/navigation.ts, das Verhalten aus src/scripts/site.ts.
 */
import { contactNavItem, mainNav } from '@/config/navigation';
import { site } from '@/config/site';
import Button from '@/components/ui/Button.astro';
import ContactList from '@/components/ui/ContactList.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import TechGrid from '@/components/ui/TechGrid.astro';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="site-header" id="top" data-site-header data-scrolled="false" data-menu-open="false">
  <div class="site-header__bar">
    <div class="site-header__inner">
      <a class="site-header__brand" href="/">
        <Logo eager />
        <span class="visually-hidden"> – zur Startseite</span>
      </a>

      <nav class="site-nav" aria-label="Hauptnavigation">
        <ul class="site-nav__list" role="list">
          {
            mainNav.map((item) => (
              <li>
                <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-header__actions">
        <a class="site-header__phone" href={site.contact.phoneHref}>
          <span class="site-header__phone-icon" aria-hidden="true"><Icon name="phone" size="1em" /></span>
          <span class="site-header__phone-number">{site.contact.phone}</span>
          <span class="visually-hidden site-header__phone-sr">Anrufen: {site.contact.phone}</span>
        </a>
        <Button href={contactNavItem.href} variant="light" size="sm" class="site-header__cta">
          {contactNavItem.label}
        </Button>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="menu-toggle__text" data-menu-label data-open="Menü" data-close="Schließen">Menü</span>
        </button>
      </div>
    </div>
    <span class="site-header__progress" aria-hidden="true"></span>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu data-tone="dark">
    <TechGrid tone="light" class="mobile-menu__pattern" />
    <div class="mobile-menu__inner">
      <nav aria-label="Mobile Navigation">
        <ul class="mobile-menu__list" role="list">
          {
            mainNav.map((item, index) => (
              <li class="mobile-menu__item">
                <a class="mobile-menu__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="mobile-menu__index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="mobile-menu__text">
                    <span class="mobile-menu__label">{item.label}</span>
                    {item.description && <span class="mobile-menu__desc">{item.description}</span>}
                  </span>
                  <Icon name="arrow-right" class="mobile-menu__arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mobile-menu__footer">
        <ContactList items={['phone', 'email', 'hours']} size="sm" />
        <Button href={contactNavItem.href} variant="light" block icon="arrow-right">Projekt anfragen</Button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    /* Farben im Zustand „oben“ (transparent über dem dunklen Seitenkopf) */
    --header-fg: #ffffff;
    --header-fg-muted: rgb(255 255 255 / 0.7);
    --header-bg: transparent;
    --header-border: rgb(255 255 255 / 0.08);
    --header-shadow: none;
    --header-accent: var(--blue-300);
    --header-h: var(--header-height);
    --color-heading: var(--header-fg);
    --color-text-muted: var(--header-fg-muted);
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
  }

  .site-header[data-scrolled='true'] {
    --header-fg: var(--blue-950);
    --header-fg-muted: var(--gray-600);
    --header-bg: rgb(255 255 255 / 0.94);
    --header-border: var(--gray-200);
    --header-shadow: 0 8px 24px -16px rgb(7 23 44 / 0.25);
    --header-accent: var(--blue-600);
    --header-h: var(--header-height-compact);
  }

  .site-header[data-menu-open='true'] {
    --header-fg: #ffffff;
    --header-fg-muted: rgb(255 255 255 / 0.7);
    --header-bg: var(--blue-950);
    --header-border: rgb(255 255 255 / 0.08);
    --header-shadow: none;
    --header-accent: var(--blue-300);
  }

  .site-header__bar {
    position: relative;
    z-index: 2;
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-border);
    box-shadow: var(--header-shadow);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    transition:
      background-color var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out),
      border-color var(--duration-slow) var(--ease-out);
  }

  .site-header[data-scrolled='false']:not([data-menu-open='true']) .site-header__bar {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Lesefortschritt als feine Linie unter dem Header */
  .site-header__progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--blue-500);
    transform: scaleX(var(--page-progress, 0));
    transform-origin: left center;
    opacity: 0;
    transition: opacity var(--duration-base) ease;
  }

  .site-header[data-scrolled='true']:not([data-menu-open='true']) .site-header__progress {
    opacity: 1;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--header-h);
    max-width: calc(var(--container-wide) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
    transition: height var(--duration-slow) var(--ease-out);
  }

  /* Logo */
  .site-header__brand {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--header-fg);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .site-header[data-scrolled='true']:not([data-menu-open='true']) .site-header__brand :global(.logo) {
    --logo-height: 2.6rem;
  }

  /* Desktop-Navigation */
  .site-nav {
    display: none;
    margin-inline: auto;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 0.8vw, 0.65rem);
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--header-fg);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--duration-base) ease;
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 2px;
    background: var(--header-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .site-nav__link:hover {
    color: var(--header-fg);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav__link[aria-current='page'] {
    font-weight: var(--weight-semibold);
  }

  /* Aktionen rechts */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }

  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--header-fg);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .site-header__phone:hover {
    color: var(--header-fg);
  }

  .site-header__phone:hover .site-header__phone-number {
    text-decoration: underline;
  }

  .site-header__phone-icon {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    font-size: 1.05rem;
    border-radius: var(--radius-sm);
    color: var(--header-fg);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--header-fg) 30%, transparent);
  }

  .site-header__phone-number {
    display: none;
    letter-spacing: 0.01em;
  }

  /* Kontakt-Button: weiß über dem Seitenkopf, blau im kompakten Zustand */
  .site-header :global(.site-header__cta) {
    display: none;
  }

  .site-header[data-scrolled='true']:not([data-menu-open='true']) :global(.site-header__cta.btn) {
    --btn-bg: var(--blue-600);
    --btn-fg: #ffffff;
    --btn-border: var(--blue-600);
    --btn-bg-hover: var(--blue-700);
    --btn-fg-hover: #ffffff;
    --btn-border-hover: var(--blue-700);
  }

  /* Menü-Button (Hamburger ↔ X) */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 2.6rem;
    padding: 0 0.9rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--header-fg);
    background: transparent;
    border: 1.5px solid color-mix(in srgb, var(--header-fg) 40%, transparent);
    border-radius: var(--radius-button);
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease;
  }

  .menu-toggle:hover {
    border-color: var(--header-fg);
  }

  .menu-toggle__icon {
    position: relative;
    display: block;
    width: 1.15rem;
    height: 0.8rem;
  }

  .menu-toggle__icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform var(--duration-slow) var(--ease-out),
      opacity var(--duration-base) ease,
      top var(--duration-slow) var(--ease-out);
  }

  .menu-toggle__icon span:nth-child(1) {
    top: 0;
  }
  .menu-toggle__icon span:nth-child(2) {
    top: calc(50% - 1px);
  }
  .menu-toggle__icon span:nth-child(3) {
    top: calc(100% - 2px);
  }

  [data-menu-open='true'] .menu-toggle__icon span:nth-child(1) {
    top: calc(50% - 1px);
    transform: rotate(45deg);
  }
  [data-menu-open='true'] .menu-toggle__icon span:nth-child(2) {
    opacity: 0;
  }
  [data-menu-open='true'] .menu-toggle__icon span:nth-child(3) {
    top: calc(50% - 1px);
    transform: rotate(-45deg);
  }

  /* Mobiles Menü (ausklappbar) */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding-top: var(--header-h);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--blue-950);
    visibility: hidden;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition:
      clip-path 500ms var(--ease-out),
      opacity var(--duration-base) ease,
      visibility 0s linear 500ms;
  }

  [data-menu-open='true'] .mobile-menu {
    visibility: visible;
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 500ms var(--ease-out),
      opacity var(--duration-base) ease,
      visibility 0s;
  }

  .mobile-menu :global(.mobile-menu__pattern) {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: linear-gradient(to bottom, transparent, #000 50%);
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    flex: 1;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-6) var(--gutter) max(var(--space-8), env(safe-area-inset-bottom));
  }

  .mobile-menu__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .mobile-menu__item {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 350ms var(--ease-out),
      translate 450ms var(--ease-out);
  }

  [data-menu-open='true'] .mobile-menu__item {
    opacity: 1;
    translate: 0 0;
  }

  [data-menu-open='true'] .mobile-menu__item:nth-child(1) {
    transition-delay: 60ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(2) {
    transition-delay: 100ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(3) {
    transition-delay: 140ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(4) {
    transition-delay: 180ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(5) {
    transition-delay: 220ms;
  }
  [data-menu-open='true'] .mobile-menu__item:nth-child(6) {
    transition-delay: 260ms;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-1);
    color: #ffffff;
    text-decoration: none;
  }

  .mobile-menu__index {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--blue-300);
    font-variant-numeric: tabular-nums;
  }

  .mobile-menu__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
  }

  .mobile-menu__label {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
  }

  .mobile-menu__desc {
    font-size: var(--text-xs);
    color: rgb(255 255 255 / 0.6);
  }

  .mobile-menu :global(.mobile-menu__arrow) {
    color: rgb(255 255 255 / 0.4);
    transition:
      transform var(--duration-base) var(--ease-out),
      color var(--duration-base) ease;
  }

  .mobile-menu__link:hover :global(.mobile-menu__arrow),
  .mobile-menu__link[aria-current='page'] :global(.mobile-menu__arrow) {
    color: var(--blue-300);
    transform: translateX(3px);
  }

  .mobile-menu__link[aria-current='page'] .mobile-menu__label {
    color: var(--blue-200);
  }

  .mobile-menu__footer {
    display: grid;
    gap: var(--space-6);
    margin-top: auto;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    opacity: 0;
    transition: opacity 400ms var(--ease-out) 0s;
  }

  [data-menu-open='true'] .mobile-menu__footer {
    opacity: 1;
    transition-delay: 300ms;
  }

  /* Tablet: Kontakt-Button zeigen */
  @media (min-width: 40rem) {
    .site-header :global(.site-header__cta) {
      display: inline-flex;
    }
  }

  /* Desktop: volle Navigation, kein Menü-Button */
  @media (min-width: 68.75rem) {
    .site-nav {
      display: block;
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }

  @media (min-width: 82rem) {
    .site-header__phone-number {
      display: inline;
    }

    .site-header__phone-sr {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .site-header__inner {
      gap: var(--space-3);
    }

    .site-header__actions {
      gap: var(--space-2);
    }

    .site-header__brand :global(.logo__sub) {
      display: none;
    }

    /* Beschriftung nur visuell ausblenden – für Screenreader bleibt der Button benannt */
    .menu-toggle__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .menu-toggle {
      position: relative;
      padding: 0 0.7rem;
    }
  }

  @media (max-width: 22.5rem) {
    .site-header__brand :global(.logo) {
      --logo-height: 2.5rem;
      gap: 0.5rem;
    }

    .site-header__brand :global(.logo__text) {
      padding-left: 0.5rem;
    }

    .site-header__brand :global(.logo__name) {
      font-size: 1rem;
      letter-spacing: 0.04em;
    }

    .site-header__phone-icon {
      width: 2.25rem;
      height: 2.25rem;
    }

    .menu-toggle {
      height: 2.35rem;
      padding: 0 0.6rem;
    }
  }
</style>
