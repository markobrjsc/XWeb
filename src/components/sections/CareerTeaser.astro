---
/**
 * CareerTeaser – Stellenangebote auf der Startseite: Vorteile + aktuelle Stellen.
 */
import { getCollection } from 'astro:content';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';
import TechGrid from '@/components/ui/TechGrid.astro';
import { site } from '@/config/site';
import { benefits } from '@/data/company';

interface Props {
  /** Abstand nach oben: "none", wenn direkt davor ein heller Abschnitt mit eigenem Innenabstand steht */
  space?: 'top' | 'none';
}

const { space = 'top' } = Astro.props;

const jobs = (await getCollection('stellenangebote'))
  .filter((job) => job.data.active)
  .sort((a, b) => a.data.order - b.data.order);

const highlights = benefits.slice(0, 6);
---

<section class:list={['career', `career--space-${space}`]} aria-labelledby="karriere-titel">
  <Container>
    <div class="career__card" data-reveal="fade">
      <TechGrid tone="dark" class="career__pattern" />

      <div class="career__intro">
        <Eyebrow>Stellenangebote</Eyebrow>
        <h2 class="career__title" id="karriere-titel">
          Werden Sie Teil <span class="accent">unseres Teams.</span>
        </h2>
        <p class="career__text">
          Wir suchen Menschen, die gerne draußen arbeiten und mit anpacken – mit Berufserfahrung, als Quereinsteiger
          oder als Auszubildende. Bei uns erwartet Sie ein Familienbetrieb mit echtem Zusammenhalt.
        </p>
        <ul class="career__benefits" role="list">
          {
            highlights.map((benefit) => (
              <li>
                <Icon name="check" size="1.05em" strokeWidth={2.5} />
                {benefit.title}
              </li>
            ))
          }
        </ul>
        <div class="career__actions">
          <Button href="/stellenangebote/" variant="primary" icon="arrow-right">Alle Stellenangebote</Button>
          <Button href={`mailto:${site.contact.email}?subject=Initiativbewerbung`} variant="secondary">
            Initiativ bewerben
          </Button>
        </div>
      </div>

      <div class="career__jobs">
        <p class="career__jobs-title">Aktuell gesucht</p>
        <ul class="career__list" role="list">
          {
            jobs.map((job) => (
              <li>
                <a class="career__job" href={`/stellenangebote/${job.id}/`}>
                  <span class="career__job-icon" aria-hidden="true">
                    <Icon name={job.data.icon} size="1.15em" strokeWidth={1.75} />
                  </span>
                  <span class="career__job-text">
                    <span class="career__job-title">{job.data.title}</span>
                    <span class="career__job-meta">
                      <Badge tone="soft" size="sm">{job.data.type}</Badge>
                      <span>{job.data.start}</span>
                    </span>
                  </span>
                  <Icon name="arrow-right" class="career__job-arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>

<style>
  .career {
    padding-top: var(--section-space);
  }

  .career--space-none {
    padding-top: 0;
  }

  .career__card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    padding: clamp(1.75rem, 1rem + 4vw, 4rem);
    overflow: hidden;
    border: 1px solid var(--blue-100);
    border-radius: var(--radius-2xl);
    background: linear-gradient(160deg, var(--blue-50), #ffffff 70%);
  }

  @media (min-width: 64rem) {
    .career__card {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
    }
  }

  .career__card :global(.career__pattern) {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: linear-gradient(200deg, #000 0%, transparent 55%);
  }

  .career__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .career__title {
    max-width: 18ch;
    font-size: var(--text-4xl);
    line-height: 1.1;
  }

  .career__text {
    max-width: 36rem;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .career__benefits {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-2) var(--space-6);
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .career__benefits li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-heading);
  }

  .career__benefits :global(.icon) {
    color: var(--blue-600);
  }

  .career__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .career__jobs {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .career__jobs-title {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .career__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  .career__job {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    color: var(--color-heading);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #ffffff;
    transition:
      border-color var(--duration-base) ease,
      box-shadow var(--duration-base) ease;
  }

  .career__job:hover {
    color: var(--color-heading);
    border-color: var(--blue-300);
    box-shadow: var(--shadow-sm);
  }

  .career__job-icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--blue-50);
    color: var(--blue-700);
    box-shadow: inset 0 0 0 1px var(--blue-100);
  }

  .career__job-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
    min-width: 0;
  }

  .career__job-title {
    font-weight: var(--weight-semibold);
    line-height: 1.3;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .career__job-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text);
  }

  .career__job :global(.career__job-arrow) {
    color: var(--blue-600);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .career__job:hover :global(.career__job-arrow) {
    transform: translateX(3px);
  }
</style>
