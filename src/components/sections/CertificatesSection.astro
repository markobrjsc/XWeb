---
/**
 * CertificatesSection – Zertifikate als anklickbare Vorschau (ca. 35 % der Bildschirmhöhe).
 * Klick: Die Vorschau zoomt in die Großansicht – geöffnet auf der Seite selbst (kein PDF im neuen Tab).
 *
 * Neues Zertifikat: PDF in src/assets/zertifikate/ legen, optional Titel/Aussteller/Jahr in
 * src/assets/zertifikate/zertifikate.json. Die Seitenbilder erzeugt scripts/build-zertifikate.mjs vor jedem Build.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';

type Certificate = {
  name: string;
  title: string;
  issuer: string;
  year: string;
  pdf: string;
  pages: { image: string; width: number; height: number }[];
};

const manifests = import.meta.glob<Certificate[]>('/src/assets/zertifikate/_seiten/manifest.json', { eager: true, import: 'default' });
const images = import.meta.glob<ImageMetadata>('/src/assets/zertifikate/_seiten/*.png', { eager: true, import: 'default' });
const imageFor = (file: string) => images[`/src/assets/zertifikate/_seiten/${file}`];

const certificates = await Promise.all(
  (Object.values(manifests)[0] ?? [])
    .filter((cert) => cert.pages.length && imageFor(cert.pages[0].image))
    .sort((a, b) => String(b.year).localeCompare(String(a.year)))
    .map(async (cert) => ({
      ...cert,
      thumb: await getImage({ src: imageFor(cert.pages[0].image), width: 520, format: 'webp', quality: 75 }),
      full: await Promise.all(
        cert.pages.map((page) => getImage({ src: imageFor(page.image), width: 1600, format: 'webp', quality: 82 })),
      ),
    })),
);
---

{
  certificates.length > 0 && (
    <Section id="zertifikate" labelledby="zertifikate-titel" class="certs">
      <SectionHeader
        align="center"
        id="zertifikate-titel"
        eyebrow="Qualifikation"
        title={'Geprüft und <span class="accent">zertifiziert.</span>'}
        lead="Regelmäßige Schulungen sorgen dafür, dass wir sicher und nach aktuellem Stand arbeiten. Zum Vergrößern anklicken."
      />

      <ul class="certs__list" role="list">
        {certificates.map((cert) => (
          <li class="certs__item">
            <button class="cert" type="button" data-cert={cert.name} aria-haspopup="dialog">
              <span class="cert__paper">
                <img
                  class="cert__img"
                  src={cert.thumb.src}
                  alt={`Zertifikat: ${cert.title}`}
                  width={cert.pages[0].width}
                  height={cert.pages[0].height}
                  loading="lazy"
                  decoding="async"
                />
                <span class="cert__zoom" aria-hidden="true">
                  <Icon name="zoom-in" size="1.1rem" />
                </span>
              </span>
              <span class="cert__caption">
                <span class="cert__title">{cert.title}</span>
                <span class="cert__meta">{[cert.issuer, cert.year].filter(Boolean).join(' · ')}</span>
              </span>
            </button>

            <template data-cert-template={cert.name}>
              <h2 class="cert-viewer__title">{cert.title}</h2>
              <p class="cert-viewer__meta">{[cert.issuer, cert.year].filter(Boolean).join(' · ')}</p>
              <div class="cert-viewer__pages">
                {cert.full.map((image, index) => (
                  <img
                    class="cert-viewer__page"
                    src={image.src}
                    alt={`${cert.title} – Seite ${index + 1}`}
                    width={cert.pages[index].width}
                    height={cert.pages[index].height}
                    decoding="async"
                  />
                ))}
              </div>
              <a class="cert-viewer__download" href={cert.pdf} download>
                PDF herunterladen
              </a>
            </template>
          </li>
        ))}
      </ul>

      <dialog class="cert-viewer" data-cert-viewer aria-label="Zertifikat">
        <div class="cert-viewer__inner" data-cert-body></div>
        <button class="cert-viewer__close" type="button" aria-label="Schließen" data-cert-close>
          <Icon name="x" size="1.2rem" />
        </button>
      </dialog>
    </Section>
  )
}

<script>
  // Großansicht: Zoom von der Vorschau-Position in den Dialog (FLIP-Animation) – und beim Schließen zurück
  const viewer = document.querySelector<HTMLDialogElement>('[data-cert-viewer]');
  const body = viewer?.querySelector<HTMLElement>('[data-cert-body]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let origin: HTMLElement | null = null;
  let closing = false;

  const zoom = (from: DOMRect, to: HTMLElement, reverse = false) => {
    const target = to.getBoundingClientRect();
    if (!target.width || reduced.matches) return Promise.resolve();
    const dx = from.left + from.width / 2 - (target.left + target.width / 2);
    const dy = from.top + from.height / 2 - (target.top + target.height / 2);
    const scale = from.width / target.width;
    const frames = [
      { transform: `translate(${dx}px, ${dy}px) scale(${scale})`, borderRadius: '6px' },
      { transform: 'none', borderRadius: '10px' },
    ];
    return to
      .animate(reverse ? frames.reverse() : frames, { duration: 420, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', fill: 'both' })
      .finished.catch(() => undefined);
  };

  const open = async (button: HTMLElement) => {
    const template = document.querySelector<HTMLTemplateElement>(`[data-cert-template="${button.dataset.cert}"]`);
    if (!viewer || !body || !template) return;
    origin = button.querySelector<HTMLElement>('.cert__img');
    body.replaceChildren(template.content.cloneNode(true));
    document.documentElement.style.overflow = 'hidden';
    viewer.showModal();
    viewer.classList.add('is-open');
    const firstPage = body.querySelector<HTMLImageElement>('.cert-viewer__page');
    if (origin && firstPage) await zoom(origin.getBoundingClientRect(), firstPage);
  };

  const close = async () => {
    if (!viewer || closing || !viewer.open) return;
    closing = true;
    viewer.classList.remove('is-open');
    const firstPage = body?.querySelector<HTMLImageElement>('.cert-viewer__page');
    if (origin && firstPage && firstPage.getBoundingClientRect().top < window.innerHeight) {
      await zoom(origin.getBoundingClientRect(), firstPage, true);
    }
    viewer.close();
    document.documentElement.style.overflow = '';
    origin?.closest('button')?.focus({ preventScroll: true });
    closing = false;
  };

  document.querySelectorAll<HTMLButtonElement>('[data-cert]').forEach((button) =>
    button.addEventListener('click', () => open(button)),
  );
  viewer?.querySelector('[data-cert-close]')?.addEventListener('click', close);
  // Klick daneben schließt – aber nur, wenn der Klick auch dort begonnen hat (sonst schließt der
  // öffnende Klick den Dialog sofort wieder)
  const isBackdrop = (target: EventTarget | null) =>
    target === viewer || (target instanceof HTMLElement && target.classList.contains('cert-viewer__inner'));
  let pressedOnBackdrop = false;
  viewer?.addEventListener('pointerdown', (event) => (pressedOnBackdrop = isBackdrop(event.target)));
  viewer?.addEventListener('click', (event) => {
    if (pressedOnBackdrop && isBackdrop(event.target)) close();
    pressedOnBackdrop = false;
  });
  viewer?.addEventListener('cancel', (event) => {
    event.preventDefault();
    close();
  });
</script>

<style>
  .certs__list {
    display: flex;
    /* mittig – bei vielen Zertifikaten trotzdem vollständig wischbar */
    justify-content: safe center;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    margin: 0;
    padding: 0.5rem 0.25rem 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .certs__item {
    flex: none;
    scroll-snap-align: start;
  }

  .cert {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: calc(35vh * 0.727);
    min-width: 11rem;
    padding: 0;
    font: inherit;
    text-align: left;
    color: inherit;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .cert__paper {
    position: relative;
    display: block;
    height: 35vh;
    min-height: 15rem;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: #ffffff;
    box-shadow:
      0 0 0 1px var(--color-border),
      var(--shadow-md);
    transition:
      transform var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out);
  }

  .cert__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .cert__zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    color: var(--color-cta-fg);
    border-radius: 50%;
    background: var(--color-cta);
    box-shadow: var(--shadow-md);
    opacity: 0;
    translate: 0 0.3rem;
    transition:
      opacity var(--duration-base) ease,
      translate var(--duration-base) var(--ease-out);
  }

  .cert:hover .cert__paper,
  .cert:focus-visible .cert__paper {
    transform: translateY(-3px);
    box-shadow:
      0 0 0 1px var(--color-border-strong),
      var(--shadow-lg);
  }

  .cert:hover .cert__zoom,
  .cert:focus-visible .cert__zoom {
    opacity: 1;
    translate: 0 0;
  }

  .cert:focus-visible {
    outline: none;
  }

  .cert:focus-visible .cert__paper {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .cert__caption {
    display: grid;
    gap: 0.2rem;
  }

  .cert__title {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    line-height: 1.3;
    color: var(--color-heading);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .cert__meta {
    font-size: var(--text-2xs);
    color: var(--color-text-subtle);
  }

  /* Großansicht */
  .cert-viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .cert-viewer::backdrop {
    background: rgb(var(--ink) / 0);
    transition: background-color 380ms ease;
  }

  .cert-viewer.is-open::backdrop {
    background: rgb(var(--ink) / 0.82);
  }

  .cert-viewer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    padding: clamp(1rem, 4vh, 2.5rem) var(--gutter) var(--space-8);
    overflow-y: auto;
    color: #ffffff;
    text-align: center;
  }

  .cert-viewer__inner :global(.cert-viewer__title) {
    max-width: 44rem;
    font-size: var(--text-lg);
    color: #ffffff;
    opacity: 0;
    transition: opacity 300ms ease 200ms;
  }

  .cert-viewer__inner :global(.cert-viewer__meta) {
    font-size: var(--text-xs);
    color: rgb(255 255 255 / 0.7);
    opacity: 0;
    transition: opacity 300ms ease 200ms;
  }

  .cert-viewer.is-open :global(.cert-viewer__title),
  .cert-viewer.is-open :global(.cert-viewer__meta),
  .cert-viewer.is-open :global(.cert-viewer__download) {
    opacity: 1;
  }

  .cert-viewer__inner :global(.cert-viewer__pages) {
    display: grid;
    gap: var(--space-4);
    width: min(100%, 52rem, calc((100vh - 10rem) * 0.727));
    min-width: min(100%, 22rem);
  }

  .cert-viewer__inner :global(.cert-viewer__page) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.7);
    transform-origin: center;
  }

  .cert-viewer__inner :global(.cert-viewer__download) {
    display: inline-flex;
    margin-top: var(--space-2);
    padding: 0.55rem 1.2rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-cta-fg);
    text-decoration: none;
    border-radius: var(--radius-full);
    background: var(--color-cta);
    opacity: 0;
    transition: opacity 300ms ease 200ms;
  }

  .cert-viewer__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    color: var(--color-cta-fg);
    border: 0;
    border-radius: 50%;
    background: var(--color-cta);
    box-shadow: var(--shadow-lg);
    cursor: pointer;
  }

  .cert-viewer__close:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }
</style>
