---
/**
 * Kontaktbereich (id="kontakt") – steht am Ende jeder Seite. Der „Kontakt“-Button im Header springt hierher.
 */
import { site } from '@/config/site';
import Button from '@/components/ui/Button.astro';
import ContactList from '@/components/ui/ContactList.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import TechGrid from '@/components/ui/TechGrid.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Ihr Projekt in <span class="accent">guten Händen.</span>',
  text = 'Ob neue Hofeinfahrt, Hausanschluss oder Erschließungsstraße: Rufen Sie uns an oder schreiben Sie uns. Wir beraten Sie gerne und erstellen Ihnen ein individuelles Angebot.',
} = Astro.props;
---

<section id="kontakt" class="contact" aria-labelledby="kontakt-titel">
  <Container>
    <div class="contact__card" data-tone="brand" data-reveal="zoom">
      <TechGrid tone="light" class="contact__pattern" />

      <div class="contact__intro">
        <Eyebrow icon="message-square">Kontakt</Eyebrow>
        <h2 class="contact__title" id="kontakt-titel" set:html={title} />
        <p class="contact__text">{text}</p>
        <div class="contact__actions">
          <Button href={site.contact.phoneHref} variant="light" size="lg" icon="phone" iconPosition="start">
            {site.contact.phone}
          </Button>
          <Button href={`mailto:${site.contact.email}`} variant="outline-light" size="lg" icon="mail" iconPosition="start">
            E-Mail schreiben
          </Button>
        </div>
      </div>

      <div class="contact__details">
        <ContactList items={['address', 'hours', 'fax']} />
        <Button href={site.mapsUrl} variant="light" icon="navigation" iconPosition="start" external>Route planen</Button>
        <div class="contact__area">
          <h3 class="contact__area-title">Unser Einsatzgebiet</h3>
          <ul class="contact__places" role="list">
            {site.serviceArea.places.map((place) => <li>{place}</li>)}
            <li class="contact__places-more">und Umgebung</li>
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .contact {
    position: relative;
    z-index: 2;
    padding-block: var(--section-space-sm) 0;
    margin-bottom: calc(var(--footer-overlap) * -1);
  }

  .contact__card {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-12);
    padding: clamp(1.75rem, 1rem + 4vw, 4.5rem);
    overflow: hidden;
    border-radius: var(--radius-2xl);
    background: linear-gradient(135deg, var(--blue-800) 0%, var(--blue-900) 100%);
    box-shadow: var(--shadow-xl);
  }

  @media (min-width: 60rem) {
    .contact__card {
      grid-template-columns: 1.25fr 1fr;
      align-items: start;
    }
  }

  .contact__card :global(.contact__pattern) {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: linear-gradient(115deg, transparent 25%, #000 100%);
  }

  .contact__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .contact__title {
    font-size: var(--text-4xl);
    line-height: 1.1;
  }

  .contact__title :global(.accent) {
    color: var(--color-accent);
  }

  .contact__text {
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: rgb(7 23 44 / 0.45);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .contact__area {
    width: 100%;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .contact__area-title {
    margin-bottom: var(--space-3);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    font-stretch: 100%;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--blue-200);
  }

  .contact__places {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  .contact__places li {
    padding: 0.3em 0.75em;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: #ffffff;
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.08);
  }

  .contact__places .contact__places-more {
    background: transparent;
    color: var(--color-text-muted);
  }
</style>
