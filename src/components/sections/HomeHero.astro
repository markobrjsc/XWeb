---
/**
 * HomeHero – die Startseite als ein einziger Bildschirm: helles Foto über die ganze Fläche (src/assets/images/hero.jpg)
 * mit weicher Vignette. Mittig – hinterlegt nur mit einer kantenlos auslaufenden Unschärfe – Ortszeile, Firmenname,
 * Kurztext, die drei Fachbereiche als leichte Chips (Links zu den Leistungen) und die beiden Hauptaktionen.
 * Ganz unten die rechtlichen Links als runde, milchige Plakette im Stil des Headers
 * (die Startseite hat keinen Footer).
 */
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { legalNav } from '@/config/navigation';
import { site } from '@/config/site';
import { pillars } from '@/data/services';
import { findImage, heroImageName } from '@/lib/images';

const heroPhoto = findImage(heroImageName('/', 'hero'));
// Reihenfolge der Plakette: Impressum · © Firmenname · Datenschutz
const [firstLegal, ...otherLegal] = legalNav;
---

<section class="hero" aria-labelledby="hero-titel" data-hero-edit="/">
  <div class="hero__bg" aria-hidden="true">
    {
      heroPhoto && (
        <Picture
          src={heroPhoto}
          alt=""
          formats={['avif', 'webp']}
          widths={[960, 1440, 1920, 2400].filter((w) => w <= heroPhoto.width)}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero__photo"
        />
      )
    }
  </div>

  <div class="hero__content">
    <div class="hero__card">
      <p class="hero__kicker">
        <span class="hero__kicker-line" aria-hidden="true"></span>
        Radolfzell am Bodensee · seit {site.foundingYear}
        <span class="hero__kicker-line" aria-hidden="true"></span>
      </p>

      <h1 class="hero__title" id="hero-titel">
        <span class="hero__title-pre">Pflasterarbeiten</span>
        <span class="hero__title-main">Hildebrand</span>
      </h1>

      <!-- Fachbereiche als ruhige Informationszeile (Links zu den Leistungen) – bewusst keine Buttons,
           damit die beiden Hauptaktionen darunter klar hervorstechen -->
      <nav class="hero__pillars" aria-label="Unsere Fachbereiche">
        <ul role="list">
          {
            pillars.map((pillar) => (
              <li>
                <a class="hero__pillar" href={`/leistungen/#${pillar.id}`}>
                  <Icon name={pillar.icon} size="1.15rem" class="hero__pillar-icon" />
                  <span class="hero__pillar-text">
                    <span class="hero__pillar-title">{pillar.title}</span>
                    <span class="hero__pillar-sub">{pillar.subtitle}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <hr class="hero__rule hero__rule--wide" aria-hidden="true" />

      <div class="hero__actions">
        <Button href="/kontakt/" variant="primary" size="lg" icon="arrow-right">Kontakt aufnehmen</Button>
        <Button href="/stellenangebote/" variant="outline-light" size="lg" class="hero__glass-btn">Stellenangebote</Button>
      </div>
    </div>
  </div>

  <footer class="hero__legal">
    {firstLegal && <a href={firstLegal.href}>{firstLegal.label}</a>}
    <span>© {new Date().getFullYear()} {site.name}</span>
    {otherLegal.map((item) => <a href={item.href}>{item.label}</a>)}
  </footer>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--blue-950);
  }

  /* Foto in voller Helligkeit über die ganze Fläche */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Zusätzliche Abdunklung des Fotos – einstellbar in der Design-Vorschau (--hero-dim: 0 … 0.7) */
  .hero__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(var(--ink) / var(--hero-dim, 0));
    pointer-events: none;
  }

  .hero__bg :global(picture),
  .hero__bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 45%;
    animation: hero-zoom 2400ms var(--ease-out) both;
  }

  /*
   * Vignette: kein runder Radialverlauf, sondern ein sehr breiter, weicher Innenschatten, der den Bildkanten folgt,
   * plus sanft auslaufende Verläufe oben und unten (mehrere Stufen, damit keine Kante sichtbar wird).
   */
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to bottom,
        rgb(var(--ink) / 0.4) 0%,
        rgb(var(--ink) / 0.24) 10%,
        rgb(var(--ink) / 0.11) 21%,
        rgb(var(--ink) / 0.03) 33%,
        transparent 42%,
        transparent 58%,
        rgb(var(--ink) / 0.05) 68%,
        rgb(var(--ink) / 0.16) 80%,
        rgb(var(--ink) / 0.32) 91%,
        rgb(var(--ink) / 0.48) 100%
      );
    box-shadow:
      inset 0 0 clamp(8rem, 22vmax, 20rem) clamp(1.5rem, 4vmax, 4rem) rgb(var(--ink) / 0.5),
      inset 0 0 clamp(2rem, 5vmax, 5rem) rgb(var(--ink) / 0.25);
  }

  /* Inhalt: mittig, leicht oberhalb der Bildmitte */
  .hero__content {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: calc(var(--header-height) + clamp(1.5rem, 6vh, 4rem)) var(--gutter) clamp(3.5rem, 11vh, 7.5rem);
  }

  /* Handy: Inhalt ist schmaler und damit höher – weniger Innenabstand, damit alles auf einen Bildschirm passt */
  @media (max-width: 40rem) {
    .hero .hero__content {
      padding-top: calc(var(--header-height) + var(--space-2));
      padding-bottom: var(--space-6);
    }

    .hero__card {
      translate: 0 -0.75rem;
    }

    .hero__card .hero__pillars {
      margin-top: 5rem;
    }

    .hero__pillar {
      justify-content: center;
      text-align: center;
    }

    .hero__card .hero__actions {
      gap: var(--space-2);
    }

    .hero__legal {
      flex-wrap: nowrap;
      max-width: calc(100% - var(--gutter) * 2);
      padding-inline: 0.75rem;
      font-size: 0.6875rem;
      white-space: nowrap;
    }

    .hero__legal > a {
      display: none;
    }
  }

  @media (max-width: 22.5rem) {
    .hero__legal {
      padding-inline: 0.5rem;
      font-size: 0.625rem;
    }
  }

  /* Inhaltsblock ohne sichtbare Fläche und ohne Rand */
  .hero__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Abstände bewusst je Gruppe (Ort + Name · Fachbereiche · Aktionen) statt gleichmäßig – siehe margin-top unten */
    gap: 0;
    width: 100%;
    max-width: 48rem;
    padding: clamp(0.75rem, 0.5rem + 1.2vw, 1.5rem) clamp(0.5rem, 2vw, 1.5rem);
    text-align: center;
    color: #ffffff;
    text-shadow:
      0 1px 2px rgb(var(--ink) / 0.5),
      0 2px 12px rgb(var(--ink) / 0.45),
      0 0 32px rgb(var(--ink) / 0.3);
  }

  /*
   * Lesehilfe ohne Kanten: eine leichte Unschärfe mit einem Hauch Dunkelblau direkt hinter dem Text,
   * die über eine weiche Maske zu allen Seiten hin unsichtbar ausläuft – keine Karte, kein Rand.
   */
  .hero__card::before {
    content: '';
    position: absolute;
    inset: -12% -34%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(var(--ink) / 0.26), rgb(var(--ink) / 0.14) 55%, transparent 100%);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    -webkit-mask-image: radial-gradient(
      closest-side,
      #000 0%,
      #000 38%,
      rgb(0 0 0 / 0.7) 58%,
      rgb(0 0 0 / 0.35) 76%,
      rgb(0 0 0 / 0.1) 90%,
      transparent 100%
    );
    mask-image: radial-gradient(
      closest-side,
      #000 0%,
      #000 38%,
      rgb(0 0 0 / 0.7) 58%,
      rgb(0 0 0 / 0.35) 76%,
      rgb(0 0 0 / 0.1) 90%,
      transparent 100%
    );
    pointer-events: none;
    animation: hero-haze-in 1200ms var(--ease-out) 100ms both;
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.92);
    animation: hero-rise 800ms var(--ease-out) 150ms both;
  }

  .hero__kicker-line {
    width: 2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
    box-shadow: 0 1px 3px rgb(var(--ink) / 0.4);
  }

  @media (max-width: 30rem) {
    .hero__kicker {
      font-size: 0.68rem;
    }

    .hero__kicker-line {
      display: none;
    }
  }

  .hero__title {
    margin-top: clamp(0.6rem, 1.4vh, 0.9rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #ffffff;
    line-height: 1;
    animation: hero-rise 900ms var(--ease-out) 250ms both;
  }

  .hero__title-pre {
    font-size: clamp(0.85rem, min(0.6rem + 0.8vw, 2.4vh), 1.25rem);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    /* Ausgleich für den Buchstabenabstand am Wortende */
    margin-right: -0.32em;
  }

  .hero__title-main {
    margin-top: 0.14em;
    font-size: clamp(2.2rem, min(0.8rem + 4.6vw, 8.5vh), 4.75rem);
    font-weight: var(--weight-bold);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  /* Dünne weiße Trennlinien zwischen den Abschnitten – je nach Stelle unterschiedlich lang und kräftig */
  .hero__rule {
    flex-shrink: 0;
    margin: 0;
    border: 0;
    border-radius: 999px;
    box-shadow: 0 1px 6px rgb(var(--ink) / 0.35);
    animation: hero-rule-in 900ms var(--ease-out) both;
  }

  /* Lang und fein, an den Enden auslaufend */
  .hero__rule--wide {
    margin-top: clamp(1rem, 2.4vh, 1.6rem);
    width: min(20rem, 80%);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.7) 22%, rgb(255 255 255 / 0.7) 78%, transparent);
    box-shadow: none;
    animation-delay: 600ms;
  }

  /* Fachbereiche: ruhige Zeile mit feinen Trennstrichen – Information, keine Buttons */
  .hero__pillars {
    margin-top: clamp(1.25rem, 3vh, 2.1rem);
  }

  .hero__pillars ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
    padding: 0;
  }

  .hero__pillars li {
    display: flex;
    animation: hero-rise 800ms var(--ease-out) both;
  }

  .hero__pillars li + li {
    border-left: 1px solid rgb(255 255 255 / 0.35);
  }

  .hero__pillars li:nth-child(1) {
    animation-delay: 380ms;
  }
  .hero__pillars li:nth-child(2) {
    animation-delay: 460ms;
  }
  .hero__pillars li:nth-child(3) {
    animation-delay: 540ms;
  }

  .hero__pillar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.15rem clamp(0.9rem, 0.4rem + 1.6vw, 1.75rem);
    color: #ffffff;
    text-align: left;
    text-decoration: none;
  }

  .hero__pillar :global(.hero__pillar-icon) {
    flex: none;
    color: var(--color-accent);
    filter: drop-shadow(0 1px 4px rgb(var(--ink) / 0.5));
  }

  .hero__pillar-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .hero__pillar-title {
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    letter-spacing: 0.01em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--duration-base) ease;
  }

  .hero__pillar-sub {
    font-size: var(--text-2xs);
    font-weight: var(--weight-medium);
    color: rgb(255 255 255 / 0.78);
  }

  .hero__pillar:hover .hero__pillar-title {
    text-decoration-color: currentColor;
  }

  .hero__pillar:focus-visible {
    outline: 2px solid var(--color-focus-inverse);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* Schmale Bildschirme: nur die Titel in einer Zeile – ohne Icons und Untertitel */
  @media (max-width: 40rem) {
    .hero__pillar {
      padding-inline: 0.7rem;
    }

    .hero__pillar :global(.hero__pillar-icon),
    .hero__pillar-sub {
      display: none;
    }

    .hero__pillar-title {
      font-size: var(--text-sm);
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: clamp(1rem, 2.4vh, 1.6rem);
    text-shadow: none;
    animation: hero-rise 900ms var(--ease-out) 660ms both;
  }

  .hero__actions :global(.btn--primary) {
    box-shadow: 0 12px 28px -12px rgb(var(--ink) / 0.7);
  }

  /* Nebenaktion mit milchiger Füllung wie Header und Fußleiste */
  .hero__actions :global(.hero__glass-btn.btn) {
    --btn-bg: rgb(var(--glass-dark));
    --btn-bg-hover: rgb(var(--ink) / 0.72);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
  }

  /* Rechtliche Links am unteren Rand – runde, milchige Plakette wie der Header */
  .hero__legal {
    display: flex;
    flex-wrap: wrap;
    align-self: center;
    justify-content: center;
    gap: 0.25rem 1.25rem;
    max-width: calc(100% - var(--gutter) * 2);
    margin-bottom: clamp(1.25rem, 3.5vh, 2rem);
    padding: 0.55rem 1.4rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.01em;
    text-align: center;
    color: #ffffff;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 999px;
    background: rgb(var(--glass-dark));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
  }

  .hero__legal a {
    color: #ffffff;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .hero__legal a:hover {
    color: var(--blue-100);
    text-decoration-thickness: 2px;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes hero-rule-in {
    from {
      opacity: 0;
      scale: 0.2 1;
    }
  }

  @keyframes hero-haze-in {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-zoom {
    from {
      scale: 1.06;
    }
    to {
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bg :global(img),
    .hero__card::before,
    .hero__rule,
    .hero__kicker,
    .hero__title,
    .hero__pillars li,
    .hero__actions {
      animation: none !important;
    }
  }
</style>
