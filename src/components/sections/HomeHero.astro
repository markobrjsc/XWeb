---
/**
 * HomeHero – die Startseite als ein einziger Bildschirm: Foto im Hintergrund (src/assets/images/hero.jpg),
 * links Leistungsversprechen und Eckdaten, rechts die drei Fachbereiche als Kreis (ServiceOrbit).
 * Rechtliche Links stehen am unteren Rand, da die Startseite keinen Footer hat.
 */
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import ServiceOrbit from '@/components/sections/ServiceOrbit.astro';
import { legalNav } from '@/config/navigation';
import { site } from '@/config/site';
import { findImage } from '@/lib/images';

const heroPhoto = findImage('hero');
---

<section class="hero" data-tone="dark" aria-labelledby="hero-titel">
  <div class="hero__bg" aria-hidden="true">
    {
      heroPhoto && (
        <Picture
          src={heroPhoto}
          alt=""
          formats={['avif', 'webp']}
          widths={[960, 1440, 1920, 2400].filter((w) => w <= heroPhoto.width)}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero__photo"
        />
      )
    }
  </div>

  <Container size="wide" class="hero__container">
    <div class="hero__content">
      <Eyebrow class="hero__eyebrow">{site.name} · Radolfzell am Bodensee</Eyebrow>

      <h1 class="hero__title" id="hero-titel">
        Gartenbau, Tiefbau und Straßenbau <span class="hero__title-accent">aus einer Hand.</span>
      </h1>

      <p class="hero__lead">
        Seit {site.foundingYear} bauen wir Höfe, Wege, Gärten, Kanäle und Straßen im Landkreis Konstanz – für private
        Bauherren, Gewerbebetriebe und öffentliche Auftraggeber. {site.claim}.
      </p>

      <div class="hero__actions">
        <Button href="/leistungen/" variant="light" icon="arrow-right">Unsere Leistungen</Button>
        <Button href="/kontakt/" variant="outline-light">Kontakt aufnehmen</Button>
      </div>

      <dl class="hero__facts">
        <div class="hero__fact">
          <dt>Familienbetrieb</dt>
          <dd>seit {site.foundingYear}</dd>
        </div>
        <div class="hero__fact">
          <dt>Einsatzgebiet</dt>
          <dd>Landkreis Konstanz</dd>
        </div>
        <div class="hero__fact">
          <dt>Telefon</dt>
          <dd><a href={site.contact.phoneHref}>{site.contact.phone}</a></dd>
        </div>
      </dl>
    </div>

    <ServiceOrbit class="hero__orbit" />
  </Container>

  <footer class="hero__legal">
    <span>© {new Date().getFullYear()} {site.name}</span>
    {legalNav.map((item) => <a href={item.href}>{item.label}</a>)}
  </footer>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: calc(var(--header-height) + clamp(1.5rem, 4vh, 3rem));
    overflow: hidden;
    background: var(--blue-950);
  }

  /* Hintergrund */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__bg :global(picture),
  .hero__bg :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }

  /* Abdunkelung: links kräftig für gut lesbaren Text, rechts leichter */
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(7 23 44 / 0.94) 0%, rgb(7 23 44 / 0.82) 42%, rgb(7 23 44 / 0.5) 100%),
      linear-gradient(0deg, rgb(7 23 44 / 0.7) 0%, transparent 35%);
  }

  /* Raster */
  .hero :global(.hero__container) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hero :global(.hero__container) {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(2.5rem, 1rem + 4vw, 5.5rem);
    }
  }

  /* Text */
  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 2.4vh, 1.5rem);
  }

  .hero__content > :global(.hero__eyebrow) {
    animation: hero-rise 700ms var(--ease-out) 100ms both;
  }

  .hero__title {
    max-width: 17ch;
    font-size: clamp(2.25rem, 1.2rem + 2.6vw + 1vh, 4rem);
    font-weight: var(--weight-bold);
    line-height: 1.06;
    letter-spacing: -0.022em;
    color: #ffffff;
    animation: hero-rise 800ms var(--ease-out) 180ms both;
  }

  .hero__title-accent {
    color: var(--color-accent);
  }

  .hero__lead {
    max-width: 36rem;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    animation: hero-rise 800ms var(--ease-out) 300ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    animation: hero-rise 800ms var(--ease-out) 420ms both;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-5) var(--space-8);
    width: 100%;
    max-width: 38rem;
    margin: var(--space-4) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    animation: hero-rise 800ms var(--ease-out) 540ms both;
  }

  .hero__fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .hero__fact dt {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__fact dd {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: #ffffff;
  }

  .hero__fact dd a {
    color: inherit;
    text-decoration: none;
  }

  .hero__fact dd a:hover {
    text-decoration: underline;
  }

  /* Rechtliche Links am unteren Rand */
  .hero__legal {
    display: flex;
    margin-top: var(--space-10);
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
    padding: 0.9rem var(--gutter);
    font-size: var(--text-xs);
    color: rgb(255 255 255 / 0.62);
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  /* Desktop: Startseite als ein Bildschirm, rechtliche Links am unteren Rand */
  @media (min-width: 64rem) {
    .hero {
      padding-bottom: 3.25rem;
    }

    .hero__legal {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      margin-top: 0;
    }
  }

  .hero__legal a {
    color: rgb(255 255 255 / 0.82);
    text-decoration: none;
  }

  .hero__legal a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__content > :global(*),
    .hero__title,
    .hero__lead,
    .hero__actions,
    .hero__facts {
      animation: none !important;
    }
  }
</style>
