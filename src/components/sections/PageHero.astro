---
/**
 * PageHero – dunkler Seitenkopf der Unterseiten mit Brotkrumen, Überschrift und Einleitung.
 * Slot "aside": optionaler Inhalt rechts (z. B. Kennzahlen oder eine Zeichnung).
 * Slot default: optionale Buttons unter dem Text.
 * `image`: Name eines Fotos aus src/assets/images (z. B. "betrieb/team/01") – erscheint abgedunkelt im Hintergrund.
 */
import { Picture } from 'astro:assets';
import Breadcrumbs, { type Crumb } from '@/components/ui/Breadcrumbs.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import TechGrid from '@/components/ui/TechGrid.astro';
import { findImage } from '@/lib/images';

interface Props {
  title: string;
  eyebrow?: string;
  eyebrowIcon?: string;
  lead?: string;
  breadcrumbs?: Crumb[];
  size?: 'md' | 'sm';
  image?: string;
  /** Bildausschnitt, z. B. "50% 40%" */
  imagePosition?: 'center' | 'top' | 'bottom';
}

const { title, eyebrow, eyebrowIcon, lead, breadcrumbs, size = 'md', image, imagePosition = 'center' } = Astro.props;
const photo = findImage(image);
const hasAside = Astro.slots.has('aside');
---

<section
  class:list={['page-hero', `page-hero--${size}`, { 'page-hero--aside': hasAside, 'page-hero--photo': photo }]}
  data-tone="dark"
>
  {
    photo && (
      <div class="page-hero__photo" aria-hidden="true" data-position={imagePosition}>
        <Picture
          src={photo}
          alt=""
          formats={['avif', 'webp']}
          widths={[960, 1440, 1920].filter((w) => w <= photo.width)}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
  <div class="page-hero__bg" aria-hidden="true" data-parallax="0.12">
    <TechGrid tone="light" class="page-hero__grid" />
  </div>

  <Container class="page-hero__container">
    <div class="page-hero__content">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} class="page-hero__crumbs" />}
      {eyebrow && <Eyebrow icon={eyebrowIcon}>{eyebrow}</Eyebrow>}
      <h1 class="page-hero__title" set:html={title} />
      {lead && <p class="page-hero__lead">{lead}</p>}
      {
        Astro.slots.has('default') && (
          <div class="page-hero__actions">
            <slot />
          </div>
        )
      }
    </div>
    {
      hasAside && (
        <div class="page-hero__aside">
          <slot name="aside" />
        </div>
      )
    }
  </Container>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: calc(var(--header-height) + clamp(2.5rem, 1.5rem + 4vw, 4.5rem));
    padding-bottom: clamp(3.5rem, 2rem + 5vw, 6rem);
    background: linear-gradient(165deg, var(--blue-950) 0%, var(--blue-900) 100%);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }

  .page-hero__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .page-hero__photo :global(picture),
  .page-hero__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__photo[data-position='top'] :global(img) {
    object-position: 50% 25%;
  }

  .page-hero__photo[data-position='bottom'] :global(img) {
    object-position: 50% 75%;
  }

  .page-hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(7 23 44 / 0.94) 0%, rgb(7 23 44 / 0.8) 50%, rgb(7 23 44 / 0.55) 100%);
  }

  .page-hero--photo {
    background: var(--blue-950);
  }

  .page-hero--photo .page-hero__bg {
    opacity: 0.5;
  }

  .page-hero--sm {
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .page-hero__bg {
    position: absolute;
    inset: -15% 0 0;
    z-index: -1;
    translate: 0 var(--parallax, 0px);
  }

  .page-hero__bg :global(.page-hero__grid) {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 80% 90% at 80% 20%, #000 10%, transparent 75%);
  }

  .page-hero :global(.page-hero__container) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .page-hero--aside :global(.page-hero__container) {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-16);
    }
  }

  .page-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    max-width: 48rem;
  }

  .page-hero :global(.page-hero__crumbs) {
    margin-bottom: var(--space-2);
    animation: hero-in 700ms var(--ease-out) both;
  }

  .page-hero__content > :global(.eyebrow) {
    animation: hero-in 700ms var(--ease-out) 60ms both;
  }

  .page-hero__title {
    font-size: var(--text-5xl);
    line-height: 1.08;
    animation: hero-in 800ms var(--ease-out) 120ms both;
  }

  .page-hero__title :global(.accent) {
    color: var(--color-accent);
  }

  .page-hero__lead {
    max-width: 40rem;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    animation: hero-in 800ms var(--ease-out) 200ms both;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    animation: hero-in 800ms var(--ease-out) 280ms both;
  }

  .page-hero__aside {
    animation: hero-in 900ms var(--ease-out) 240ms both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero *,
    .page-hero :global(*) {
      animation: none !important;
    }
  }
</style>
