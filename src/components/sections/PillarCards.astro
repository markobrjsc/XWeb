---
/**
 * PillarCards – die drei Fachbereiche als Karten, die in den Startbildschirm hineinragen.
 */
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import IconBadge from '@/components/ui/IconBadge.astro';
import { pillars } from '@/data/services';
---

<section id="bereiche" class="pillars" aria-labelledby="bereiche-titel">
  <h2 id="bereiche-titel" class="visually-hidden">Unsere drei Fachbereiche</h2>
  <Container size="wide">
    <ul class="pillars__grid" role="list" data-reveal-group="120">
      {
        pillars.map((pillar) => (
          <li class="pillars__item">
            <Card interactive reveal="up" padding="lg" class="pillar-card">
              <div class="pillar-card__top">
                <IconBadge name={pillar.icon} tone="soft" size="lg" class="pillar-card__icon" />
                <span class="pillar-card__num" aria-hidden="true">
                  {pillar.number}
                </span>
              </div>
              <p class="pillar-card__subtitle">{pillar.subtitle}</p>
              <h3 class="pillar-card__title">
                <a class="card__link" href={`#${pillar.id}`}>
                  {pillar.title}
                </a>
              </h3>
              <p class="pillar-card__text">{pillar.teaser}</p>
              <span slot="footer" class="pillar-card__more" aria-hidden="true">
                Leistungen ansehen <Icon name="arrow-right" size="1.05em" />
              </span>
            </Card>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .pillars {
    position: relative;
    z-index: 3;
    margin-top: calc(var(--pillar-overlap) * -1);
    /* Oberer Teil transparent (ragt in den Startbildschirm), darunter Übergang in den Leistungsbereich */
    background: linear-gradient(to bottom, transparent var(--pillar-overlap), var(--color-bg-subtle) var(--pillar-overlap));
  }

  .pillars__grid {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 52rem) {
    .pillars__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pillars__item {
    display: flex;
  }

  .pillars__item > :global(.pillar-card) {
    flex: 1;
    box-shadow: var(--shadow-lg);
    border-top: 3px solid var(--blue-600);
  }

  .pillar-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .pillar-card__num {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--gray-500);
    font-variant-numeric: tabular-nums;
  }

  .pillar-card__subtitle {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--blue-600);
  }

  .pillar-card__title {
    font-size: var(--text-3xl);
    line-height: 1.1;
  }

  .pillar-card__text {
    color: var(--color-text-muted);
  }

  .pillar-card__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--blue-600);
  }

  .pillar-card__more :global(.icon) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  :global(.pillar-card:hover) .pillar-card__more :global(.icon) {
    transform: translateX(3px);
  }

  :global(.pillar-card:hover) :global(.pillar-card__icon) {
    background: var(--blue-600);
    color: #ffffff;
    box-shadow: none;
  }
</style>
