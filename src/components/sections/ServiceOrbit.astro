---
/**
 * ServiceOrbit – die drei Fachbereiche als Kreis: drei Segmente um die Bildmarke in der Mitte,
 * je mit Icon, Kurzbeschreibung und Links zu Leistungen und Referenzen.
 * Auf schmalen Bildschirmen werden daraus drei untereinanderliegende Karten.
 * Daten: src/data/services.ts
 */
import { Image } from 'astro:assets';
import logo from '@/assets/brand/hildebrand-logo.webp';
import Icon from '@/components/ui/Icon.astro';
import { pillars } from '@/data/services';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Segmentmitten: oben, unten rechts, unten links (Winkel in Grad, 0° = rechts)
const angles = [-90, 30, 150];
const R = 48; // Außenradius in % (viewBox 0–100)
const HUB = 14; // Radius der Mitte
const point = (angle: number, radius: number) => {
  const rad = (angle * Math.PI) / 180;
  return { x: 50 + radius * Math.cos(rad), y: 50 + radius * Math.sin(rad) };
};
const separators = angles.map((a) => a + 60).map((a) => ({ from: point(a, HUB + 1.5), to: point(a, R) }));
const ticks = Array.from({ length: 72 }, (_, i) => i * 5).map((a) => ({
  from: point(a, R + 0.6),
  to: point(a, a % 30 === 0 ? R + 2.6 : R + 1.5),
}));
const sectorPath = (center: number) => {
  const a0 = center - 60;
  const a1 = center + 60;
  const o0 = point(a0, R);
  const o1 = point(a1, R);
  const i0 = point(a0, HUB + 1.5);
  const i1 = point(a1, HUB + 1.5);
  return `M${i0.x} ${i0.y} L${o0.x} ${o0.y} A${R} ${R} 0 0 1 ${o1.x} ${o1.y} L${i1.x} ${i1.y} A${HUB + 1.5} ${HUB + 1.5} 0 0 0 ${i0.x} ${i0.y}Z`;
};
const f = (n: number) => n.toFixed(2);
---

<nav class:list={['orbit', className]} aria-label="Unsere Fachbereiche">
  <svg class="orbit__ring" viewBox="-4 -4 108 108" aria-hidden="true">
    {angles.map((a, i) => <path class={`orbit__sector orbit__sector--${i}`} d={sectorPath(a)} />)}
    <circle class="orbit__outline" cx="50" cy="50" r={R} />
    <g class="orbit__ticks">
      {ticks.map((t) => <line x1={f(t.from.x)} y1={f(t.from.y)} x2={f(t.to.x)} y2={f(t.to.y)} />)}
    </g>
    <circle class="orbit__dash" cx="50" cy="50" r={R - 4} pathLength="360" />
    {separators.map((s) => <line class="orbit__sep" x1={f(s.from.x)} y1={f(s.from.y)} x2={f(s.to.x)} y2={f(s.to.y)} />)}
    <circle class="orbit__hub-ring" cx="50" cy="50" r={HUB + 1.5} />
  </svg>

  <div class="orbit__hub">
    <Image src={logo} alt="" width={96} densities={[1, 2]} class="orbit__logo" loading="eager" />
    <span class="orbit__hub-text">Alles aus<br />einer Hand</span>
  </div>

  <ul class="orbit__list" role="list">
    {
      pillars.map((pillar, i) => (
        <li class={`orbit__item orbit__item--${i}`} data-index={i}>
          <span class="orbit__icon" aria-hidden="true">
            <Icon name={pillar.icon} size="1.35rem" />
          </span>
          <h2 class="orbit__title">
            <a href={`/leistungen/#${pillar.id}`} class="orbit__main-link">
              {pillar.title}
            </a>
          </h2>
          <p class="orbit__text">{pillar.subtitle}</p>
          <p class="orbit__links">
            <a href={`/leistungen/#${pillar.id}`}>Leistungen</a>
            <span aria-hidden="true">·</span>
            <a href={`/referenzen/?bereich=${pillar.id}`}>
              Referenzen
              <Icon name="arrow-up-right" size="0.85em" />
            </a>
          </p>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .orbit {
    --orbit-size: min(36rem, calc(100svh - var(--header-height) - 9rem));
    position: relative;
    color: #ffffff;
  }

  .orbit__ring,
  .orbit__hub {
    display: none;
  }

  /* Schmale Bildschirme: drei Karten */
  .orbit__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
  }

  .orbit__item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-card);
    background: rgb(7 23 44 / 0.62);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    animation: orbit-in 700ms var(--ease-out) both;
    animation-delay: calc(350ms + var(--i, 0) * 120ms);
  }

  .orbit__item--1 {
    --i: 1;
  }
  .orbit__item--2 {
    --i: 2;
  }

  .orbit__icon {
    grid-row: span 3;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: #ffffff;
    background: var(--blue-600);
    box-shadow: 0 0 0 4px rgb(255 255 255 / 0.08);
    transition:
      background-color var(--duration-base) ease,
      transform var(--duration-slow) var(--ease-out);
  }

  .orbit__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: 1.15;
    color: #ffffff;
  }

  .orbit__main-link {
    color: inherit;
    text-decoration: none;
  }

  .orbit__main-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .orbit__text {
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.78);
  }

  .orbit__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-top: 0.3rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.5);
  }

  .orbit__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--blue-200);
    text-decoration: none;
  }

  .orbit__links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .orbit__item:hover .orbit__icon,
  .orbit__item:focus-within .orbit__icon {
    background: var(--blue-500);
    transform: scale(1.06);
  }

  /* Ab Desktop: Kreis mit drei Segmenten */
  @media (min-width: 64rem) {
    .orbit {
      width: var(--orbit-size);
      aspect-ratio: 1;
      margin-inline: auto;
    }

    .orbit__ring {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      animation: orbit-ring 900ms var(--ease-out) 150ms both;
    }

    .orbit__sector {
      fill: rgb(7 23 44 / 0.55);
      transition: fill var(--duration-slow) ease;
    }

    .orbit:has(.orbit__item--0:is(:hover, :focus-within)) .orbit__sector--0,
    .orbit:has(.orbit__item--1:is(:hover, :focus-within)) .orbit__sector--1,
    .orbit:has(.orbit__item--2:is(:hover, :focus-within)) .orbit__sector--2 {
      fill: rgb(22 72 140 / 0.72);
    }

    .orbit__outline {
      fill: none;
      stroke: rgb(255 255 255 / 0.55);
      stroke-width: 0.35;
    }

    .orbit__ticks line {
      stroke: rgb(255 255 255 / 0.4);
      stroke-width: 0.25;
    }

    .orbit__dash {
      fill: none;
      stroke: rgb(255 255 255 / 0.22);
      stroke-width: 0.25;
      stroke-dasharray: 1 2;
      transform-origin: 50% 50%;
      animation: orbit-spin 120s linear infinite;
    }

    .orbit__sep,
    .orbit__hub-ring {
      fill: none;
      stroke: rgb(255 255 255 / 0.35);
      stroke-width: 0.3;
    }

    /* Mitte mit Bildmarke */
    .orbit__hub {
      position: absolute;
      top: 50%;
      left: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.2rem;
      width: 26%;
      aspect-ratio: 1;
      translate: -50% -50%;
      border-radius: 50%;
      background: #ffffff;
      box-shadow:
        0 0 0 0.45rem rgb(255 255 255 / 0.1),
        0 20px 40px -18px rgb(0 0 0 / 0.6);
      animation: orbit-hub 800ms var(--ease-out) 250ms both;
    }

    .orbit__hub :global(.orbit__logo) {
      width: 44%;
      height: auto;
    }

    .orbit__hub-text {
      font-size: calc(var(--orbit-size) * 0.022);
      font-weight: var(--weight-bold);
      line-height: 1.15;
      letter-spacing: 0.06em;
      text-align: center;
      text-transform: uppercase;
      color: var(--blue-900);
    }

    /* Segmentinhalte */
    .orbit__list {
      display: block;
      position: absolute;
      inset: 0;
    }

    .orbit__item {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      width: 36%;
      padding: 0;
      text-align: center;
      background: none;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      translate: -50% -50%;
    }

    /* Positionen: Mitte der Segmente bei 60 % des Radius */
    .orbit__item--0 {
      left: 50%;
      top: 22%;
    }

    .orbit__item--1 {
      left: 72.5%;
      top: 63%;
    }

    .orbit__item--2 {
      left: 27.5%;
      top: 63%;
    }

    .orbit__icon {
      width: calc(var(--orbit-size) * 0.085);
      height: calc(var(--orbit-size) * 0.085);
      margin-bottom: 0.15rem;
    }

    .orbit__title {
      font-size: calc(var(--orbit-size) * 0.043);
    }

    .orbit__text {
      max-width: 11.5em;
      font-size: calc(var(--orbit-size) * 0.025);
      line-height: 1.35;
    }

    .orbit__links {
      flex-wrap: nowrap;
      justify-content: center;
      white-space: nowrap;
      font-size: calc(var(--orbit-size) * 0.023);
    }

    /* Ganze Fläche des Segments reagiert auf den Hauptlink */
    .orbit__main-link::before {
      content: '';
      position: absolute;
      inset: -18% -12%;
      border-radius: 50%;
    }

    .orbit__links {
      position: relative;
      z-index: 1;
    }
  }

  @keyframes orbit-in {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }

  @keyframes orbit-ring {
    from {
      opacity: 0;
      scale: 0.9;
      rotate: -20deg;
    }
  }

  @keyframes orbit-hub {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }

  @keyframes orbit-spin {
    to {
      rotate: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit__item,
    .orbit__ring,
    .orbit__hub,
    .orbit__dash {
      animation: none !important;
    }
  }
</style>
