---
/**
 * ValuesSection – „Warum Hildebrand?“: Werte und Stärken des Betriebs.
 */
import Button from '@/components/ui/Button.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { values } from '@/data/company';

interface Props {
  tone?: 'default' | 'subtle';
  showLink?: boolean;
}

const { tone = 'default', showLink = true } = Astro.props;
---

<Section tone={tone} labelledby="werte-titel" class="values">
  <div class="values__layout">
    <div class="values__intro">
      <SectionHeader
        id="werte-titel"
        eyebrow="Warum Hildebrand?"
        title={'Handwerk, auf das <span class="accent">Verlass ist.</span>'}
        lead="Als Familienbetrieb stehen wir mit unserem Namen für jedes Projekt ein. Das spüren unsere Kundinnen und Kunden – von der ersten Beratung bis zur Abnahme."
      >
        {showLink && <Button href="/betrieb/" variant="secondary" icon="arrow-right">Mehr über unseren Betrieb</Button>}
      </SectionHeader>
    </div>

    <ul class="values__grid" role="list" data-reveal-group="100">
      {
        values.map((value) => (
          <li class="values__item">
            <FeatureCard variant="dark" icon={value.icon} title={value.title} text={value.text} />
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  /*
   * Handy: Text, darunter die Karten · Tablet: Karten in 2, ab 64rem in 3 Spalten
   * Ab 72rem: Text links über zwei Spalten, die ersten zwei Karten rechts daneben,
   * die übrigen laufen darunter über die volle Breite weiter (statt einer langen Spalte rechts)
   */
  .values__layout {
    display: grid;
    gap: var(--space-4);
  }

  .values__grid {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .values__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .values__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .values__layout {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--grid-gap);
    }

    .values__intro {
      grid-column: span 2;
      align-self: center;
      padding-right: var(--space-8);
    }

    .values__intro :global(.section-header) {
      margin-bottom: 0;
    }

    /* Karten stehen direkt im Raster neben bzw. unter dem Text */
    .values__grid {
      display: contents;
    }
  }

  .values__item {
    display: flex;
  }

  .values__item > :global(*) {
    flex: 1;
  }
</style>
