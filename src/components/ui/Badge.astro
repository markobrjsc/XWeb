---
/**
 * Badge – kleines Etikett, z. B. für Kategorien, Anstellungsart oder Hinweise.
 */
import type { HTMLTag } from 'astro/types';
import Icon from './Icon.astro';

interface Props {
  as?: HTMLTag;
  tone?: 'primary' | 'soft' | 'neutral' | 'light' | 'outline';
  icon?: string;
  size?: 'sm' | 'md';
  class?: string;
}

const { as: Tag = 'span', tone = 'soft', icon, size = 'md', class: className } = Astro.props;
---

<Tag class:list={['badge', `badge--${tone}`, `badge--${size}`, className]}>
  {icon && <Icon name={icon} size="1.05em" />}
  <slot />
</Tag>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.35em 0.7em;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    letter-spacing: 0.01em;
    white-space: nowrap;
    border-radius: var(--radius-badge);
  }

  .badge--sm {
    padding: 0.3em 0.6em;
    font-size: var(--text-2xs);
  }

  .badge--primary {
    background: var(--blue-600);
    color: #ffffff;
  }

  .badge--soft {
    background: var(--blue-50);
    color: var(--blue-800);
    box-shadow: inset 0 0 0 1px var(--blue-100);
  }

  .badge--neutral {
    background: var(--gray-100);
    color: var(--gray-700);
  }

  .badge--light {
    background: rgb(255 255 255 / 0.1);
    color: #ffffff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }

  .badge--outline {
    background: transparent;
    color: var(--color-text-muted);
    box-shadow: inset 0 0 0 1px var(--color-border-strong);
  }

  :global([data-tone='dark']) .badge--soft,
  :global([data-tone='brand']) .badge--soft {
    background: rgb(255 255 255 / 0.1);
    color: #ffffff;
    box-shadow: none;
  }
</style>
