---
/**
 * Container – zentriert Inhalte und begrenzt die Breite. Seitenränder kommen aus --gutter.
 */
import type { HTMLTag } from 'astro/types';

interface Props {
  size?: 'default' | 'narrow' | 'wide';
  as?: HTMLTag;
  class?: string;
}

const { size = 'default', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', `container--${size}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: calc(var(--container-max) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .container--narrow {
    max-width: calc(var(--container-narrow) + var(--gutter) * 2);
  }

  .container--wide {
    max-width: calc(var(--container-wide) + var(--gutter) * 2);
  }
</style>
