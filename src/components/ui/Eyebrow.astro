---
/**
 * Eyebrow – kleine Überzeile über Überschriften, z. B. „Unsere Leistungen“.
 */
import type { HTMLTag } from 'astro/types';
import Icon from './Icon.astro';

interface Props {
  as?: HTMLTag;
  icon?: string;
  class?: string;
}

const { as: Tag = 'p', icon, class: className } = Astro.props;
---

<Tag class:list={['eyebrow', className]}>
  {icon ? <Icon name={icon} size="1.15em" class="eyebrow__icon" /> : <span class="eyebrow__line" aria-hidden="true" />}
  <span><slot /></span>
</Tag>

<style>
  .eyebrow {
    --eyebrow-color: var(--blue-600);
    --eyebrow-mark: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    font-stretch: 100%;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--eyebrow-color);
  }

  :global([data-tone='dark']) .eyebrow,
  :global([data-tone='brand']) .eyebrow {
    --eyebrow-color: var(--blue-200);
    --eyebrow-mark: var(--color-accent);
  }

  /* Heller Bereich in einem dunklen: wieder wie auf hellem Grund */
  :global(:is([data-tone='subtle'], [data-tone='muted']) .eyebrow:not(:is([data-tone='subtle'], [data-tone='muted']) :is([data-tone='dark'], [data-tone='brand']) .eyebrow)) {
    --eyebrow-color: var(--blue-600);
  }

  .eyebrow__line {
    display: inline-block;
    width: 1.5rem;
    height: 3px;
    border-radius: 1px;
    background: var(--eyebrow-mark);
    flex-shrink: 0;
  }

  .eyebrow :global(.eyebrow__icon) {
    color: currentColor;
  }
</style>
