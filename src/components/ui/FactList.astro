---
/**
 * FactList – kompakte Liste von Eckdaten (Beschriftung + Wert), z. B. im Seitenkopf.
 * Funktioniert auf hellem und dunklem Grund.
 */
import Icon from './Icon.astro';

export interface Fact {
  label: string;
  value: string;
  icon?: string;
  href?: string;
}

interface Props {
  facts: Fact[];
  title?: string;
  class?: string;
}

const { facts, title, class: className } = Astro.props;
---

<div class:list={['facts', className]} data-tone="dark">
  {title && <p class="facts__title">{title}</p>}
  <dl class="facts__list">
    {
      facts.map((fact) => (
        <div class="facts__row">
          <dt class="facts__label">
            {fact.icon && <Icon name={fact.icon} size="1.05em" />}
            {fact.label}
          </dt>
          <dd class="facts__value">{fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  /* Dunkel (Onyx) mit weißer Schrift und weißen Icons – auf hellem wie dunklem Grund gut lesbar.
     Farben über die Farbwelt (data-tone="dark"), damit „Design: Hell“ im Bearbeiten-Modus alles mitnimmt. */
  .facts {
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    color: var(--color-heading);
    border-radius: var(--radius-lg);
    background: var(--onyx-900);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  :global([data-tone='dark']) .facts,
  :global([data-tone='brand']) .facts {
    background: rgb(var(--ink) / 0.5);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }

  .facts__title {
    margin-bottom: var(--space-4);
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-heading) 70%, transparent);
  }

  .facts__list {
    margin: 0;
  }

  .facts__row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid color-mix(in srgb, var(--color-heading) 12%, transparent);
  }

  .facts__row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .facts__row:last-child {
    padding-bottom: 0;
  }

  .facts__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--color-heading) 72%, transparent);
  }

  .facts__label :global(.icon) {
    color: var(--color-heading);
  }

  .facts__value {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }

  .facts__value a {
    color: inherit;
    text-decoration: none;
  }

  .facts__value a:hover {
    text-decoration: underline;
  }
</style>
