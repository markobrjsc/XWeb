---
/**
 * JobCard – eine Stelle aus src/content/stellenangebote als Listeneintrag mit Link zur Detailseite.
 */
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import Card from './Card.astro';
import Icon from './Icon.astro';
import IconBadge from './IconBadge.astro';

interface Props {
  job: CollectionEntry<'stellenangebote'>;
  class?: string;
}

const { job, class: className } = Astro.props;
const { title, type, start, location, summary, icon } = job.data;
---

<Card variant="dark" interactive reveal="up" padding="sm" class:list={['job-card', className]}>
  <div class="job-card__layout">
    <div class="job-card__head">
      <IconBadge name={icon} tone="soft" />
      <div class="job-card__meta">
        <Badge tone="light" size="sm">{type}</Badge>
        <span class="job-card__detail"><Icon name="calendar" size="1em" /> {start}</span>
        <span class="job-card__detail"><Icon name="map-pin" size="1em" /> {location}</span>
      </div>
    </div>
    <div class="job-card__main">
      <h3 class="job-card__title">
        <a class="card__link" href={`/stellenangebote/${job.id}/`}>{title}</a>
      </h3>
      <p class="job-card__summary">{summary}</p>
    </div>
    <span class="job-card__more" aria-hidden="true">
      Details & Bewerbung <Icon name="arrow-right" size="1.05em" />
    </span>
  </div>
</Card>

<style>
  /* Gestapelt: passt in eine Kachel des 2×2-Rasters auf der Stellenseite */
  :global(.job-card) {
    height: 100%;
  }

  .job-card__layout {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
  }

  .job-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .job-card__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .job-card__more {
    align-self: flex-start;
    margin-top: auto;
  }

  .job-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .job-card__detail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .job-card__title {
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  /* Höchstens zwei Zeilen – alle Details stehen auf der Stellenseite */
  .job-card__summary {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .job-card__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .job-card__more :global(.icon) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  :global(.job-card:hover) .job-card__more :global(.icon) {
    transform: translateX(3px);
  }
</style>
