---
/**
 * Logo – drei Varianten aus den Vektordateien in src/assets/brand/:
 *  · variant="badge": Maskottchen mit gelbem Namens-Label dahinter, im weißen Pill-Rahmen – im Header
 *  · variant="wordmark": gelbes Schriftband mit Maskottchen (hildebrand-logo.svg) – derzeit ungenutzt
 *  · Standard: Maskottchen mit Stein-„H“ (hildebrand-maskottchen.svg) plus Schriftzug – an allen anderen Stellen
 */
import { Image } from 'astro:assets';
import wordmark from '@/assets/brand/hildebrand-logo.svg';
import mascot from '@/assets/brand/hildebrand-maskottchen.svg';

interface Props {
  variant?: 'badge' | 'wordmark' | 'mark';
  /** Nur Maskottchen ohne Schriftzug */
  markOnly?: boolean;
  size?: 'sm' | 'md' | 'lg';
  /** Bild priorisiert laden (z. B. im Header) */
  eager?: boolean;
  class?: string;
}

const { variant = 'mark', markOnly = false, size = 'md', eager = false, class: className } = Astro.props;
---

{
  variant === 'badge' ? (
    <span class:list={['logo', 'logo--badge', `logo--${size}`, className]}>
      <Image
        src={mascot}
        alt=""
        class="logo__badge-mark"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      <span class="logo__badge-label" aria-hidden="true">Hildebrand</span>
      <span class="visually-hidden">Pflasterarbeiten Hildebrand GmbH</span>
    </span>
  ) : variant === 'wordmark' ? (
    <span class:list={['logo', 'logo--wordmark', `logo--${size}`, className]}>
      <Image
        src={wordmark}
        alt="Hildebrand Pflasterarbeiten GmbH"
        class="logo__wordmark"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </span>
  ) : (
    <span class:list={['logo', `logo--${size}`, className]}>
      <Image
        src={mascot}
        alt={markOnly ? 'Pflasterarbeiten Hildebrand GmbH' : ''}
        class="logo__mark"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      {!markOnly && (
        <span class="logo__text">
          <span class="logo__name">Hildebrand</span>
          <span class="logo__sub">Pflasterarbeiten GmbH</span>
        </span>
      )}
    </span>
  )
}

<style>
  .logo {
    --logo-height: 3.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-heading);
    line-height: 1;
  }

  .logo--sm {
    --logo-height: 2.6rem;
  }

  .logo--lg {
    --logo-height: 3.9rem;
  }

  .logo :global(.logo__mark),
  .logo :global(.logo__wordmark) {
    display: block;
    width: auto;
    height: var(--logo-height);
    transition: height var(--duration-slow) var(--ease-out);
  }

  /* Header-Logo: Maskottchen vorne, gelbes Pill-Label mit „HILDEBRAND“ dahinter (ab der Figurmitte nach
     rechts), alles in einem weißen, abgerundeten Rahmen */
  .logo--badge {
    --badge-pad: 3px;
    --mark-h: calc(var(--logo-height) - var(--badge-pad) * 2 - 4px);
    --mark-w: calc(var(--mark-h) * 0.77);
    gap: 0;
    height: var(--logo-height);
    padding: var(--badge-pad) var(--badge-pad) var(--badge-pad) calc(var(--badge-pad) + 0.35rem);
    border: 2px solid #ffffff;
    border-radius: var(--radius-full);
  }

  .logo--badge :global(.logo__badge-mark) {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--mark-w);
    height: var(--mark-h);
    filter: drop-shadow(1px 0 0 rgb(0 0 0 / 0.25));
  }

  .logo__badge-label {
    display: inline-flex;
    align-items: center;
    height: calc(var(--mark-h) * 0.72);
    margin-left: calc(var(--mark-w) * -0.5);
    padding: 0 1rem 0 calc(var(--mark-w) * 0.5 + 0.55rem);
    font-size: calc(var(--mark-h) * 0.4);
    font-weight: var(--weight-extrabold, 800);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    color: #ffffff;
    -webkit-text-stroke: 1.5px #0b0b0c;
    paint-order: stroke fill;
    text-shadow: 0 1px 0 #0b0b0c;
    border-radius: var(--radius-full);
    background: var(--color-cta);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-left: 0.75rem;
    border-left: 1px solid color-mix(in srgb, currentColor 28%, transparent);
  }

  .logo__name {
    font-size: 1.3rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  .logo__sub {
    font-size: 0.66rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    line-height: 1;
  }

  .logo--lg .logo__name {
    font-size: 1.55rem;
  }

  .logo--lg .logo__sub {
    font-size: 0.72rem;
  }

  .logo--sm .logo__name {
    font-size: 1.1rem;
  }

  .logo--sm .logo__sub {
    font-size: 0.58rem;
  }
</style>
