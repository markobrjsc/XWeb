---
/**
 * MediaPlaceholder – neutraler Platzhalter, solange noch kein Foto vorliegt:
 * helle Fläche mit feinem Raster, dezentem Pflastermuster und einem thematischen Icon.
 */
import Icon from './Icon.astro';
import PavingPattern from './PavingPattern.astro';
import TechGrid from './TechGrid.astro';

interface Props {
  icon?: string;
  /** Wird als Bildbeschreibung vorgelesen. */
  label?: string;
  class?: string;
}

const { icon = 'image', label, class: className } = Astro.props;
---

<div class:list={['placeholder', className]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <TechGrid tone="dark" class="placeholder__grid" />
  <PavingPattern tone="dark" size={10} class="placeholder__paving" />
  <span class="placeholder__icon" aria-hidden="true">
    <Icon name={icon} size="1em" strokeWidth={1.5} />
  </span>
</div>

<style>
  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(160deg, var(--blue-50) 0%, var(--gray-100) 100%);
  }

  .placeholder :global(.placeholder__grid),
  .placeholder :global(.placeholder__paving) {
    position: absolute;
    inset: 0;
  }

  .placeholder :global(.placeholder__paving) {
    mask-image: linear-gradient(to top, #000 0%, transparent 60%);
  }

  .placeholder__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 4rem;
    aspect-ratio: 1;
    font-size: 1.75rem;
    border-radius: var(--radius-md);
    color: var(--blue-600);
    background: #ffffff;
    box-shadow:
      inset 0 0 0 1px var(--blue-100),
      var(--shadow-sm);
  }
</style>
