---
/**
 * PavingPattern – dekoratives Fischgrät-Pflastermuster („Fischgrätverband“) als SVG-Hintergrund.
 * Das Muster wird rechnerisch aus dem Gitter des Verbands erzeugt und ist nahtlos kachelbar.
 *
 * <PavingPattern tone="light" />  helle Fugen – für dunkle Flächen
 * <PavingPattern tone="dark" />   dunkle Fugen – für helle Flächen
 */
interface Props {
  tone?: 'light' | 'dark';
  /** Breite eines Steins in px (Länge = doppelte Breite) */
  size?: number;
  angle?: number;
  class?: string;
}

const { tone = 'light', size = 14, angle = 45, class: className } = Astro.props;

// Fischgrätverband aus Steinen im Format 2:1. Gitter-Vektoren (1,1) und (2,-2),
// daraus ergibt sich eine quadratische Kachel von 4 × 4 Einheiten.
const u = size;
const tileUnits = 4;
const gap = Math.max(1.25, u * 0.13);
const radius = u * 0.12;

interface Brick {
  x: number;
  y: number;
  w: number;
  h: number;
}

const bricks: Brick[] = [];
for (let n = -8; n <= 8; n++) {
  for (let m = -4; m <= 4; m++) {
    const x = n + 2 * m;
    const y = n - 2 * m;
    bricks.push({ x, y, w: 2, h: 1 }); // liegender Stein
    bricks.push({ x: x + 2, y: y - 1, w: 1, h: 2 }); // stehender Stein
  }
}

const visible = bricks.filter(
  (b) => b.x < tileUnits && b.x + b.w > 0 && b.y < tileUnits && b.y + b.h > 0,
);

const patternId = `paving-${crypto.randomUUID().slice(0, 8)}`;
---

<svg class:list={['paving', `paving--${tone}`, className]} aria-hidden="true" focusable="false">
  <defs>
    <pattern
      id={patternId}
      width={tileUnits * u}
      height={tileUnits * u}
      patternUnits="userSpaceOnUse"
      patternTransform={`rotate(${angle})`}
    >
      {
        visible.map((b) => (
          <rect
            x={b.x * u + gap / 2}
            y={b.y * u + gap / 2}
            width={b.w * u - gap}
            height={b.h * u - gap}
            rx={radius}
          />
        ))
      }
    </pattern>
  </defs>
  <rect class="paving__fill" width="100%" height="100%" fill={`url(#${patternId})`} />
</svg>

<style>
  .paving {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .paving rect:not(.paving__fill) {
    fill: none;
    stroke-width: 1;
  }

  .paving--light rect:not(.paving__fill) {
    stroke: rgb(255 255 255 / 0.07);
  }

  .paving--dark rect:not(.paving__fill) {
    stroke: rgb(var(--ink) / 0.09);
  }

</style>
