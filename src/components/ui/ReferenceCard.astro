---
/**
 * ReferenceCard – ein Projekt aus src/content/referenzen mit Bildergalerie (Carousel).
 * Fotos: alle Bilder im Ordner src/assets/images/referenzen/<dateiname>/ (oder Feld "gallery").
 */
import type { CollectionEntry } from 'astro:content';
import { getPillar } from '@/data/services';
import { findImages } from '@/lib/images';
import Badge from './Badge.astro';
import Card from './Card.astro';
import Carousel from './Carousel.astro';
import Icon from './Icon.astro';
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Props {
  entry: CollectionEntry<'referenzen'>;
  headingLevel?: 'h2' | 'h3';
  /** Erstes Foto sofort laden (für Karten im sichtbaren Bereich) */
  eager?: boolean;
  class?: string;
}

const { entry, headingLevel: Heading = 'h3', eager = false, class: className } = Astro.props;
const { title, category, location, year, summary, services, icon, gallery, placeholder } = entry.data;
const pillar = getPillar(category);
const photos = findImages(gallery ?? `referenzen/${entry.id}`);
---

<Card reveal="up" class:list={['ref-card', className]} data-category={category} id={`ref-${entry.id}`}>
  <div slot="media">
    {photos.length > 0 ? <Carousel images={photos} label={title} eager={eager} /> : <MediaPlaceholder icon={icon} />}
  </div>
  <div class="ref-card__meta">
    <Badge tone="soft" icon={pillar.icon} size="sm">{pillar.title}</Badge>
    {placeholder && <Badge tone="outline" size="sm">Beispiel</Badge>}
    {photos.length > 1 && <span class="ref-card__count"><Icon name="images" size="1em" />{photos.length} Fotos</span>}
  </div>
  <Heading class="ref-card__title">{title}</Heading>
  {
    (location || year) && (
      <p class="ref-card__location">
        <Icon name="map-pin" size="1em" />
        {[location, year].filter(Boolean).join(' · ')}
      </p>
    )
  }
  <p class="ref-card__summary">{summary}</p>
  {
    services.length > 0 && (
      <ul slot="footer" class="ref-card__tags" role="list" aria-label="Ausgeführte Arbeiten">
        {services.map((service) => (
          <li>{service}</li>
        ))}
      </ul>
    )
  }
</Card>

<style>
  .ref-card {
    /* zusätzlich zum scroll-padding des Headers: Platz für die klebende Filterleiste */
    scroll-margin-top: 5.5rem;
  }

  .ref-card:target {
    box-shadow:
      0 0 0 3px var(--blue-500),
      var(--shadow-lg);
  }

  .ref-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .ref-card__count {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-left: auto;
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-subtle);
  }

  .ref-card__title {
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .ref-card__location {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-subtle);
  }

  .ref-card__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .ref-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .ref-card__tags li {
    padding: 0.25em 0.8em;
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    color: var(--gray-700);
    background: var(--gray-100);
    border-radius: var(--radius-full);
  }
</style>
