---
/**
 * ServiceCard – eine einzelne Leistung mit Icon, Beschreibung, Stichpunkten und den zugehörigen
 * Referenzprojekten (Feld `references` in src/data/services.ts).
 *
 * Jedes Projekt erscheint als Bildergalerie im Instagram-Stil (Carousel). Passen mehrere Projekte zur
 * Leistung, blättert man per „‹ vorheriges · aktuelles Projekt · nächstes ›“ – die Zeile passt immer in
 * die Karte (lange Namen werden gekürzt), beim Überfahren der Pfeile zeigt ein Tipp das Ziel-Projekt.
 */
import { getCollection, getEntries } from 'astro:content';
import type { PillarId, Service } from '@/data/services';
import Card from './Card.astro';
import Carousel from './Carousel.astro';
import CheckList from './CheckList.astro';
import Icon from './Icon.astro';
import IconBadge from './IconBadge.astro';

interface Props {
  service: Service;
  pillar: PillarId;
  headingLevel?: 'h3' | 'h4';
  reveal?: boolean | 'up' | 'left' | 'right' | 'zoom' | 'fade';
  class?: string;
}

const { service, pillar, headingLevel: Heading = 'h4', reveal = true, class: className } = Astro.props;
const listed = service.references?.length
  ? (await getEntries(service.references.map((id) => ({ collection: 'referenzen' as const, id })))).filter(Boolean)
  : [];
// Im Bearbeiten-Modus angelegte Projekte nennen ihre Leistungskarte selbst (Feld `leistungen`)
const added = (await getCollection('referenzen'))
  .filter((entry) => entry.data.leistungen.includes(service.id) && !listed.some((item) => item.id === entry.id))
  .sort((a, b) => a.data.order - b.data.order);
const projects = [...listed, ...added];
const key = (projectId: string) => `projekt-${service.id}-${projectId}`;
---

<Card
  as="article"
  variant="dark"
  reveal={reveal}
  id={`leistung-${service.id}`}
  class:list={['service', className]}
  data-service={service.id}
  data-pillar={pillar}
  data-service-title={service.title}
>
  <div class="service__head">
    <IconBadge name={service.icon} tone="soft" class="service__icon" />
    <Heading class="service__title"><span class="service__title-text">{service.title}</span></Heading>
  </div>
  <p class="service__text">{service.description}</p>
  <CheckList items={service.points} size="sm" class="service__points" />

  {
    projects.length > 0 && (
      <div slot="footer" class="service__projects" data-projects>
        <p class="service__projects-label">
          <span>{projects.length === 1 ? 'Referenzprojekt' : `${projects.length} Referenzprojekte`}</span>
          {projects.length > 1 && (
            <span class="service__current-count" data-project-count>
              1 / {projects.length}
            </span>
          )}
        </p>

        {projects.length > 1 && (
          <div class="service__switch">
            <button
              class="service__nav"
              type="button"
              data-project-step="-1"
              aria-label={`Vorheriges Projekt: ${projects.at(-1)?.data.title}`}
              data-tip={`Vorheriges: ${projects.at(-1)?.data.title}`}
            >
              <Icon name="chevron-left" size="1.4rem" />
            </button>
            <p class="service__current" aria-live="polite">
              <span class="service__current-title" data-project-current title={projects[0].data.title}>
                {projects[0].data.title}
              </span>
            </p>
            <button
              class="service__nav"
              type="button"
              data-project-step="1"
              aria-label={`Nächstes Projekt: ${projects[1].data.title}`}
              data-tip={`Nächstes: ${projects[1].data.title}`}
            >
              <Icon name="chevron-right" size="1.4rem" />
            </button>
          </div>
        )}

        {projects.map((project, index) => (
          <div
            class="service__project"
            id={key(project.id)}
            hidden={index > 0}
            data-project-panel
            data-title={project.data.title}
          >
            <Carousel
              folder={project.data.gallery ?? `referenzen/${project.id}`}
              label={project.data.title}
              aspect="3 / 2"
              sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw"
              class="service__gallery"
            />
            <div class="service__project-text">
              <p class="service__project-title">{project.data.title}</p>
              {(project.data.location || project.data.year) && (
                <p class="service__project-meta">{[project.data.location, project.data.year].filter(Boolean).join(' · ')}</p>
              )}
              <p class="service__project-summary">{project.data.summary}</p>
            </div>
          </div>
        ))}
      </div>
    )
  }
</Card>

<script>
  // Projekt-Auswahl je Leistungskarte: Pfeile blättern im Kreis durch die Projekte
  document.querySelectorAll<HTMLElement>('[data-projects]').forEach((root) => {
    const panels = [...root.querySelectorAll<HTMLElement>('[data-project-panel]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-project-step]')];
    const current = root.querySelector<HTMLElement>('[data-project-current]');
    const count = root.querySelector<HTMLElement>('[data-project-count]');
    if (panels.length < 2) return;
    let index = 0;

    const titleAt = (i: number) => panels[(i + panels.length) % panels.length].dataset.title ?? '';

    const show = (next: number) => {
      index = (next + panels.length) % panels.length;
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
        if (i === index) {
          panel.classList.remove('is-entering');
          void panel.offsetWidth;
          panel.classList.add('is-entering');
        }
      });
      if (current) {
        current.textContent = titleAt(index);
        current.title = titleAt(index);
      }
      if (count) count.textContent = `${index + 1} / ${panels.length}`;
      buttons.forEach((button) => {
        const step = Number(button.dataset.projectStep);
        const label = step < 0 ? 'Vorheriges' : 'Nächstes';
        button.dataset.tip = `${label}: ${titleAt(index + step)}`;
        button.setAttribute('aria-label', `${label} Projekt: ${titleAt(index + step)}`);
      });
    };

    buttons.forEach((button) => button.addEventListener('click', () => show(index + Number(button.dataset.projectStep))));
  });
</script>

<style>
  .service__head {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .service__title {
    min-width: 0;
    width: 100%;
    font-size: var(--text-xl);
    line-height: 1.2;
    hyphens: manual;
    text-align: center;
  }

  /* Beim Überfahren der Karte: Titel wie mit Textmarker markiert (Form wie bei .marker) */
  .service__title-text {
    position: relative;
    z-index: 0;
  }

  .service__title-text::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0.04em -0.2em -0.04em -0.24em;
    background: var(--color-highlight-mark);
    -webkit-mask: var(--mark-shape-2) center / 100% 100% no-repeat;
    mask: var(--mark-shape-2) center / 100% 100% no-repeat;
    opacity: 0;
    scale: 0.6 1;
    transform-origin: left center;
    transition:
      opacity var(--duration-base) ease,
      scale var(--duration-slow) var(--ease-out);
  }

  :global(.service:hover) .service__title-text::before {
    opacity: 1;
    scale: 1 1;
  }

  .service__text {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .service :global(.service__points) {
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  /* Referenzprojekte */
  .service__projects {
    container-type: inline-size;
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .service__projects-label {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  /* ‹ vorheriges · aktuelles Projekt · nächstes › – passt immer in die Karte */
  .service__switch {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'prev current next';
    align-items: center;
    gap: var(--space-2);
  }

  .service__switch > [data-project-step='-1'] {
    grid-area: prev;
  }

  .service__switch > [data-project-step='1'] {
    grid-area: next;
  }

  .service__switch > .service__current {
    grid-area: current;
  }

  .service__nav {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--color-heading);
    border: 1.5px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-surface);
    cursor: pointer;
    transition:
      border-color var(--duration-base) ease,
      background-color var(--duration-base) ease;
  }

  .service__nav:hover {
    border-color: var(--color-cta);
  }

  .service__nav:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Kleiner Tipp beim Überfahren */
  .service__nav::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 0.45rem);
    z-index: 5;
    width: max-content;
    max-width: 14rem;
    padding: 0.3rem 0.6rem;
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    line-height: 1.3;
    white-space: normal;
    color: #ffffff;
    border-radius: var(--radius-sm);
    background: var(--onyx-950);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.14),
      var(--shadow-md);
    opacity: 0;
    pointer-events: none;
    translate: 0 0.2rem;
    transition:
      opacity var(--duration-base) ease,
      translate var(--duration-base) var(--ease-out);
  }

  .service__nav[data-project-step='-1']::after {
    left: 0;
  }

  .service__nav[data-project-step='1']::after {
    right: 0;
  }

  .service__nav:hover::after,
  .service__nav:focus-visible::after {
    opacity: 1;
    translate: 0 0;
  }

  /* Der Projekttitel darf umbrechen, während beide Pfeile auf derselben Höhe bleiben. */
  .service__current {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 0;
    min-height: 2.75rem;
    height: auto;
    padding: 0.3rem 0.45rem;
    font-size: 0.875rem;
    line-height: 1.25;
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-surface);
  }

  .service__current-title {
    display: block;
    min-width: 0;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .service__current-count {
    flex: none;
    letter-spacing: 0.04em;
    color: var(--color-heading);
  }

  .service__project {
    display: grid;
    gap: var(--space-3);
  }

  .service__project[hidden] {
    display: none;
  }

  .service__project.is-entering {
    animation: project-in 380ms var(--ease-out) both;
  }

  @keyframes project-in {
    from {
      opacity: 0;
      translate: 0 0.4rem;
    }
  }

  .service__project :global(.service__gallery) {
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .service__project-text {
    display: grid;
    gap: 0.2rem;
  }

  .service__project-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-heading);
  }

  .service__project-meta {
    font-size: var(--text-2xs);
    color: var(--color-text-subtle);
  }

  .service__project-summary {
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }
</style>
