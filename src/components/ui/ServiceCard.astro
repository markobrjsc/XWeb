---
/**
 * ServiceCard – eine einzelne Leistung mit Icon, Beschreibung, Stichpunkten und den zugehörigen
 * Referenzprojekten (Feld `references` in src/data/services.ts).
 *
 * Jedes Projekt erscheint als Bildergalerie im Instagram-Stil (Carousel). Passen mehrere Projekte zur
 * Leistung, wählt man das Projekt über Chips oberhalb der Galerie – alle Projekte sind so auf einen Blick
 * sichtbar und mit einem Klick erreichbar (besser als ein Dropdown, das die Auswahl versteckt).
 */
import { getEntries } from 'astro:content';
import type { PillarId, Service } from '@/data/services';
import Card from './Card.astro';
import Carousel from './Carousel.astro';
import CheckList from './CheckList.astro';
import IconBadge from './IconBadge.astro';

interface Props {
  service: Service;
  pillar: PillarId;
  headingLevel?: 'h3' | 'h4';
  reveal?: boolean | 'up' | 'left' | 'right' | 'zoom' | 'fade';
  class?: string;
}

const { service, headingLevel: Heading = 'h4', reveal = true, class: className } = Astro.props;
const projects = service.references?.length
  ? (await getEntries(service.references.map((id) => ({ collection: 'referenzen' as const, id })))).filter(Boolean)
  : [];
const key = (projectId: string) => `projekt-${service.id}-${projectId}`;
---

<Card as="article" reveal={reveal} id={`leistung-${service.id}`} class:list={['service', className]}>
  <div class="service__head">
    <IconBadge name={service.icon} tone="soft" class="service__icon" />
    <Heading class="service__title">{service.title}</Heading>
  </div>
  <p class="service__text">{service.description}</p>
  <CheckList items={service.points} size="sm" class="service__points" />

  {
    projects.length > 0 && (
      <div slot="footer" class="service__projects" data-projects>
        <p class="service__projects-label">
          {projects.length === 1 ? 'Referenzprojekt' : `${projects.length} Referenzprojekte`}
        </p>

        {projects.length > 1 && (
          <div class="service__chips" role="tablist" aria-label={`Referenzprojekte zu ${service.title}`}>
            {projects.map((project, index) => (
              <button
                class="service__chip"
                type="button"
                role="tab"
                id={`${key(project.id)}-tab`}
                aria-controls={key(project.id)}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? undefined : -1}
                data-project-tab={key(project.id)}
              >
                {project.data.title}
              </button>
            ))}
          </div>
        )}

        {projects.map((project, index) => (
          <div
            class="service__project"
            id={key(project.id)}
            role={projects.length > 1 ? 'tabpanel' : undefined}
            aria-labelledby={projects.length > 1 ? `${key(project.id)}-tab` : undefined}
            hidden={index > 0}
            data-project-panel
          >
            <Carousel
              folder={project.data.gallery ?? `referenzen/${project.id}`}
              label={project.data.title}
              aspect="3 / 2"
              sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw"
              class="service__gallery"
            />
            <div class="service__project-text">
              <p class="service__project-title">{project.data.title}</p>
              {(project.data.location || project.data.year) && (
                <p class="service__project-meta">{[project.data.location, project.data.year].filter(Boolean).join(' · ')}</p>
              )}
              <p class="service__project-summary">{project.data.summary}</p>
            </div>
          </div>
        ))}
      </div>
    )
  }
</Card>

<script>
  // Projekt-Auswahl je Leistungskarte: Chip anklicken → Galerie des Projekts einblenden
  document.querySelectorAll<HTMLElement>('[data-projects]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-project-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-project-panel]')];
    if (tabs.length < 2) return;

    const select = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.projectTab === id;
        tab.setAttribute('aria-selected', String(active));
        if (active) tab.removeAttribute('tabindex');
        else tab.tabIndex = -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => {
        const active = panel.id === id;
        panel.hidden = !active;
        if (active) {
          panel.classList.remove('is-entering');
          void panel.offsetWidth;
          panel.classList.add('is-entering');
          panel.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-revealed'));
        }
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.projectTab ?? ''));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        select(tabs[(index + step + tabs.length) % tabs.length].dataset.projectTab ?? '', true);
      });
    });
  });
</script>

<style>
  .service__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-1);
  }

  .service__title {
    min-width: 0;
    font-size: var(--text-xl);
    line-height: 1.2;
    hyphens: manual;
  }

  .service__text {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .service :global(.service__points) {
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  /* Referenzprojekte */
  .service__projects {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .service__projects-label {
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .service__chips {
    display: flex;
    gap: var(--space-2);
    margin-inline: calc(var(--space-1) * -1);
    padding: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .service__chip {
    flex: none;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    color: var(--color-text);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    cursor: pointer;
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease,
      color var(--duration-base) ease;
  }

  .service__chip:hover {
    border-color: var(--color-heading);
  }

  .service__chip[aria-selected='true'] {
    color: var(--color-cta-fg);
    border-color: var(--color-cta);
    background: var(--color-cta);
  }

  .service__chip:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .service__project {
    display: grid;
    gap: var(--space-3);
  }

  .service__project[hidden] {
    display: none;
  }

  .service__project.is-entering {
    animation: project-in 380ms var(--ease-out) both;
  }

  @keyframes project-in {
    from {
      opacity: 0;
      translate: 0 0.4rem;
    }
  }

  .service__project :global(.service__gallery) {
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .service__project-text {
    display: grid;
    gap: 0.2rem;
  }

  .service__project-title {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--color-heading);
  }

  .service__project-meta {
    font-size: var(--text-2xs);
    color: var(--color-text-subtle);
  }

  .service__project-summary {
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }
</style>
