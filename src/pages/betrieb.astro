---
/**
 * Unser Betrieb – Familienbetrieb, Werte, Kunden, Ausbildung.
 * Foto des Teams/Betriebs: src/assets/images/betrieb.jpg (wird automatisch eingebunden).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CareerTeaser from '@/components/sections/CareerTeaser.astro';
import PageHero from '@/components/sections/PageHero.astro';
import StatsBand from '@/components/sections/StatsBand.astro';
import ValuesSection from '@/components/sections/ValuesSection.astro';
import CheckList from '@/components/ui/CheckList.astro';
import FactList from '@/components/ui/FactList.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Media from '@/components/ui/Media.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { site } from '@/config/site';
import { clientGroups } from '@/data/company';

const breadcrumbs = [
  { label: 'Start', href: '/' },
  { label: 'Unser Betrieb', href: '/betrieb/' },
];

const facts = [
  { label: 'Unternehmen', value: site.name, icon: 'building-2' },
  { label: 'Familienbetrieb', value: `seit ${site.foundingYear}`, icon: 'calendar' },
  { label: 'Geschäftsführung', value: site.managingDirector, icon: 'user-round' },
  { label: 'Firmensitz', value: `${site.address.city.replace(' am Bodensee', '')}-${site.address.district}`, icon: 'map-pin' },
  { label: 'Einsatzgebiet', value: 'Landkreis Konstanz', icon: 'route' },
  { label: 'Fachbereiche', value: 'Garten-, Tief- und Straßenbau', icon: 'layers' },
];
---

<BaseLayout
  title="Unser Betrieb"
  description={`Pflasterarbeiten Hildebrand GmbH: Familienbetrieb aus Radolfzell-Liggeringen für Garten-, Tief- und Straßenbau – seit ${site.foundingYear} im Landkreis Konstanz tätig.`}
  pageType="AboutPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Unser Betrieb"
    title={'Ein Familienbetrieb mit <span class="accent">festem Fundament.</span>'}
    lead={`Seit ${site.foundingYear} bauen wir im Landkreis Konstanz – mit eigenem Team, moderner Ausstattung und dem Anspruch, jedes Projekt so sorgfältig auszuführen, als wäre es unser eigenes.`}
  >
    <FactList slot="aside" title="Auf einen Blick" facts={facts} />
  </PageHero>

  <Section labelledby="ueber-uns-titel">
    <div class="about">
      <div class="about__text" data-reveal>
        <SectionHeader
          id="ueber-uns-titel"
          eyebrow="Über uns"
          title={'Qualität, die man sieht – <span class="accent">und die hält.</span>'}
          reveal={false}
        />
        <div class="about__prose">
          <p>
            Die {site.name} ist ein inhabergeführter Familienbetrieb mit Sitz in Radolfzell-Liggeringen. Unter der Leitung
            von {site.managingDirector} planen und bauen wir Höfe, Gärten, Leitungen und Verkehrsflächen im gesamten
            Landkreis Konstanz – in Radolfzell, Singen, Konstanz und den umliegenden Gemeinden.
          </p>
          <p>
            Unser Name steht für saubere Pflasterarbeiten – und für weit mehr: Als Fachbetrieb für Garten-, Tief- und
            Straßenbau übernehmen wir Projekte vom Bauaushub über Kanal- und Leitungsarbeiten bis zur fertigen Pflaster-
            oder Asphaltfläche und der abschließenden Bepflanzung.
          </p>
          <p>
            Wir arbeiten eng mit unseren Kundinnen und Kunden und auf Wunsch mit Landschaftsarchitekten und Planern
            zusammen. So fließen Ihre Vorstellungen von Anfang an in die Planung ein – und Sie haben während der gesamten
            Bauzeit einen festen Ansprechpartner.
          </p>
        </div>
        <CheckList
          columns={2}
          items={['Kompetente Fachkräfte', 'Faire, transparente Preise', 'Professioneller Service', 'Ehrlichkeit und Verlässlichkeit']}
        />
      </div>

      <figure class="about__media" data-reveal="fade">
        <Media name="betrieb" alt="Das Team der Pflasterarbeiten Hildebrand GmbH" aspect="4 / 3" placeholderIcon="users" />
        <figcaption class="about__caption">Familienbetrieb aus Radolfzell-Liggeringen</figcaption>
      </figure>
    </div>
  </Section>

  <StatsBand />

  <Section labelledby="kunden-titel">
    <SectionHeader
      id="kunden-titel"
      eyebrow="Unsere Auftraggeber"
      title={'Für wen wir <span class="accent">arbeiten.</span>'}
      lead="Vom Einfamilienhaus bis zur Gemeindestraße: Wir bringen für jede Aufgabe die passende Erfahrung mit."
    />
    <ul class="clients" role="list" data-reveal-group="90">
      {
        clientGroups.map((group) => (
          <li class="clients__item">
            <FeatureCard icon={group.icon} title={group.title} text={group.text} />
          </li>
        ))
      }
    </ul>
  </Section>

  <ValuesSection tone="subtle" showLink={false} />

  <CareerTeaser />
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .about {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(3rem, 1rem + 5vw, 6rem);
    }
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about__text :global(.section-header) {
    margin-bottom: 0;
  }

  .about__prose {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .about__media {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .about__caption {
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    border-top: 1px solid var(--color-border);
    background: #ffffff;
  }

  .clients {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .clients {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .clients {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .clients__item {
    display: flex;
  }

  .clients__item > :global(*) {
    flex: 1;
  }

</style>
