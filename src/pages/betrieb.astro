---
/**
 * Unser Betrieb – Familienbetrieb, Team, Firmengeschichte, Auftraggeber und Werte.
 * Fotos: src/assets/images/betrieb/team/ (Team bei der Arbeit) und betrieb/historie/ (Firmengeschichte).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import StatsBand from '@/components/sections/StatsBand.astro';
import ValuesSection from '@/components/sections/ValuesSection.astro';
import CheckList from '@/components/ui/CheckList.astro';
import FactList from '@/components/ui/FactList.astro';
import FeatureCard from '@/components/ui/FeatureCard.astro';
import Carousel from '@/components/ui/Carousel.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { site } from '@/config/site';
import { clientGroups } from '@/data/company';
import { findImages } from '@/lib/images';

const teamPhotos = findImages('betrieb/team');
const historyPhotos = findImages('betrieb/historie');

const breadcrumbs = [
  { label: 'Start', href: '/' },
  { label: 'Unser Betrieb', href: '/betrieb/' },
];

const facts = [
  { label: 'Unternehmen', value: site.name, icon: 'building-2' },
  { label: 'Familienbetrieb', value: `seit ${site.foundingYear}`, icon: 'calendar' },
  { label: 'Geschäftsführung', value: site.managingDirector, icon: 'user-round' },
  { label: 'Firmensitz', value: `${site.address.city.replace(' am Bodensee', '')}-${site.address.district}`, icon: 'map-pin' },
  { label: 'Einsatzgebiet', value: 'Landkreis Konstanz', icon: 'route' },
  { label: 'Fachbereiche', value: 'Garten-, Tief- und Straßenbau', icon: 'layers' },
];
---

<BaseLayout
  title="Unser Betrieb"
  description={`Pflasterarbeiten Hildebrand GmbH: Familienbetrieb aus Radolfzell-Liggeringen für Garten-, Tief- und Straßenbau – seit ${site.foundingYear} im Landkreis Konstanz tätig.`}
  pageType="AboutPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    size="compact"
    breadcrumbs={breadcrumbs}
    eyebrow="Unser Betrieb"
    title={'Ein Familienbetrieb mit <span class="accent">festem Fundament.</span>'}
    image="betrieb/team/01"
  />

  <Section labelledby="ueberblick-titel">
    <div class="rows">
      <div class="split">
        <div class="split__text" data-reveal>
          <SectionHeader
            id="ueberblick-titel"
            eyebrow="Auf einen Blick"
            title={`Seit ${site.foundingYear} im <span class="accent">Landkreis Konstanz.</span>`}
            reveal={false}
          />
          <div class="split__prose">
            <p>
              Seit {site.foundingYear} bauen wir im Landkreis Konstanz – mit eigenem Team, moderner Ausstattung und dem
              Anspruch, jedes Projekt so sorgfältig auszuführen, als wäre es unser eigenes.
            </p>
          </div>
        </div>
        <div class="split__aside" data-reveal="fade">
          <FactList facts={facts} class="split__facts" />
        </div>
      </div>

      <div class="split split--reverse">
        <div class="split__text" data-reveal>
          <SectionHeader
            id="ueber-uns-titel"
            eyebrow="Über uns"
            title={'Qualität, die man sieht – <span class="accent">und die hält.</span>'}
            reveal={false}
          />
          <div class="split__prose">
            <p>
              Die {site.name} ist ein inhabergeführter Familienbetrieb mit Sitz in Radolfzell-Liggeringen. Unter der Leitung
              von {site.managingDirector} planen und bauen wir Höfe, Gärten, Leitungen und Verkehrsflächen im gesamten
              Landkreis Konstanz – in Radolfzell, Singen, Konstanz und den umliegenden Gemeinden.
            </p>
            <p>
              Unser Name steht für saubere Pflasterarbeiten – und für weit mehr: Als Fachbetrieb für Garten-, Tief- und
              Straßenbau übernehmen wir Projekte vom Bauaushub über Kanal- und Leitungsarbeiten bis zur fertigen Pflaster-
              oder Asphaltfläche und der abschließenden Bepflanzung.
            </p>
            <p>
              Wir arbeiten eng mit unseren Kundinnen und Kunden und auf Wunsch mit Landschaftsarchitekten und Planern
              zusammen. So fließen Ihre Vorstellungen von Anfang an in die Planung ein – und Sie haben während der gesamten
              Bauzeit einen festen Ansprechpartner.
            </p>
          </div>
          <CheckList
            columns={2}
            items={['Kompetente Fachkräfte', 'Faire, transparente Preise', 'Professioneller Service', 'Ehrlichkeit und Verlässlichkeit']}
          />
        </div>
        <figure class="split__aside split__media" data-reveal="fade">
          <Carousel images={teamPhotos} label="Unser Team bei der Arbeit" sizes="(min-width: 64rem) 45vw, 100vw" />
          <figcaption class="split__caption">Unser Team bei der Arbeit – vom Pflastern bis zum Steinschnitt</figcaption>
        </figure>
      </div>
    </div>
  </Section>

  <StatsBand />

  <Section tone="subtle" labelledby="kunden-titel">
    <div class="rows">
      <div class="split">
        <div class="split__text" data-reveal>
          <SectionHeader
            id="kunden-titel"
            eyebrow="Unsere Auftraggeber"
            title={'Für wen wir <span class="accent">arbeiten.</span>'}
            lead="Vom Einfamilienhaus bis zur Gemeindestraße: Wir bringen für jede Aufgabe die passende Erfahrung mit."
            reveal={false}
          />
        </div>
        <ul class="split__aside clients" role="list" data-reveal-group="90">
          {
            clientGroups.map((group) => (
              <li class="clients__item">
                <FeatureCard icon={group.icon} title={group.title} text={group.text} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="split split--reverse">
        <div class="split__text" data-reveal>
          <SectionHeader
            id="geschichte-titel"
            eyebrow="Firmengeschichte"
            title={'Gewachsen mit <span class="accent">der Region.</span>'}
            reveal={false}
          />
          <div class="split__prose">
            <p>
              Angefangen hat alles mit Pflasterarbeiten – von Hand verlegt, Stein für Stein. Über die Jahrzehnte sind neue
              Aufgaben, Maschinen und Mitarbeitende dazugekommen: vom ersten eigenen Kleinbagger bis zum heutigen Fuhrpark für
              Garten-, Tief- und Straßenbau.
            </p>
            <p>
              Geblieben ist der Anspruch, jede Fläche so zu bauen, dass sie Jahrzehnte hält – und das Vertrauen unserer
              Kundinnen und Kunden im Landkreis Konstanz, von denen uns viele seit Langem begleiten.
            </p>
          </div>
        </div>
        <figure class="split__aside split__media" data-reveal="fade">
          <Carousel images={historyPhotos} label="Fotos aus der Firmengeschichte" sizes="(min-width: 64rem) 45vw, 100vw" />
          <figcaption class="split__caption">Aus unserem Fotoarchiv</figcaption>
        </figure>
      </div>
    </div>
  </Section>

  <ValuesSection showLink={false} />
</BaseLayout>

<style>
  /* Abwechselnd: Text auf der einen, Bild oder Karte auf der anderen Seite */
  .rows {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .split {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 1rem + 4vw, 4.5rem);
    }

    /* Bild bzw. Karte links, Text rechts */
    .split--reverse .split__aside {
      order: -1;
    }
  }

  .split__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .split__text :global(.section-header) {
    margin-bottom: 0;
  }

  .split__prose {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .split__aside :global(.split__facts) {
    box-shadow:
      inset 0 0 0 1px var(--color-border),
      var(--shadow-md);
  }

  .split__media {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .split__caption {
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    border-top: 1px solid var(--color-border);
    background: #ffffff;
  }

  .clients {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .clients {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .clients__item {
    display: flex;
  }

  .clients__item > :global(*) {
    flex: 1;
  }
</style>
