---
/**
 * Kontakt – links Telefon, E-Mail, Adresse, Bürozeiten, Route und Einsatzgebiet, rechts das Anfrageformular.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactSection from '@/components/sections/ContactSection.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { site } from '@/config/site';

const breadcrumbs = [
  { label: 'Start', href: '/' },
  { label: 'Kontakt', href: '/kontakt/' },
];
---

<BaseLayout
  title="Kontakt"
  description={`Kontakt zur Pflasterarbeiten Hildebrand GmbH in Radolfzell-Liggeringen: Telefon ${site.contact.phone}, Anfrageformular, E-Mail, Adresse, Bürozeiten und Anfahrt.`}
  pageType="ContactPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    size="compact"
    breadcrumbs={breadcrumbs}
    title={'Wir freuen uns <span class="accent">auf Ihre Anfrage.</span>'}
    lead="Ob Hofeinfahrt, Gartenanlage, Hausanschluss oder Erschließungsstraße – rufen Sie uns an oder schicken Sie uns Ihre Anfrage direkt über das Formular."
    image="betrieb/team/06"
    imagePosition="top"
  />

  <ContactSection />
</BaseLayout>
