---
/**
 * Leistungen – alle Leistungen der drei Fachbereiche mit je einem Referenzprojekt,
 * dazu der Ablauf der Zusammenarbeit.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaStrip from '@/components/sections/CtaStrip.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import ServicesSection from '@/components/sections/ServicesSection.astro';
import Button from '@/components/ui/Button.astro';
import { processSteps } from '@/data/company';

const breadcrumbs = [
  { label: 'Start', href: '/' },
  { label: 'Leistungen', href: '/leistungen/' },
];
---

<BaseLayout
  title="Leistungen"
  description="Leistungen der Pflasterarbeiten Hildebrand GmbH: Pflasterarbeiten, Pflanzungen, Gartengestaltung, Kanal-, Leitungs- und Erdbau, Straßen-, Wege- und Asphaltbau."
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    size="compact"
    breadcrumbs={breadcrumbs}
    eyebrow="Unsere Leistungen"
    eyebrowIcon="hard-hat"
    title={'Vom ersten Spatenstich <span class="accent">bis zur fertigen Fläche.</span>'}
    lead="Gartenbau, Tiefbau und Straßenbau – ausgeführt von unserem eigenen Team und aus einer Hand koordiniert. Wählen Sie unten einen Fachbereich."
    image="referenzen/terrassengarten-trockenmauern/08"
  />

  <ServicesSection showHeader={false} tabs />

  <ProcessSection
    steps={processSteps}
    eyebrow="So arbeiten wir"
    title={'In vier Schritten <span class="accent">zu Ihrem Projekt.</span>'}
    lead="Klare Absprachen, ein fester Ansprechpartner und saubere Ausführung – so läuft die Zusammenarbeit mit uns ab."
  />

  <CtaStrip
    icon="message-square"
    title="Sie planen ein Projekt?"
    text="Rufen Sie uns an oder schreiben Sie uns – wir beraten Sie gerne und erstellen Ihnen ein individuelles Angebot."
  >
    <Button href="/kontakt/" variant="primary" icon="arrow-right">Kontakt aufnehmen</Button>
  </CtaStrip>
</BaseLayout>

