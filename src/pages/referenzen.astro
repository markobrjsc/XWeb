---
/**
 * Referenzen – alle Projekte aus src/content/referenzen, filterbar nach Fachbereich.
 * Neue Referenz: Markdown-Datei in src/content/referenzen anlegen und die Fotos in den Ordner
 * src/assets/images/referenzen/<dateiname>/ legen (01.jpg, 02.jpg … – erscheinen als Galerie).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaStrip from '@/components/sections/CtaStrip.astro';
import PageHero from '@/components/sections/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import ReferenceCard from '@/components/ui/ReferenceCard.astro';
import Section from '@/components/ui/Section.astro';
import { site } from '@/config/site';
import { pillars } from '@/data/services';

const references = (await getCollection('referenzen')).sort((a, b) => a.data.order - b.data.order);

const filters = [
  { id: 'alle', label: 'Alle Projekte', icon: 'layout-grid', count: references.length },
  ...pillars.map((pillar) => ({
    id: pillar.id,
    label: pillar.title,
    icon: pillar.icon,
    count: references.filter((entry) => entry.data.category === pillar.id).length,
  })),
];

const breadcrumbs = [
  { label: 'Start', href: '/' },
  { label: 'Referenzen', href: '/referenzen/' },
];
---

<BaseLayout
  title="Referenzen"
  description="Referenzen der Pflasterarbeiten Hildebrand GmbH mit Fotos: Hofeinfahrten, Natursteinmauern, Gärten, Pflanzungen, Leitungsbau und Asphaltbau."
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    size="compact"
    breadcrumbs={breadcrumbs}
    eyebrow="Referenzen"
    title={'Projekte aus Garten-, Tief- <span class="accent">und Straßenbau.</span>'}
    lead="Ein Auszug aus unserer Arbeit im Landkreis Konstanz – von der Hofeinfahrt bis zur Erschließungsstraße. Aktuelle Einblicke zeigen wir auch auf Instagram."
    image="referenzen/garten-holzdeck-wasserspiel/01"
  >
    <Button href={site.social.instagram} variant="outline-light" size="sm" icon="instagram" iconPosition="start" external>
      Instagram
    </Button>
  </PageHero>

  <Section labelledby="projekte-titel">
    <h2 id="projekte-titel" class="visually-hidden">Projektübersicht</h2>

    <div class="filter" data-filter hidden>
      <p class="visually-hidden" id="filter-label">Nach Fachbereich filtern:</p>
      <div class="filter__buttons" role="group" aria-labelledby="filter-label">
        {
          filters.map((filter, index) => (
            <button class="filter__btn" type="button" data-filter-value={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>
              <Icon name={filter.icon} size="1.05em" />
              {filter.label}
              <span class="filter__count">{filter.count}</span>
            </button>
          ))
        }
      </div>
      <p class="visually-hidden" aria-live="polite" data-filter-status></p>
    </div>

    <ul class="refs" role="list">
      {
        references.map((entry, index) => (
          <li class="refs__item" data-category={entry.data.category}>
            <ReferenceCard entry={entry} headingLevel="h3" eager={index < 3} />
          </li>
        ))
      }
    </ul>
  </Section>

  <CtaStrip
    icon="instagram"
    title="Mehr Einblicke von unseren Baustellen"
    text="Auf Instagram zeigen wir regelmäßig aktuelle Projekte – vom ersten Aushub bis zur fertigen Fläche."
  >
    <Button href={site.social.instagram} variant="primary" icon="arrow-up-right" external>Zu Instagram</Button>
  </CtaStrip>
</BaseLayout>

<script>
  // Filter nach Fachbereich (nur mit JavaScript sichtbar – ohne JS werden einfach alle Projekte gezeigt)
  const filter = document.querySelector<HTMLElement>('[data-filter]');
  const items = [...document.querySelectorAll<HTMLElement>('.refs__item')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (filter && items.length) {
    filter.hidden = false;
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('[data-filter-value]')];

    const apply = (value: string) => {
      let visible = 0;
      items.forEach((item) => {
        const show = value === 'alle' || item.dataset.category === value;
        item.hidden = !show;
        if (show) visible += 1;
      });
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filterValue === value)));
      if (status) status.textContent = `${visible} ${visible === 1 ? 'Projekt' : 'Projekte'} angezeigt`;
    };

    // Leiste klebt unter dem Header: nach dem Umschalten wieder am Anfang der Liste beginnen
    const stickyTop = () => parseFloat(getComputedStyle(filter).top) || 0;
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    filter.before(sentinel);
    const updateStuck = () => filter.classList.toggle('is-stuck', sentinel.getBoundingClientRect().top < stickyTop() - 1);
    window.addEventListener('scroll', updateStuck, { passive: true });
    updateStuck();

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        apply(button.dataset.filterValue ?? 'alle');
        if (filter.classList.contains('is-stuck')) {
          const y = sentinel.getBoundingClientRect().top + window.scrollY - stickyTop();
          window.scrollTo({ top: y, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        }
      });
    });

    // Direkter Link auf einen Fachbereich, z. B. /referenzen/?bereich=tiefbau
    const preset = new URLSearchParams(window.location.search).get('bereich');
    if (preset && buttons.some((button) => button.dataset.filterValue === preset)) apply(preset);
  }
</script>

<style>
  /* Filterleiste – klebt beim Scrollen unter dem Header (wie die Auswahl auf der Leistungsseite) */
  .filter {
    position: sticky;
    top: calc(var(--header-height-compact) + var(--space-2));
    z-index: 5;
    display: flex;
    justify-content: center;
    margin-bottom: var(--stack-space);
  }

  .filter[hidden] {
    display: none;
  }

  .filter__buttons {
    display: flex;
    gap: var(--space-1);
    max-width: 100%;
    padding: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.88);
    box-shadow:
      inset 0 0 0 1px var(--color-border),
      var(--shadow-xs);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: box-shadow var(--duration-base) ease;
  }

  .filter.is-stuck .filter__buttons {
    box-shadow:
      inset 0 0 0 1px var(--color-border),
      var(--shadow-md);
  }

  .filter__btn {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.6rem;
    padding: 0.45rem 1.1rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--gray-700);
    white-space: nowrap;
    background: transparent;
    border: 0;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      background-color var(--duration-base) ease,
      color var(--duration-base) ease;
  }

  .filter__btn:hover {
    color: var(--blue-800);
    background: var(--blue-50);
  }

  .filter__btn[aria-pressed='true'] {
    color: #ffffff;
    background: var(--blue-600);
  }

  .filter__count {
    min-width: 1.4rem;
    padding: 0.05rem 0.4rem;
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    text-align: center;
    border-radius: var(--radius-full);
    background: var(--gray-100);
    color: var(--gray-600);
  }

  .filter__btn[aria-pressed='true'] .filter__count {
    background: var(--blue-800);
    color: #ffffff;
  }

  .refs {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .refs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .refs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .refs__item {
    display: flex;
  }

  .refs__item[hidden] {
    display: none;
  }

  .refs__item > :global(*) {
    flex: 1;
  }
</style>
