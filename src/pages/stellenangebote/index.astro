---
/**
 * Stellenangebote – offene Stellen, Vorteile und Bewerbungsablauf.
 * Stellen werden in src/content/stellenangebote gepflegt (active: false blendet eine Stelle aus).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaStrip from '@/components/sections/CtaStrip.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import Button from '@/components/ui/Button.astro';
import FactList from '@/components/ui/FactList.astro';
import Icon from '@/components/ui/Icon.astro';
import JobCard from '@/components/ui/JobCard.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { site } from '@/config/site';
import { applicationSteps, benefits } from '@/data/company';

const jobs = (await getCollection('stellenangebote'))
  .filter((job) => job.data.active)
  .sort((a, b) => a.data.order - b.data.order);

const breadcrumbs = [
  { label: 'Start', href: '/' },
  { label: 'Stellenangebote', href: '/stellenangebote/' },
];

const highlights = [
  { label: 'Urlaub', value: '30 Tage im Jahr', icon: 'sun' },
  { label: 'Arbeitszeit', value: 'Keine Überstunden', icon: 'clock' },
  { label: 'Extras', value: 'Hansefit & Geschäftswagen', icon: 'dumbbell' },
  { label: 'Arbeitsort', value: 'Landkreis Konstanz', icon: 'map-pin' },
];

---

<BaseLayout
  title="Stellenangebote & Ausbildung"
  description="Jobs in Radolfzell: Straßenbauer, Landschaftsgärtner, Bauhelfer und Ausbildung (m/w/d) im Familienbetrieb – 30 Tage Urlaub, keine Überstunden."
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    size="full"
    scrollTarget="#stellen"
    breadcrumbs={breadcrumbs}
    eyebrow="Karriere"
    title={'Werden Sie Teil <span class="accent">unseres Teams.</span>'}
    lead="Wir suchen Verstärkung für unser Team im Garten-, Tief- und Straßenbau – mit Berufserfahrung, als Quereinsteiger oder als Auszubildende. Bei uns arbeiten Sie in einem Familienbetrieb mit echtem Zusammenhalt."
    image="betrieb/team/10"
    imagePosition="top"
  >
    <Button href="#stellen" variant="light" icon="arrow-down">Alle Stellen ansehen</Button>
    <Button href="/stellenangebote/initiativ/" variant="outline-light">Initiativ bewerben</Button>
    <div slot="aside" class="hero-aside">
      <FactList title="Das erwartet Sie" facts={highlights} />
      {
        jobs.length > 0 && (
          <nav class="jump" aria-label="Direkt zur Stelle">
            <p class="jump__label">Direkt zur Stelle</p>
            <ul class="jump__list" role="list">
              {jobs.map((job) => (
                <li>
                  <a class="jump__link" href={`#stelle-${job.id}`}>
                    <Icon name={job.data.icon} size="1.05rem" />
                    <span>{job.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </PageHero>

  <Section id="stellen" labelledby="stellen-titel">
    <SectionHeader
      id="stellen-titel"
      align="center"
      eyebrow="Offene Stellen"
      title={jobs.length === 0
        ? 'Aktuell sind alle Stellen <span class="accent">besetzt.</span>'
        : `${jobs.length} ${jobs.length === 1 ? 'Stelle ist' : 'Stellen sind'} <span class="accent">aktuell zu besetzen.</span>`}
      lead={jobs.length === 0
        ? 'Initiativbewerbungen sind trotzdem jederzeit willkommen.'
        : 'Klicken Sie auf eine Stelle für alle Details zu Aufgaben, Anforderungen und Bewerbung.'}
    />
    <ul class="jobs" role="list" data-reveal-group="90">
      {
        jobs.map((job) => (
          <li id={`stelle-${job.id}`} class="jobs__item">
            <JobCard job={job} />
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="subtle" labelledby="vorteile-titel">
    <SectionHeader
      id="vorteile-titel"
      align="center"
      eyebrow="Ihre Vorteile"
      title={'Was wir Ihnen <span class="accent">bieten.</span>'}
      lead="Gute Arbeit braucht gute Bedingungen. Darauf können Sie sich bei uns verlassen."
    />
    <ul class="benefits" role="list" data-reveal-group="70">
      {
        benefits.map((benefit) => (
          <li class="benefits__item" title={benefit.text} data-reveal="up">
            <span class="benefits__icon" aria-hidden="true">
              <Icon name={benefit.icon} size="1.05rem" />
            </span>
            {benefit.title}
          </li>
        ))
      }
    </ul>
  </Section>

  <ProcessSection
    id="bewerbung"
    steps={applicationSteps}
    eyebrow="Bewerbung"
    title={'In drei Schritten <span class="accent">zu uns.</span>'}
    lead="Unkompliziert und persönlich – so läuft Ihre Bewerbung bei uns ab."
  />

  <CtaStrip
    icon="mail"
    title="Keine passende Stelle dabei?"
    text="Wir freuen uns auch über Initiativbewerbungen – ob Fachkraft, Quereinsteiger oder Praktikant. Erzählen Sie uns, was Sie mitbringen."
  >
    <Button href="/stellenangebote/initiativ/" variant="primary" icon="arrow-right">Initiativ bewerben</Button>
    <Button href={site.contact.phoneHref} variant="secondary" icon="phone" iconPosition="start">{site.contact.phone}</Button>
  </CtaStrip>
</BaseLayout>

<style>
  /* Sprungmarken im Seitenkopf – gleiche Glas-Pills wie auf der Startseite */
  .hero-aside {
    display: grid;
    gap: var(--space-5);
  }

  .jump {
    display: grid;
    gap: var(--space-3);
  }

  .jump__label {
    font-size: var(--text-2xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--blue-200);
  }

  .jump__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  .jump__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem 0.5rem 0.8rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: #ffffff;
    text-decoration: none;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.3);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition:
      background-color var(--duration-base) ease,
      box-shadow var(--duration-base) ease;
  }

  .jump__link:hover {
    background: rgb(255 255 255 / 0.24);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.55);
  }

  /* Angesprungene Stelle kurz hervorheben */
  .jobs__item:target > :global(.card) {
    border-color: var(--color-accent);
    box-shadow:
      0 0 0 4px rgb(243 165 5 / 0.25),
      var(--shadow-md);
    transition:
      border-color var(--duration-slow) ease,
      box-shadow var(--duration-slow) ease;
  }

  /* Stellen im 2×2-Raster */
  .jobs {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 48rem) {
    .jobs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .jobs__item {
    display: flex;
  }

  .jobs__item > :global(*) {
    flex: 1;
  }

  /* Vorteile: runde Labels, zentriert umbrechend */
  .benefits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    max-width: 60rem;
    margin: 0 auto;
    padding: 0;
  }

  .benefits__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 1.1rem 0.4rem 0.4rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    color: var(--color-heading);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
  }

  .benefits__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    color: var(--color-accent);
    border-radius: 50%;
    background: var(--onyx-950);
  }

  @media (max-width: 40rem) {
    .hero-aside {
      gap: var(--space-3);
    }

    .hero-aside :global(.facts) {
      padding: 0.75rem;
    }

    .hero-aside :global(.facts__title) {
      margin-bottom: var(--space-2);
    }

    .hero-aside :global(.facts__list) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-3);
    }

    .hero-aside :global(.facts__row) {
      display: block;
      min-width: 0;
      padding-block: 0.5rem;
    }

    .hero-aside :global(.facts__label) {
      font-size: var(--text-2xs);
    }

    .hero-aside :global(.facts__value) {
      font-size: var(--text-xs);
      line-height: 1.35;
    }

    .jump {
      display: none;
    }

    .jump__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
    }

    .jump__link {
      width: 100%;
      min-height: 2.5rem;
      padding: 0.4rem 0.55rem;
      font-size: var(--text-xs);
      border-radius: var(--radius-sm);
    }

    .jump__link :global(.icon) {
      flex: none;
    }
  }

  @media (max-width: 40rem) and (max-height: 44rem) {
    .hero-aside {
      display: none;
    }
  }
</style>
