// Cloudflare-Konfiguration: statische Website (Cloudflare Workers mit Static Assets)
// plus ein kleiner Worker für die Formulare unter /api/* (worker/index.ts).
// Deployment: `npm run deploy` · Einrichtung des E-Mail-Versands: README.md → „Formulare & E-Mail-Versand“
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pflasterarbeiten-hildebrand",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    // Nur die Formular-Schnittstelle läuft durch den Worker – alle Seiten kommen direkt aus ./dist
    "run_worker_first": ["/api/*"]
  },
  // Kurzzeit-Speicher für Bewerbungsunterlagen und Fotos (verfallen automatisch nach 6 Stunden).
  // Einmalig anlegen: `npx wrangler kv namespace create UPLOADS` und die ausgegebene id hier eintragen.
  "kv_namespaces": [
    {
      "binding": "UPLOADS",
      "id": "1f16b6ab03bf4a24b77a476eea25d734"
    }
  ],
  "vars": {
    // TESTPHASE: Absender von Resend (funktioniert ohne bestätigte Domain) und Test-Empfänger.
    // Für den Livegang: MAIL_FROM auf "Website Hildebrand <website@pflasterarbeiten-hildebrand.de>" setzen
    // (Domain muss bei Resend bestätigt sein) und die Zeile MAIL_TO löschen – dann geht alles an die
    // E-Mail aus src/config/site.ts.
    "MAIL_FROM": "Website Hildebrand <onboarding@resend.dev>",
    "MAIL_TO": "markobarjasic66@gmail.com",

    // Bearbeiten-Modus (worker/edit.ts): speichert Änderungen als Commit in diesem Repository.
    // Öffnen: auf der Seite „Xaver will was ändern“ tippen → Passwort. Geschützt durch das Passwort im Worker.
    // Zusätzlich nötig: npx wrangler secret put GITHUB_TOKEN · Passwort: npm run edit-password · Abschalten: "EDIT_MODE": "0"
    "GITHUB_REPO": "markobrjsc/XWeb",
    "GITHUB_BRANCH": "main",
    "EDIT_MODE": "1"
  },
  // Live-Domain: Cloudflare legt DNS-Einträge und Zertifikate selbst an.
  // Die Adresse ohne „www“ leitet eine Weiterleitungsregel im Dashboard auf www um.
  "routes": [
    { "pattern": "www.pflasterarbeiten-hildebrand.de", "custom_domain": true },
    { "pattern": "pflasterarbeiten-hildebrand.de", "custom_domain": true }
  ],
  // `wrangler dev` soll lokal bleiben, nicht als Live-Domain auftreten (sonst greift die Herkunftsprüfung)
  "dev": { "host": "localhost" },
  "observability": {
    "enabled": true
  }
}
